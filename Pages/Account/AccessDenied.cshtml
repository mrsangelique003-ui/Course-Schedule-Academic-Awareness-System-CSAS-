@page
@model AccessDeniedModel
@{
    ViewData["Title"] = "Access Denied";
    Layout = null; // standalone page — no sidebar for anonymous users
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Access Denied - CSAS</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
</head>
<body class="bg-light">
    <div class="container d-flex align-items-center justify-content-center min-vh-100">
        <div class="card shadow-sm border-0 text-center p-5" style="max-width:480px;">
            <i class="bi bi-shield-lock-fill text-danger" style="font-size:4rem;"></i>
            <h1 class="h3 mt-3 mb-2">Access Denied</h1>
            <p class="text-muted mb-4">
                You don't have permission to view this page. This area is restricted.
            </p>
            <div class="d-flex gap-2 justify-content-center">
                <a href="/Account/Login" class="btn btn-primary">
                    <i class="bi bi-box-arrow-in-right"></i> Sign in
                </a>
                <a href="/" class="btn btn-outline-secondary">
                    <i class="bi bi-house-door"></i> Home
                </a>
            </div>
        </div>
    </div>
</body>
</html>