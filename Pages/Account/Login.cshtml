@page
@model CourseScheduleSystem.Web.Pages.Account.LoginModel

@{
    Layout = null;
    ViewData["Title"] = "Login | UNILAK Academic Awareness System";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Login | UNILAK</title>

    <meta name="description"
          content="Login to the UNILAK Course Schedule and Academic Awareness System." />

    <meta name="theme-color" content="#0b2545" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap"
          rel="stylesheet" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <link rel="stylesheet"
          href="~/css/Login.css"
          asp-append-version="true" />
</head>

<body>

<div class="login-page">

    <!-- =====================================================
         NAVIGATION  (same as Index, no Login button)
         ===================================================== -->
    <header class="site-header">
        <nav class="navbar" aria-label="Main navigation">

            <a asp-page="/Index"
               class="brand"
               aria-label="UNILAK Academic Awareness System Home">

                <span class="brand-logo">
                    <img src="~/images/PNG_LOGO-_UNILAK-removebg-preview.png"
                         alt="UNILAK Logo" />
                </span>

                <span class="brand-text">
                    <strong>UNILAK</strong>
                    <span>Academic Awareness System</span>
                </span>
            </a>

            <div class="desktop-nav">

                <a asp-page="/Index"
                   class="nav-link">
                    Home
                </a>

                <a asp-page="/Index"
                   asp-fragment="features"
                   class="nav-link">
                    Features
                </a>

                <a asp-page="/Index"
                   asp-fragment="users"
                   class="nav-link">
                    Users
                </a>

                <a asp-page="/Index"
                   asp-fragment="how-it-works"
                   class="nav-link">
                    How It Works
                </a>

            </div>

            <button type="button"
                    class="mobile-menu-toggle"
                    id="mobileMenuToggle"
                    aria-label="Open navigation menu"
                    aria-expanded="false"
                    aria-controls="mobileNavigation">

                <i class="bi bi-list"
                   aria-hidden="true"></i>

            </button>

        </nav>

        <div class="mobile-navigation"
             id="mobileNavigation">

            <a asp-page="/Index"
               class="mobile-nav-link">

                <i class="bi bi-house-door"
                   aria-hidden="true"></i>

                Home
            </a>

            <a asp-page="/Index"
               asp-fragment="features"
               class="mobile-nav-link">

                <i class="bi bi-grid"
                   aria-hidden="true"></i>

                Features
            </a>

            <a asp-page="/Index"
               asp-fragment="users"
               class="mobile-nav-link">

                <i class="bi bi-people"
                   aria-hidden="true"></i>

                Users
            </a>

            <a asp-page="/Index"
               asp-fragment="how-it-works"
               class="mobile-nav-link">

                <i class="bi bi-arrow-repeat"
                   aria-hidden="true"></i>

                How It Works
            </a>

        </div>
    </header>


    <!-- =====================================================
         LOGIN CONTENT  (single centered card)
         ===================================================== -->
    <main class="login-main">

        <div class="login-card">

            <!-- =============================================
                 CENTERED LOGO
                 ============================================= -->
            <div class="login-logo">
                <img src="~/images/PNG_LOGO-_UNILAK-removebg-preview.png"
                     alt="UNILAK Logo" />
            </div>


            <!-- =============================================
                 HEADING
                 ============================================= -->
            <div class="login-header">

                <h1>Login to Account</h1>

                <p>
                    Enter your registration number and password to continue.
                </p>

            </div>


            <!-- =============================================
                 FORM
                 ============================================= -->
            <form method="post"
                  class="login-form"
                  autocomplete="on">

                <div asp-validation-summary="ModelOnly"
                     class="validation-summary">
                </div>


                <!-- REGISTRATION NUMBER -->
                <div class="form-group">

                    <label asp-for="Input.Email"
                           class="form-label">
                        Registration Number
                    </label>

                    <div class="input-wrapper">

                        <input asp-for="Input.Email"
                               class="form-input"
                               placeholder="e.g. 20240012345"
                               autocomplete="username" />

                    </div>

                    <span asp-validation-for="Input.Email"
                          class="field-validation">
                    </span>

                </div>


                <!-- PASSWORD -->
                <div class="form-group">

                    <label asp-for="Input.Password"
                           class="form-label">
                        Password
                    </label>

                    <div class="input-wrapper">

                        <input asp-for="Input.Password"
                               type="password"
                               id="passwordInput"
                               class="form-input"
                               placeholder="••••"
                               autocomplete="current-password" />

                        <button type="button"
                                class="password-toggle"
                                id="passwordToggle"
                                aria-label="Show password">

                            <i class="bi bi-eye"
                               aria-hidden="true"></i>

                        </button>

                    </div>

                    <span asp-validation-for="Input.Password"
                          class="field-validation">
                    </span>

                </div>


                <!-- SUBMIT -->
                <button type="submit"
                        class="submit-button">

                    Login

                </button>

            </form>


            <!-- =============================================
                 FORGOT PASSWORD LINK
                 ============================================= -->
            <div class="login-footer-links">

                <a asp-page="/Account/ForgotPassword"
                   class="forgot-link">
                    Forgot Password?
                </a>

            </div>

        </div>

    </main>


    <!-- =====================================================
         FOOTER
         ===================================================== -->
    <footer class="login-footer">

        <div class="footer-inner">

            <span>
                © @DateTime.Now.Year University of Lay Adventists of Kigali.
                All rights reserved.
            </span>

            <span>
                Course Schedule &amp; Academic Awareness System
            </span>

        </div>

    </footer>

</div>


<script>
    document.addEventListener("DOMContentLoaded", function () {

        /* =============================================
           MOBILE MENU
           ============================================= */
        const menuToggle =
            document.getElementById("mobileMenuToggle");

        const mobileNavigation =
            document.getElementById("mobileNavigation");

        if (menuToggle && mobileNavigation) {

            const menuIcon =
                menuToggle.querySelector("i");

            function openMenu() {
                mobileNavigation.classList.add("open");
                menuToggle.setAttribute("aria-expanded", "true");
                menuIcon.classList.remove("bi-list");
                menuIcon.classList.add("bi-x-lg");
            }

            function closeMenu() {
                mobileNavigation.classList.remove("open");
                menuToggle.setAttribute("aria-expanded", "false");
                menuIcon.classList.remove("bi-x-lg");
                menuIcon.classList.add("bi-list");
            }

            menuToggle.addEventListener("click", function () {
                if (mobileNavigation.classList.contains("open")) {
                    closeMenu();
                } else {
                    openMenu();
                }
            });

            mobileNavigation
                .querySelectorAll("a")
                .forEach(function (link) {
                    link.addEventListener("click", closeMenu);
                });
        }


        /* =============================================
           PASSWORD TOGGLE
           ============================================= */
        const passwordInput =
            document.getElementById("passwordInput");

        const passwordToggle =
            document.getElementById("passwordToggle");

        if (passwordInput && passwordToggle) {

            const toggleIcon =
                passwordToggle.querySelector("i");

            passwordToggle.addEventListener("click", function () {

                const isPassword =
                    passwordInput.type === "password";

                passwordInput.type =
                    isPassword ? "text" : "password";

                toggleIcon.classList.toggle(
                    "bi-eye",
                    !isPassword
                );

                toggleIcon.classList.toggle(
                    "bi-eye-slash",
                    isPassword
                );

                passwordToggle.setAttribute(
                    "aria-label",
                    isPassword ? "Hide password" : "Show password"
                );
            });
        }

    });
</script>

</body>
</html>