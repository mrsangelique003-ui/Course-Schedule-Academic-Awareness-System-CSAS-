@page
@using Course_Schedule_Academic_Awareness_System_CSAAS.Pages
@model LoginModel
@{
    ViewData["Title"] = "Login | CSAAS";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <style>
        .auth-page {
            min-height: 100vh;
            display: flex;
            background: linear-gradient(135deg, rgba(15, 32, 67, 0.88), rgba(27, 85, 155, 0.82)),
                        url('https://site.unilak.ac.rw/wp-content/uploads/2024/02/WhatsApp-Image-2024-02-20-at-9.39.54-PM-1024x818.jpeg') no-repeat center center fixed;
            background-size: cover;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        .auth-panel-brand {
            flex: 1;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 3rem;
            color: #ffffff;
        }

        .auth-brand-content {
            max-width: 520px;
        }

        .auth-brand-badge {
            display: inline-block;
            background-color: rgba(255, 255, 255, 0.2);
            backdrop-filter: blur(5px);
            padding: 0.4rem 1rem;
            border-radius: 20px;
            font-size: 0.85rem;
            font-weight: 600;
            margin-bottom: 1.5rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .auth-panel-form {
            flex: 1;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 2rem;
        }

        .auth-form-card {
            background: rgba(255, 255, 255, 0.96);
            backdrop-filter: blur(10px);
            padding: 2.5rem;
            border-radius: 12px;
            box-shadow: 0 15px 35px rgba(0, 0, 0, 0.35);
            width: 100%;
            max-width: 450px;
        }

        .btn-auth-submit {
            background-color: #0f2043;
            color: #ffffff;
            width: 100%;
            padding: 0.75rem;
            border: none;
            border-radius: 6px;
            font-weight: 600;
            margin-top: 1rem;
            transition: background-color 0.2s ease;
        }

        .btn-auth-submit:hover {
            background-color: #1b559b;
            color: #ffffff;
        }

        @media (max-width: 991px) {
            .auth-page {
                flex-direction: column;
            }
            .auth-panel-brand {
                padding: 2rem 1.5rem 1rem;
            }
        }
    </style>
</head>
<body>

<div class="auth-page">
    <div class="auth-panel-brand">
        <div class="auth-brand-content">
            <span class="auth-brand-badge">UNILAK Academic Portal</span>
            <h2>Welcome back to the Course Schedule &amp; Academic Awareness System</h2>
            <p class="mt-3">
                Sign in to access your timetable, verified WhatsApp groups, and academic
                communications tailored to your role.
            </p>
            <ul class="auth-feature-list list-unstyled mt-4">
                <li class="mb-2"><i class="bi bi-check-circle-fill text-warning me-2"></i> Real-time timetable synchronization</li>
                <li class="mb-2"><i class="bi bi-check-circle-fill text-warning me-2"></i> Role-based dashboard access</li>
                <li class="mb-2"><i class="bi bi-check-circle-fill text-warning me-2"></i> Verified official communication channels</li>
            </ul>
        </div>
    </div>

    <div class="auth-panel-form">
        <div class="auth-form-card">
            <h1 class="h3 mb-2">Sign In</h1>
            <p class="auth-subtitle text-muted mb-3">Enter your credentials to access your account</p>

            <div class="auth-demo-note alert alert-info py-2 px-3 mb-3 fs-7">
                <i class="bi bi-info-circle-fill me-1"></i>
                <span>UI preview only — this form is not yet connected to a backend.</span>
            </div>

            <form method="post">
                <div class="auth-form-group mb-3">
                    <label for="email" class="form-label">Email or Registration Number</label>
                    <input type="text" id="email" asp-for="Email" class="form-control" placeholder="e.g. jane.doe@unilak.ac.rw" required />
                </div>

                <div class="auth-form-group mb-3">
                    <label for="password" class="form-label">Password</label>
                    <input type="password" id="password" asp-for="Password" class="form-control" placeholder="Enter your password" required />
                </div>

                <div class="auth-form-group mb-3">
                    <label for="role" class="form-label">Login As</label>
                    <select id="role" asp-for="Role" class="form-select">
                        <option value="student">Student</option>
                        <option value="cp">Class Representative</option>
                        <option value="hod">HOD / Lecturer</option>
                        <option value="dean">Dean</option>
                        <option value="quality">Quality Director</option>
                    </select>
                </div>

                <div class="auth-options-row d-flex justify-content-between align-items-center mb-3">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="remember" />
                        <label class="form-check-label" for="remember">Remember me</label>
                    </div>
                    <a href="#" class="text-decoration-none">Forgot password?</a>
                </div>

                <button type="submit" class="btn-auth-submit">Sign In</button>
            </form>

            <div class="auth-divider text-center my-3 text-muted">OR</div>

            <p class="auth-switch-text text-center mb-0">
                New to CSAAS? <a href="/Register" class="text-decoration-none fw-bold">Create an account</a>
            </p>
        </div>
    </div>
</div>

<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>