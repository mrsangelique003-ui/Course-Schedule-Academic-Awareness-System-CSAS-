@{
    var role     = ViewData["Role"]     as string ?? "Student";
    var userName = ViewData["UserName"] as string ?? User.Identity?.Name ?? "User";
    var activeNav = ViewData["ActiveNav"] as string ?? "home";

    // Sidebar links per role
    bool isStudent = role == "Student";
    bool isCP      = role == "CP";
    bool isQuality = role == "DirectorOfQuality";
    bool isDean    = role == "Dean" || role == "HOD";

    string dashLink = isStudent ? "/Student/Dashboard"
                    : isCP      ? "/CP/Dashboard"
                    : isQuality ? "/Quality/Dashboard"
                                : "/Dean/Dashboard";

    string roleLabel = isStudent ? "Student"
                     : isCP      ? "Class Representative"
                     : isQuality ? "Director of Quality"
                                 : "Dean / HOD";

    string roleColor = isStudent ? "#1556c8"
                     : isCP      ? "#7c3aed"
                     : isQuality ? "#059669"
                                 : "#b45309";

    string roleIcon  = isStudent ? "bi-mortarboard-fill"
                     : isCP      ? "bi-person-badge-fill"
                     : isQuality ? "bi-patch-check-fill"
                                 : "bi-briefcase-fill";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — CSAS</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
</head>
<body class="dash-body">

<!-- ── SIDEBAR ──────────────────────────────────────────────────── -->
<aside class="dash-sidebar" id="sidebar">

    <!-- Brand -->
    <div class="sidebar-brand">
        <img src="https://site.unilak.ac.rw/wp-content/uploads/2022/02/UNILAK-Logo.png"
             alt="UNILAK" class="sidebar-logo" onerror="this.style.display='none'" />
        <div>
            <div class="sidebar-brand-name">CSAS</div>
            <div class="sidebar-brand-sub">UNILAK · CIT FACULTY</div>
        </div>
    </div>

    <!-- Role badge -->
    <div class="sidebar-role" style="--rc:@roleColor;">
        <i class="bi @roleIcon"></i> @roleLabel
    </div>

    <!-- Nav links -->
    <nav class="sidebar-nav">
        <a href="@dashLink" class="sidebar-link @(activeNav=="home"?"active":"")">
            <i class="bi bi-speedometer2"></i> Dashboard
        </a>

        @if (isStudent || isCP)
        {
            <a href="#" class="sidebar-link @(activeNav=="schedule"?"active":"")">
                <i class="bi bi-calendar-week-fill"></i> My Schedule
            </a>
            <a href="#" class="sidebar-link @(activeNav=="courses"?"active":"")">
                <i class="bi bi-collection-fill"></i> Courses
            </a>
            <a href="#" class="sidebar-link @(activeNav=="deadlines"?"active":"")">
                <i class="bi bi-alarm-fill"></i> Deadlines
            </a>
        }

        @if (isCP)
        {
            <div class="sidebar-section-label">CP Tools</div>
            <a href="#" class="sidebar-link @(activeNav=="flags"?"active":"")">
                <i class="bi bi-flag-fill"></i> Attendance Flags
            </a>
            <a href="#" class="sidebar-link @(activeNav=="swaps"?"active":"")">
                <i class="bi bi-arrow-left-right"></i> Room Swaps
            </a>
            <a href="#" class="sidebar-link @(activeNav=="announce"?"active":"")">
                <i class="bi bi-megaphone-fill"></i> Announcements
            </a>
        }

        @if (isQuality)
        {
            <div class="sidebar-section-label">Quality Tools</div>
            <a href="#" class="sidebar-link"><i class="bi bi-clipboard-data-fill"></i> Compliance</a>
            <a href="#" class="sidebar-link"><i class="bi bi-building"></i> Capacity</a>
            <a href="#" class="sidebar-link"><i class="bi bi-person-lines-fill"></i> Attendance Log</a>
            <a href="#" class="sidebar-link"><i class="bi bi-check2-square"></i> Endorsements</a>
        }

        @if (isDean)
        {
            <div class="sidebar-section-label">Administration</div>
            <a href="#" class="sidebar-link"><i class="bi bi-calendar3"></i> Timetables</a>
            <a href="#" class="sidebar-link"><i class="bi bi-book"></i> Courses</a>
            <a href="#" class="sidebar-link"><i class="bi bi-building"></i> Rooms</a>
            <a href="#" class="sidebar-link"><i class="bi bi-person-workspace"></i> Lecturers</a>
            <a href="#" class="sidebar-link"><i class="bi bi-people"></i> Users</a>
            <a href="#" class="sidebar-link"><i class="bi bi-journal-text"></i> Audit Log</a>
        }

        <div class="sidebar-section-label">Account</div>
        <a href="#" class="sidebar-link @(activeNav=="profile"?"active":"")">
            <i class="bi bi-person-circle"></i> Profile
        </a>
        <a href="#" class="sidebar-link @(activeNav=="notif"?"active":"")">
            <i class="bi bi-bell-fill"></i> Notifications
            <span class="sidebar-badge">5</span>
        </a>
    </nav>

    <!-- Logout -->
    <form method="post" action="/Logout" class="sidebar-logout">
        <button type="submit">
            <i class="bi bi-box-arrow-left"></i> Sign Out
        </button>
    </form>

</aside>

<!-- ── MAIN CONTENT ──────────────────────────────────────────────── -->
<div class="dash-main" id="dashMain">

    <!-- TOPBAR -->
    <header class="dash-topbar">
        <button class="topbar-toggle" id="sidebarToggle" onclick="toggleSidebar()">
            <i class="bi bi-list"></i>
        </button>

        <div class="topbar-search">
            <i class="bi bi-search"></i>
            <input type="text" placeholder="Search courses, rooms, schedules…" />
        </div>

        <div class="topbar-right">
            <button class="topbar-icon-btn" title="Notifications">
                <i class="bi bi-bell-fill"></i>
                <span class="topbar-notif-dot"></span>
            </button>
            <div class="topbar-user">
                <div class="topbar-avatar" style="background:@roleColor;">
                    @(userName.Length > 0 ? userName[0].ToString().ToUpper() : "U")
                </div>
                <div class="topbar-user-info">
                    <span class="topbar-user-name">@userName</span>
                    <span class="topbar-user-role">@roleLabel</span>
                </div>
            </div>
        </div>
    </header>

    <!-- PAGE BODY -->
    <main class="dash-content">
        @RenderBody()
    </main>

    <!-- FOOTER -->
    <footer class="dash-footer">
        <span>© @DateTime.Now.Year CSAS · University of Lay Adventists of Kigali</span>
        <span>CIS Department · CIT Faculty</span>
    </footer>
</div>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script>
    function toggleSidebar() {
        document.getElementById('sidebar').classList.toggle('collapsed');
        document.getElementById('dashMain').classList.toggle('expanded');
    }
    // Mobile: close sidebar on outside click
    document.addEventListener('click', function (e) {
        var sb = document.getElementById('sidebar');
        var toggle = document.getElementById('sidebarToggle');
        if (window.innerWidth < 900 && sb.classList.contains('open')
            && !sb.contains(e.target) && e.target !== toggle) {
            sb.classList.remove('open');
        }
    });
    document.getElementById('sidebarToggle').addEventListener('click', function (e) {
        e.stopPropagation();
        if (window.innerWidth < 900) {
            document.getElementById('sidebar').classList.toggle('open');
        }
    });
</script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
