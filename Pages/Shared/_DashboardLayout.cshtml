@{
    var role     = ViewData["Role"]     as string ?? "Student";
    var userName = ViewData["UserName"] as string ?? User.Identity?.Name ?? "User";
    var activeNav = ViewData["ActiveNav"] as string ?? "home";

    // Sidebar links per role
    bool isStudent = role == "Student";
    bool isCP      = role == "CP";
    bool isQuality = role == "DirectorOfQuality";
    bool isDean    = role == "Dean" || role == "HOD";

    string dashLink = isStudent ? "/Student/Dashboard"
                    : isCP      ? "/CP/Dashboard"
                    : isQuality ? "/Quality/Dashboard"
                                : "/Dean/Dashboard";

    string roleLabel = isStudent ? "Student"
                     : isCP      ? "Class Representative"
                     : isQuality ? "Director of Quality"
                                 : "Dean / HOD";

    string roleColor = isStudent ? "#1556c8"
                     : isCP      ? "#7c3aed"
                     : isQuality ? "#059669"
                                 : "#b45309";

    string roleIcon  = isStudent ? "bi-mortarboard-fill"
                     : isCP      ? "bi-person-badge-fill"
                     : isQuality ? "bi-patch-check-fill"
                                 : "bi-briefcase-fill";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Course Schedules Awareness System</title>

    <!-- ── UNILAK Favicons ── -->
    <link rel="icon" href="https://site.unilak.ac.rw/wp-content/uploads/2021/07/cropped-unnamed-32x32.jpg" sizes="32x32" />
    <link rel="icon" href="https://site.unilak.ac.rw/wp-content/uploads/2021/07/cropped-unnamed-192x192.jpg" sizes="192x192" />
    <link rel="apple-touch-icon" href="https://site.unilak.ac.rw/wp-content/uploads/2021/07/cropped-unnamed-180x180.jpg" />
    <meta name="msapplication-TileImage" content="https://site.unilak.ac.rw/wp-content/uploads/2021/07/cropped-unnamed-270x270.jpg" />

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
</head>
<body class="dash-body">

<!-- ── SIDEBAR ──────────────────────────────────────────────────── -->
<aside class="dash-sidebar" id="sidebar">

    <!-- Brand -->
    <div class="sidebar-brand">
        <img src="~/images/unilak-logo.png"
             alt="UNILAK"
             class="sidebar-logo"
             onerror="this.style.display='none'"
             style="height:40px;width:40px;border-radius:50%;background:#fff;padding:2px;" />
        <div>
            <div class="sidebar-brand-name" title="Course Schedules Awareness System">CSAS</div>
            <div class="sidebar-brand-sub">UNILAK · CIT FACULTY</div>
        </div>
    </div>

    <!-- Role badge -->
    <div class="sidebar-role" style="--rc:@roleColor;">
        <i class="bi @roleIcon"></i> @roleLabel
    </div>

    <!-- Nav links -->
    <nav class="sidebar-nav">

        <!-- ── DASHBOARD (all roles) ─────────────────────── -->
        <a href="@dashLink" class="sidebar-link @(activeNav=="home"?"active":"")">
            <i class="bi bi-speedometer2"></i> Dashboard
        </a>

        @if (isStudent)
        {
            <div class="sidebar-section-label">Student</div>
            <a href="/Student/MySchedule"   class="sidebar-link @(activeNav=="schedule"?"active":"")"><i class="bi bi-calendar-week-fill"></i> My Schedule</a>
            <a href="/Student/Courses"      class="sidebar-link @(activeNav=="courses"?"active":"")"><i class="bi bi-collection-fill"></i> Courses</a>
            <a href="/Student/Deadlines"    class="sidebar-link @(activeNav=="deadlines"?"active":"")"><i class="bi bi-alarm-fill"></i> Deadlines</a>
        }

        @if (isCP)
        {
            <div class="sidebar-section-label">Class Rep</div>
            <a href="/CP/Dashboard?tab=schedule"   class="sidebar-link @(activeNav=="schedule"?"active":"")"><i class="bi bi-calendar-week-fill"></i> My Schedule</a>
            <a href="/CP/Dashboard?tab=flags"      class="sidebar-link @(activeNav=="flags"?"active":"")"><i class="bi bi-flag-fill"></i> Attendance Flags</a>
            <a href="/CP/Dashboard?tab=roomswap"   class="sidebar-link @(activeNav=="swaps"?"active":"")"><i class="bi bi-arrow-left-right"></i> Room Swaps</a>
            <a href="/CP/Dashboard?tab=announce"   class="sidebar-link @(activeNav=="announce"?"active":"")"><i class="bi bi-megaphone-fill"></i> Announcements</a>
            <a href="/CP/Dashboard?tab=allcps"     class="sidebar-link @(activeNav=="allcps"?"active":"")"><i class="bi bi-people-fill"></i> All CIS Reps</a>
            <a href="/CP/Dashboard?tab=chat"       class="sidebar-link @(activeNav=="chat"?"active":"")"><i class="bi bi-chat-dots-fill"></i> Chat with HOD</a>
        }

        @if (isQuality)
        {
            <div class="sidebar-section-label">Quality Tools</div>
            <a href="/Quality/Compliance"    class="sidebar-link @(activeNav=="compliance"?"active":"")"><i class="bi bi-clipboard-data-fill"></i> Compliance</a>
            <a href="/Quality/Capacity"      class="sidebar-link @(activeNav=="capacity"?"active":"")"><i class="bi bi-building"></i> Capacity</a>
            <a href="/Quality/AttendanceLog" class="sidebar-link @(activeNav=="attlog"?"active":"")"><i class="bi bi-person-lines-fill"></i> Attendance Log</a>
            <a href="/Quality/Endorsements"  class="sidebar-link @(activeNav=="endorse"?"active":"")"><i class="bi bi-check2-square"></i> Endorsements</a>
        }

        @if (isDean)
        {
            <div class="sidebar-section-label">Administration</div>
            <a href="/Dean/Dashboard?tab=timetable" class="sidebar-link @(activeNav=="timetables"?"active":"")"><i class="bi bi-calendar3"></i> Timetables</a>
            <a href="/Dean/Dashboard?tab=courses"   class="sidebar-link @(activeNav=="courses"?"active":"")"><i class="bi bi-book"></i> Courses</a>
            <a href="/Dean/Dashboard?tab=rooms"     class="sidebar-link @(activeNav=="rooms"?"active":"")"><i class="bi bi-building"></i> Rooms</a>
            <a href="/Dean/Dashboard?tab=lecturers" class="sidebar-link @(activeNav=="lecturers"?"active":"")"><i class="bi bi-person-workspace"></i> Lecturers</a>
            <a href="/Dean/Dashboard?tab=users"     class="sidebar-link @(activeNav=="users"?"active":"")"><i class="bi bi-people"></i> Users</a>
            <a href="/Dean/AuditLog"                class="sidebar-link @(activeNav=="auditlog"?"active":"")"><i class="bi bi-journal-text"></i> Audit Log</a>
        }

        <div class="sidebar-section-label">Account</div>
        @if (isStudent)
        {
            <a href="/Student/Profile"       class="sidebar-link @(activeNav=="profile"?"active":"")"><i class="bi bi-person-circle"></i> Profile</a>
            <a href="/Student/Notifications" class="sidebar-link @(activeNav=="notif"?"active":"")"><i class="bi bi-bell-fill"></i> Notifications <span class="sidebar-badge">5</span></a>
        }
        @if (isCP)
        {
            <a href="/CP/Profile"       class="sidebar-link @(activeNav=="profile"?"active":"")"><i class="bi bi-person-circle"></i> Profile</a>
            <a href="/CP/Notifications" class="sidebar-link @(activeNav=="notif"?"active":"")"><i class="bi bi-bell-fill"></i> Notifications <span class="sidebar-badge">3</span></a>
        }
        @if (isQuality)
        {
            <a href="/Quality/Profile"       class="sidebar-link @(activeNav=="profile"?"active":"")"><i class="bi bi-person-circle"></i> Profile</a>
            <a href="/Quality/Notifications" class="sidebar-link @(activeNav=="notif"?"active":"")"><i class="bi bi-bell-fill"></i> Notifications <span class="sidebar-badge">2</span></a>
        }
        @if (isDean)
        {
            <a href="/Dean/Profile"       class="sidebar-link @(activeNav=="profile"?"active":"")"><i class="bi bi-person-circle"></i> Profile</a>
            <a href="/Dean/Notifications" class="sidebar-link @(activeNav=="notif"?"active":"")"><i class="bi bi-bell-fill"></i> Notifications <span class="sidebar-badge">4</span></a>
        }

    </nav>

    <!-- Logout -->
    <form method="post" action="/Logout" class="sidebar-logout">
        <button type="submit">
            <i class="bi bi-box-arrow-left"></i> Sign Out
        </button>
    </form>

</aside>

<!-- ── MAIN CONTENT ──────────────────────────────────────────────── -->
<div class="dash-main" id="dashMain">

    <!-- TOPBAR -->
    <header class="dash-topbar">
        <button class="topbar-toggle" id="sidebarToggle" onclick="toggleSidebar()">
            <i class="bi bi-list"></i>
        </button>

        <div class="topbar-search">
            <i class="bi bi-search"></i>
            <input type="text" placeholder="Search courses, rooms, schedules…" />
        </div>

        <div class="topbar-right">
            <button class="topbar-icon-btn" title="Notifications">
                <i class="bi bi-bell-fill"></i>
                <span class="topbar-notif-dot"></span>
            </button>
            <div class="topbar-user">
                <div class="topbar-avatar" style="background:@roleColor;">
                    @(userName.Length > 0 ? userName[0].ToString().ToUpper() : "U")
                </div>
                <div class="topbar-user-info">
                    <span class="topbar-user-name">@userName</span>
                    <span class="topbar-user-role">@roleLabel</span>
                </div>
            </div>
        </div>
    </header>

    <!-- PAGE BODY -->
    <main class="dash-content">
        @RenderBody()
    </main>

    <!-- FOOTER -->
    <footer class="dash-footer">
        <span>© @DateTime.Now.Year Course Schedules Awareness System · University of Lay Adventists of Kigali</span>
        <span>CIS Department · CIT Faculty &nbsp;|&nbsp;
            <a href="https://umurongosmart.com" target="_blank" style="color:#1556c8;text-decoration:none;font-weight:600;">
                <i class="bi bi-headset me-1"></i>UmurongoSmart Support
            </a>
        </span>
    </footer>
</div>

<!-- ═══════════════════════════════════════════════════
     UMURONGOSMART SUPPORT WIDGET (floating button + slide-up panel)
════════════════════════════════════════════════════ -->

<!-- Floating trigger button -->
<button id="supportBtn" onclick="toggleSupport()" title="Academic Support — UmurongoSmart"
    style="position:fixed;bottom:2rem;right:2rem;z-index:1000;
           width:56px;height:56px;border-radius:50%;border:none;
           background:linear-gradient(135deg,#1556c8,#153f83);
           color:#fff;font-size:22px;cursor:pointer;
           box-shadow:0 8px 25px rgba(21,86,200,.45);
           display:flex;align-items:center;justify-content:center;
           transition:transform .2s,box-shadow .2s;">
    <i class="bi bi-headset" id="supportBtnIcon"></i>
    <span id="supportDot" style="position:absolute;top:6px;right:6px;
          width:10px;height:10px;border-radius:50%;background:#22c55e;
          border:2px solid #fff;"></span>
</button>

<!-- Support slide-up panel -->
<div id="supportPanel"
    style="display:none;position:fixed;bottom:6.5rem;right:2rem;z-index:999;
           width:360px;background:#fff;border-radius:18px;
           box-shadow:0 20px 60px rgba(0,0,0,.22);overflow:hidden;
           animation:slideUp .25s ease;">
    
    <!-- Panel header -->
    <div style="background:linear-gradient(135deg,#1556c8,#153f83);padding:1rem 1.25rem;
                display:flex;align-items:center;justify-content:space-between;">
        <div style="display:flex;align-items:center;gap:10px;color:#fff;">
            <div style="width:38px;height:38px;border-radius:50%;background:rgba(255,255,255,.15);
                        display:flex;align-items:center;justify-content:center;font-size:18px;">
                <i class="bi bi-headset"></i>
            </div>
            <div>
                <div style="font-weight:700;font-size:14px;">CSAS Academic Support</div>
                <div style="font-size:11px;opacity:.8;">Powered by UmurongoSmart.com</div>
            </div>
        </div>
        <button onclick="toggleSupport()" style="background:none;border:none;color:rgba(255,255,255,.7);
                font-size:20px;cursor:pointer;line-height:1;">&times;</button>
    </div>

    <!-- Tabs -->
    <div style="display:flex;border-bottom:1px solid #e2e8f0;">
        <button onclick="showSupportTab('query')" id="tabQuery"
            style="flex:1;padding:.65rem;border:none;background:#fff;
                   font-size:12px;font-weight:700;color:#1556c8;
                   border-bottom:2px solid #1556c8;cursor:pointer;">
            <i class="bi bi-chat-dots-fill me-1"></i>Send Query
        </button>
        <button onclick="showSupportTab('faq')" id="tabFaq"
            style="flex:1;padding:.65rem;border:none;background:#f8fafc;
                   font-size:12px;font-weight:600;color:#6c8097;
                   border-bottom:2px solid transparent;cursor:pointer;">
            <i class="bi bi-question-circle-fill me-1"></i>Quick Help
        </button>
        <button onclick="showSupportTab('portal')" id="tabPortal"
            style="flex:1;padding:.65rem;border:none;background:#f8fafc;
                   font-size:12px;font-weight:600;color:#6c8097;
                   border-bottom:2px solid transparent;cursor:pointer;">
            <i class="bi bi-box-arrow-up-right me-1"></i>Portal
        </button>
    </div>

    <!-- TAB: Send Query -->
    <div id="supportTabQuery" style="padding:1.1rem;">
        <p style="font-size:12px;color:#6c8097;margin-bottom:.85rem;">
            Submit your question to the CSAS support team. We'll get back to you within 24 hours.
        </p>
        <div style="margin-bottom:.75rem;">
            <label style="font-size:12px;font-weight:700;color:#374151;display:block;margin-bottom:4px;">Your Name</label>
            <input type="text" id="sqName" placeholder="e.g. Alice Uwimana"
                style="width:100%;border:1.5px solid #e2e8f0;border-radius:8px;
                       padding:.5rem .75rem;font-size:13px;outline:none;"/>
        </div>
        <div style="margin-bottom:.75rem;">
            <label style="font-size:12px;font-weight:700;color:#374151;display:block;margin-bottom:4px;">Category</label>
            <select id="sqCategory"
                style="width:100%;border:1.5px solid #e2e8f0;border-radius:8px;
                       padding:.5rem .75rem;font-size:13px;outline:none;background:#fff;">
                <option>Timetable / Schedule issue</option>
                <option>Room shift complaint</option>
                <option>Lecturer attendance issue</option>
                <option>Course registration problem</option>
                <option>WhatsApp group access</option>
                <option>Login / Account issue</option>
                <option>Other</option>
            </select>
        </div>
        <div style="margin-bottom:.75rem;">
            <label style="font-size:12px;font-weight:700;color:#374151;display:block;margin-bottom:4px;">Message</label>
            <textarea id="sqMessage" rows="3" placeholder="Describe your issue or question…"
                style="width:100%;border:1.5px solid #e2e8f0;border-radius:8px;
                       padding:.5rem .75rem;font-size:13px;outline:none;resize:none;"></textarea>
        </div>
        <div style="display:flex;gap:.6rem;">
            <button onclick="submitQuery()"
                style="flex:1;background:#1556c8;color:#fff;border:none;border-radius:9px;
                       padding:.6rem;font-size:13px;font-weight:700;cursor:pointer;">
                <i class="bi bi-send-fill me-1"></i>Send Query
            </button>
            <a href="https://umurongosmart.com" target="_blank"
                style="flex:1;background:#f8fafc;color:#1556c8;border:1.5px solid #dbeafe;
                       border-radius:9px;padding:.6rem;font-size:13px;font-weight:700;
                       cursor:pointer;text-align:center;text-decoration:none;display:flex;
                       align-items:center;justify-content:center;gap:5px;">
                <i class="bi bi-box-arrow-up-right"></i>Full Portal
            </a>
        </div>
        <div id="sqSuccess" style="display:none;margin-top:.75rem;background:#ecfdf5;
             border:1px solid #bbf7d0;border-radius:8px;padding:.6rem .9rem;
             font-size:12px;font-weight:700;color:#15803d;">
            <i class="bi bi-check-circle-fill me-1"></i>Query sent! Redirecting to UmurongoSmart…
        </div>
    </div>

    <!-- TAB: Quick Help FAQ -->
    <div id="supportTabFaq" style="display:none;padding:1.1rem;">
        <div style="display:flex;flex-direction:column;gap:.5rem;">
            <details style="border:1px solid #e2e8f0;border-radius:9px;overflow:hidden;">
                <summary style="padding:.65rem .9rem;font-size:13px;font-weight:700;cursor:pointer;background:#f8fafc;">
                    How do I view my timetable?
                </summary>
                <p style="padding:.65rem .9rem;font-size:12px;color:#6c8097;margin:0;">
                    Log in with your Reg No. and password. Your timetable is on the Student Dashboard under "Today's Schedule". Filter by your Study Session (Day/Evening/Weekend).
                </p>
            </details>
            <details style="border:1px solid #e2e8f0;border-radius:9px;overflow:hidden;">
                <summary style="padding:.65rem .9rem;font-size:13px;font-weight:700;cursor:pointer;background:#f8fafc;">
                    How do I join a class WhatsApp group?
                </summary>
                <p style="padding:.65rem .9rem;font-size:12px;color:#6c8097;margin:0;">
                    Go to your Enrolled Courses section on the Student Dashboard and click the green WhatsApp button next to the course. Links are published by your Class Representative.
                </p>
            </details>
            <details style="border:1px solid #e2e8f0;border-radius:9px;overflow:hidden;">
                <summary style="padding:.65rem .9rem;font-size:13px;font-weight:700;cursor:pointer;background:#f8fafc;">
                    How do I report a room shift?
                </summary>
                <p style="padding:.65rem .9rem;font-size:12px;color:#6c8097;margin:0;">
                    Room shifts are automatically notified. If you notice an unannounced shift, ask your Class Representative (CP) to submit a flag via their dashboard.
                </p>
            </details>
            <details style="border:1px solid #e2e8f0;border-radius:9px;overflow:hidden;">
                <summary style="padding:.65rem .9rem;font-size:13px;font-weight:700;cursor:pointer;background:#f8fafc;">
                    I forgot my password. What do I do?
                </summary>
                <p style="padding:.65rem .9rem;font-size:12px;color:#6c8097;margin:0;">
                    Go to the Login page and click "Forgot password?" or contact the CIS Department administrator directly.
                </p>
            </details>
        </div>
    </div>

    <!-- TAB: Portal link (UmurongoSmart — UNILAK Support System) -->
    <div id="supportTabPortal" style="display:none;padding:1.25rem;">
        <div style="text-align:center;padding:1rem 0;">
            <div style="width:60px;height:60px;border-radius:50%;
                        background:linear-gradient(135deg,#1556c8,#153f83);
                        display:flex;align-items:center;justify-content:center;
                        font-size:26px;color:#fff;margin:0 auto 1rem;">
                <i class="bi bi-headset"></i>
            </div>
            <h6 style="font-weight:700;color:#142d4d;margin-bottom:.5rem;">
                UmurongoSmart — UNILAK Support Portal
            </h6>
            <p style="font-size:12px;color:#6c8097;margin-bottom:1.25rem;line-height:1.6;">
                UmurongoSmart is the official academic support system used by UNILAK.
                Click below to open the portal in a new tab and submit your query directly.
            </p>
            <a href="https://umurongosmart.com" target="_blank"
               style="display:inline-flex;align-items:center;gap:8px;
                      background:linear-gradient(135deg,#1556c8,#153f83);
                      color:#fff;text-decoration:none;border-radius:10px;
                      padding:.75rem 1.5rem;font-size:14px;font-weight:700;
                      box-shadow:0 6px 20px rgba(21,86,200,.3);">
                <i class="bi bi-box-arrow-up-right"></i> Open UmurongoSmart Portal
            </a>
            <div style="margin-top:1rem;font-size:11px;color:#9ca3af;">
                You will be redirected to umurongosmart.com
            </div>
        </div>
    </div>
</div>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script>
    // ── Sidebar toggle ────────────────────────────────────
    function toggleSidebar() {
        document.getElementById('sidebar').classList.toggle('collapsed');
        document.getElementById('dashMain').classList.toggle('expanded');
    }
    document.addEventListener('click', function (e) {
        var sb = document.getElementById('sidebar');
        var toggle = document.getElementById('sidebarToggle');
        if (window.innerWidth < 900 && sb.classList.contains('open')
            && !sb.contains(e.target) && e.target !== toggle) {
            sb.classList.remove('open');
        }
    });
    document.getElementById('sidebarToggle').addEventListener('click', function (e) {
        e.stopPropagation();
        if (window.innerWidth < 900)
            document.getElementById('sidebar').classList.toggle('open');
    });

    // ── Support widget ─────────────────────────────────────
    function toggleSupport() {
        var panel = document.getElementById('supportPanel');
        var icon  = document.getElementById('supportBtnIcon');
        var isOpen = panel.style.display !== 'none';
        panel.style.display = isOpen ? 'none' : 'block';
        icon.className = isOpen ? 'bi bi-headset' : 'bi bi-x-lg';
    }

    function showSupportTab(tab) {
        ['query','faq','portal'].forEach(function(t) {
            document.getElementById('supportTab' + t.charAt(0).toUpperCase() + t.slice(1)).style.display = 'none';
            document.getElementById('tab' + t.charAt(0).toUpperCase() + t.slice(1)).style.borderBottomColor = 'transparent';
            document.getElementById('tab' + t.charAt(0).toUpperCase() + t.slice(1)).style.background = '#f8fafc';
            document.getElementById('tab' + t.charAt(0).toUpperCase() + t.slice(1)).style.color = '#6c8097';
        });
        document.getElementById('supportTab' + tab.charAt(0).toUpperCase() + tab.slice(1)).style.display = 'block';
        document.getElementById('tab' + tab.charAt(0).toUpperCase() + tab.slice(1)).style.borderBottomColor = '#1556c8';
        document.getElementById('tab' + tab.charAt(0).toUpperCase() + tab.slice(1)).style.background = '#fff';
        document.getElementById('tab' + tab.charAt(0).toUpperCase() + tab.slice(1)).style.color = '#1556c8';
    }

    // ── Auto-switch tab from URL ?tab= param ─────────────
    (function() {
        var params = new URLSearchParams(window.location.search);
        var tab = params.get('tab');
        if (!tab) return;
        // CP tabs
        var cpFn = window.showCPTab;
        if (cpFn) {
            var btn = document.querySelector('.cp-tab[onclick*="' + tab + '"]');
            cpFn(tab, btn);
            return;
        }
        // Dean tabs
        var deanFn = window.showTab;
        if (deanFn) {
            var dBtn = document.querySelector('.dean-tab[onclick*="' + tab + '"]');
            deanFn(tab, dBtn);
        }
    })();
        var name    = document.getElementById('sqName').value.trim();
        var cat     = document.getElementById('sqCategory').value;
        var message = document.getElementById('sqMessage').value.trim();
        if (!name || !message) {
            alert('Please fill in your name and message.');
            return;
        }
        document.getElementById('sqSuccess').style.display = 'block';
        // Build UmurongoSmart query URL with pre-filled data
        var url = 'https://umurongosmart.com/?name=' + encodeURIComponent(name)
                + '&category=' + encodeURIComponent(cat)
                + '&message=' + encodeURIComponent(message)
                + '&source=CSAS-UNILAK';
        setTimeout(function() { window.open(url, '_blank'); }, 1500);
        document.getElementById('sqName').value    = '';
        document.getElementById('sqMessage').value = '';
    }
</script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>


