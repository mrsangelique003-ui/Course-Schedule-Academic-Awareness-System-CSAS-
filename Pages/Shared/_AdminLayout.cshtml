@using System.Security.Claims

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - CSAS Administration</title>

    <meta name="description" content="Course Schedule & Academic Awareness System Administration" />

    <link rel="icon" type="image/png" href="~/images/PNG_LOGO-_UNILAK-removebg-preview.png" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap" rel="stylesheet" />

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/Admin/Layout.css" asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)
</head>

<body>

@{
    var currentPage = ViewContext.RouteData.Values["page"]?.ToString() ?? "";

    var userName = User.Identity?.Name ?? "Administrator";

    var userRole = User.FindFirst(ClaimTypes.Role)?.Value ?? "Administrator";

    var staffId = User.FindFirst("StaffId")?.Value
        ?? User.FindFirst(ClaimTypes.NameIdentifier)?.Value
        ?? "ADM001";

    var isAuthenticated = User.Identity?.IsAuthenticated ?? false;

    var initials = "AD";

    if (!string.IsNullOrWhiteSpace(userName))
    {
        var parts = userName
            .Split(' ', StringSplitOptions.RemoveEmptyEntries);

        if (parts.Length >= 2)
        {
            initials = $"{parts[0][0]}{parts[^1][0]}".ToUpper();
        }
        else if (parts.Length == 1)
        {
            initials = parts[0].Length >= 2
                ? parts[0][..2].ToUpper()
                : parts[0].ToUpper();
        }
    }
}

<div class="admin-shell">

    <aside class="admin-sidebar" id="adminSidebar">

        <div class="admin-sidebar-header">

            <a asp-page="/Admin/Dashboard" class="admin-brand">

                <div class="admin-brand-logo">
                    <img src="~/images/PNG_LOGO-_UNILAK-removebg-preview.png"
                         alt="UNILAK Logo" />
                </div>

                <div class="admin-brand-text">
                    <span class="admin-brand-name">CSAS</span>
                    <span class="admin-brand-subtitle">Administration</span>
                </div>

            </a>

            <button type="button"
                    class="sidebar-close-btn"
                    id="sidebarCloseBtn"
                    aria-label="Close sidebar">
                <i class="bi bi-x-lg"></i>
            </button>

        </div>

        <div class="admin-user-card">

            <div class="admin-user-avatar">
                @initials
            </div>

            <div class="admin-user-info">

                <span class="admin-user-name">
                    @userName
                </span>

                <span class="admin-user-role">
                    @userRole
                </span>

                <span class="admin-user-id">
                    @staffId
                </span>

            </div>

            <a asp-page="/Admin/Profile"
               class="admin-user-action"
               title="My Profile">
                <i class="bi bi-three-dots-vertical"></i>
            </a>

        </div>

        <nav class="admin-navigation">

            <div class="nav-section-title">
                MAIN
            </div>

            <a asp-page="/Admin/Dashboard"
               class="admin-nav-link @(currentPage == "/Admin/Dashboard" ? "active" : "")">

                <span class="nav-icon">
                    <i class="bi bi-grid-1x2-fill"></i>
                </span>

                <span class="nav-label">
                    Dashboard
                </span>

            </a>

            <div class="nav-section-title">
                ACADEMIC MANAGEMENT
            </div>

            <a asp-page="/Admin/Students"
               class="admin-nav-link @(currentPage == "/Admin/Students" ? "active" : "")">

                <span class="nav-icon">
                    <i class="bi bi-people-fill"></i>
                </span>

                <span class="nav-label">
                    Students
                </span>

            </a>

            <a asp-page="/Admin/Lecturers"
               class="admin-nav-link @(currentPage == "/Admin/Lecturers" ? "active" : "")">

                <span class="nav-icon">
                    <i class="bi bi-person-workspace"></i>
                </span>

                <span class="nav-label">
                    Lecturers
                </span>

            </a>

            <a asp-page="/Admin/Courses"
               class="admin-nav-link @(currentPage == "/Admin/Courses" ? "active" : "")">

                <span class="nav-icon">
                    <i class="bi bi-book-fill"></i>
                </span>

                <span class="nav-label">
                    Courses
                </span>

            </a>

            <a asp-page="/Admin/Classrooms"
               class="admin-nav-link @(currentPage == "/Admin/Classrooms" ? "active" : "")">

                <span class="nav-icon">
                    <i class="bi bi-building-fill"></i>
                </span>

                <span class="nav-label">
                    Classrooms
                </span>

            </a>

            <a asp-page="/Admin/Schedules"
               class="admin-nav-link @(currentPage == "/Admin/Schedules" ? "active" : "")">

                <span class="nav-icon">
                    <i class="bi bi-calendar3"></i>
                </span>

                <span class="nav-label">
                    Schedules
                </span>

            </a>

            <a asp-page="/Admin/Enrollments"
               class="admin-nav-link @(currentPage == "/Admin/Enrollments" ? "active" : "")">

                <span class="nav-icon">
                    <i class="bi bi-journal-check"></i>
                </span>

                <span class="nav-label">
                    Enrollments
                </span>

            </a>

            <a asp-page="/Admin/Examinations"
               class="admin-nav-link @(currentPage == "/Admin/Examinations" ? "active" : "")">

                <span class="nav-icon">
                    <i class="bi bi-file-earmark-text-fill"></i>
                </span>

                <span class="nav-label">
                    Examinations
                </span>

            </a>

            <div class="nav-section-title">
                SYSTEM
            </div>

            <a asp-page="/Admin/Support"
               class="admin-nav-link @(currentPage == "/Admin/Support" ? "active" : "")">

                <span class="nav-icon">
                    <i class="bi bi-headset"></i>
                </span>

                <span class="nav-label">
                    Support
                </span>

            </a>

            <a asp-page="/Admin/Profile"
               class="admin-nav-link @(currentPage == "/Admin/Profile" ? "active" : "")">

                <span class="nav-icon">
                    <i class="bi bi-person-circle"></i>
                </span>

                <span class="nav-label">
                    My Profile
                </span>

            </a>

        </nav>

        <div class="admin-sidebar-footer">

            <a asp-page="/Account/Logout"
               class="admin-logout-link">

                <span class="nav-icon">
                    <i class="bi bi-box-arrow-left"></i>
                </span>

                <span class="nav-label">
                    Sign Out
                </span>

            </a>

            <div class="admin-version">
                <span>CSAS</span>
                <span>v1.0</span>
            </div>

        </div>

    </aside>

    <div class="admin-sidebar-overlay" id="sidebarOverlay"></div>

    <div class="admin-content">

        <header class="admin-topbar">

            <div class="topbar-left">

                <button type="button"
                        class="sidebar-toggle-btn"
                        id="sidebarToggleBtn"
                        aria-label="Open navigation">

                    <i class="bi bi-list"></i>

                </button>

                <div class="topbar-breadcrumb">

                    <span class="breadcrumb-parent">
                        Administration
                    </span>

                    <i class="bi bi-chevron-right"></i>

                    <span class="breadcrumb-current">
                        @ViewData["Title"]
                    </span>

                </div>

            </div>

            <div class="topbar-right">

                <div class="topbar-search">

                    <i class="bi bi-search"></i>

                    <input type="search"
                           id="adminSearch"
                           placeholder="Search..."
                           autocomplete="off" />

                </div>

                <a asp-page="/Admin/Support"
                   class="topbar-action"
                   title="Support">

                    <i class="bi bi-headset"></i>

                </a>

                <button type="button"
                        class="topbar-action"
                        title="Notifications">

                    <i class="bi bi-bell"></i>

                    <span class="notification-dot"></span>

                </button>

                <button type="button"
                        class="topbar-action"
                        id="fullscreenBtn"
                        title="Fullscreen">

                    <i class="bi bi-fullscreen"></i>

                </button>

                <a asp-page="/Admin/Profile"
                   class="topbar-profile">

                    <div class="topbar-profile-avatar">
                        @initials
                    </div>

                    <div class="topbar-profile-info">

                        <span class="topbar-profile-name">
                            @userName
                        </span>

                        <span class="topbar-profile-role">
                            @userRole
                        </span>

                    </div>

                    <i class="bi bi-chevron-down"></i>

                </a>

            </div>

        </header>

        <main class="admin-main">

            @RenderBody()

        </main>

        <footer class="admin-footer">

            <span>
                © @DateTime.Now.Year Course Schedule & Academic Awareness System
            </span>

            <span>
                UNILAK
            </span>

        </footer>

    </div>

</div>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

<script>

    document.addEventListener("DOMContentLoaded", function () {

        const sidebar = document.getElementById("adminSidebar");
        const overlay = document.getElementById("sidebarOverlay");
        const toggleBtn = document.getElementById("sidebarToggleBtn");
        const closeBtn = document.getElementById("sidebarCloseBtn");
        const fullscreenBtn = document.getElementById("fullscreenBtn");

        function openSidebar() {

            if (!sidebar) return;

            sidebar.classList.add("sidebar-open");

            if (overlay) {
                overlay.classList.add("overlay-visible");
            }

            document.body.classList.add("sidebar-active");
        }

        function closeSidebar() {

            if (!sidebar) return;

            sidebar.classList.remove("sidebar-open");

            if (overlay) {
                overlay.classList.remove("overlay-visible");
            }

            document.body.classList.remove("sidebar-active");
        }

        if (toggleBtn) {
            toggleBtn.addEventListener("click", openSidebar);
        }

        if (closeBtn) {
            closeBtn.addEventListener("click", closeSidebar);
        }

        if (overlay) {
            overlay.addEventListener("click", closeSidebar);
        }

        document.querySelectorAll(".admin-nav-link").forEach(function (link) {

            link.addEventListener("click", function () {

                if (window.innerWidth <= 991) {
                    closeSidebar();
                }

            });

        });

        if (fullscreenBtn) {

            fullscreenBtn.addEventListener("click", function () {

                if (!document.fullscreenElement) {

                    document.documentElement
                        .requestFullscreen()
                        .catch(function () {});

                } else {

                    if (document.exitFullscreen) {
                        document.exitFullscreen();
                    }

                }

            });

        }

        document.addEventListener("fullscreenchange", function () {

            if (!fullscreenBtn) return;

            const icon = fullscreenBtn.querySelector("i");

            if (!icon) return;

            if (document.fullscreenElement) {

                icon.className = "bi bi-fullscreen-exit";

                fullscreenBtn.setAttribute(
                    "title",
                    "Exit Fullscreen"
                );

            } else {

                icon.className = "bi bi-fullscreen";

                fullscreenBtn.setAttribute(
                    "title",
                    "Fullscreen"
                );

            }

        });

        const searchInput = document.getElementById("adminSearch");

        if (searchInput) {

            searchInput.addEventListener("keydown", function (event) {

                if (event.key !== "Enter") {
                    return;
                }

                const query = searchInput.value.trim().toLowerCase();

                if (!query) {
                    return;
                }

                const navigationLinks =
                    document.querySelectorAll(".admin-nav-link");

                let matched = false;

                navigationLinks.forEach(function (link) {

                    const text =
                        link.textContent.trim().toLowerCase();

                    if (!matched && text.includes(query)) {

                        matched = true;

                        link.click();

                    }

                });

            });

        }

    });

</script>

@await RenderSectionAsync("Scripts", required: false)

</body>
</html>