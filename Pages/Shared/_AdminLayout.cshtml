@using System.Security.Claims

<!DOCTYPE html>

<html lang="en">

<head>


<meta charset="utf-8" />

<meta name="viewport" content="width=device-width, initial-scale=1.0" />

<title>@ViewData["Title"] - CSAS Administration</title>

<meta name="description"
      content="Course Schedule & Academic Awareness System Administration" />

<link rel="icon"
      type="image/png"
      href="~/images/PNG_LOGO-_UNILAK-removebg-preview.png" />

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap"
      rel="stylesheet" />

<link rel="stylesheet"
      href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

<link rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

<link rel="stylesheet"
      href="~/css/Admin/Layout.css"
      asp-append-version="true" />

@await RenderSectionAsync("Styles", required: false)


</head>

<body>

@{
var currentPage =
ViewContext.RouteData.Values["page"]?.ToString() ?? "";


var userName =
    User.Identity?.Name ?? "Administrator";

var userRole =
    User.FindFirst(ClaimTypes.Role)?.Value ?? "Administrator";

var staffId =
    User.FindFirst("StaffId")?.Value
    ?? User.FindFirst(ClaimTypes.NameIdentifier)?.Value
    ?? "ADM001";

var initials = "AD";

if (!string.IsNullOrWhiteSpace(userName))
{
    var parts =
        userName.Split(
            ' ',
            StringSplitOptions.RemoveEmptyEntries);

    if (parts.Length >= 2)
    {
        initials =
            $"{parts[0][0]}{parts[^1][0]}".ToUpper();
    }
    else if (parts.Length == 1)
    {
        initials =
            parts[0].Length >= 2
                ? parts[0][..2].ToUpper()
                : parts[0].ToUpper();
    }
}


}

<div class="admin-shell">


<aside class="admin-sidebar" id="adminSidebar">

    <div class="admin-sidebar-header">

        <a asp-page="/Admin/Dashboard"
           class="admin-brand">

            <div class="admin-brand-logo">

                <img src="~/images/PNG_LOGO-_UNILAK-removebg-preview.png"
                     alt="UNILAK Logo" />

            </div>

            <div class="admin-brand-text">

                <span class="admin-brand-name">
                    CSAS
                </span>

                <span class="admin-brand-subtitle">
                    Administration
                </span>

            </div>

        </a>

        <button type="button"
                class="sidebar-close-btn"
                id="sidebarCloseBtn"
                aria-label="Close navigation">

            <i class="bi bi-x-lg"></i>

        </button>

    </div>

    <nav class="admin-navigation">

        <a asp-page="/Admin/Dashboard"
           class="admin-nav-link @(currentPage == "/Admin/Dashboard" ? "active" : "")">

            <span class="nav-icon">
                <i class="bi bi-grid-1x2-fill"></i>
            </span>

            <span class="nav-label">
                Dashboard
            </span>

        </a>

        <a asp-page="/Admin/Students"
           class="admin-nav-link @(currentPage == "/Admin/Students" ? "active" : "")">

            <span class="nav-icon">
                <i class="bi bi-people-fill"></i>
            </span>

            <span class="nav-label">
                Students
            </span>

        </a>

        <a asp-page="/Admin/Lecturers"
           class="admin-nav-link @(currentPage == "/Admin/Lecturers" ? "active" : "")">

            <span class="nav-icon">
                <i class="bi bi-person-workspace"></i>
            </span>

            <span class="nav-label">
                Lecturers
            </span>

        </a>

        <a asp-page="/Admin/ClassRepresentatives"
           class="admin-nav-link @(currentPage == "/Admin/ClassRepresentatives" ? "active" : "")">

            <span class="nav-icon">
                <i class="bi bi-person-badge-fill"></i>
            </span>

            <span class="nav-label">
                Class Representatives
            </span>

        </a>

        <a asp-page="/Admin/Courses"
           class="admin-nav-link @(currentPage == "/Admin/Courses" ? "active" : "")">

            <span class="nav-icon">
                <i class="bi bi-book-fill"></i>
            </span>

            <span class="nav-label">
                Courses
            </span>

        </a>

        <a asp-page="/Admin/Enrollments"
           class="admin-nav-link @(currentPage == "/Admin/Enrollments" ? "active" : "")">

            <span class="nav-icon">
                <i class="bi bi-person-vcard-fill"></i>
            </span>

            <span class="nav-label">
                Enrollments
            </span>

        </a>

        <a asp-page="/Admin/ClassroomManagement"
           class="admin-nav-link @(currentPage == "/Admin/ClassroomManagement" ? "active" : "")">

            <span class="nav-icon">
                <i class="bi bi-building-fill"></i>
            </span>

            <span class="nav-label">
                Classrooms
            </span>

        </a>

        <a asp-page="/Admin/Schedules"
           class="admin-nav-link @(currentPage == "/Admin/Schedules" ? "active" : "")">
            <span class="nav-icon">
                <i class="bi bi-calendar3"></i>
            </span>
            <span class="nav-label">Schedules</span>
        </a>

    </nav>

</aside>

<div class="admin-sidebar-overlay"
     id="sidebarOverlay">
</div>

<div class="admin-content">

    <header class="admin-topbar">

        <div class="topbar-left">

            <button type="button"
                    class="sidebar-toggle-btn"
                    id="sidebarToggleBtn"
                    aria-label="Open navigation">

                <i class="bi bi-list"></i>

            </button>

            <div class="topbar-breadcrumb">

                <span class="breadcrumb-parent">
                    Administration
                </span>

                <i class="bi bi-chevron-right"></i>

                <span class="breadcrumb-current">
                    @ViewData["Title"]
                </span>

            </div>

        </div>

        <div class="topbar-right">

            <div class="topbar-profile">

                <div class="topbar-profile-avatar">
                    @initials
                </div>

                <div class="topbar-profile-info">

                    <span class="topbar-profile-name">
                        @userName
                    </span>

                    <span class="topbar-profile-role">
                        @userRole
                    </span>

                </div>

            </div>

            <form method="post"
                  asp-page="/Account/Logout"
                  class="topbar-logout-form">

                <button type="submit"
                        class="topbar-logout"
                        aria-label="Sign out">

                    <i class="bi bi-box-arrow-right"></i>

                    <span>
                        Sign Out
                    </span>

                </button>

            </form>

        </div>

    </header>

    <main class="admin-main">

        @RenderBody()

    </main>

    <footer class="admin-footer">

        <span>
            © @DateTime.Now.Year Course Schedule & Academic Awareness System
        </span>

        <span>
            UNILAK
        </span>

    </footer>

</div>


</div>

<script src="~/lib/jquery/dist/jquery.min.js"></script>

<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

<script>

    document.addEventListener("DOMContentLoaded", function () {

        const sidebar =
            document.getElementById("adminSidebar");

        const overlay =
            document.getElementById("sidebarOverlay");

        const toggleBtn =
            document.getElementById("sidebarToggleBtn");

        const closeBtn =
            document.getElementById("sidebarCloseBtn");

        function openSidebar() {

            if (!sidebar) {
                return;
            }

            sidebar.classList.add("sidebar-open");

            if (overlay) {
                overlay.classList.add("overlay-visible");
            }

            document.body.classList.add("sidebar-active");
        }

        function closeSidebar() {

            if (!sidebar) {
                return;
            }

            sidebar.classList.remove("sidebar-open");

            if (overlay) {
                overlay.classList.remove("overlay-visible");
            }

            document.body.classList.remove("sidebar-active");
        }

        if (toggleBtn) {

            toggleBtn.addEventListener(
                "click",
                openSidebar
            );

        }

        if (closeBtn) {

            closeBtn.addEventListener(
                "click",
                closeSidebar
            );

        }

        if (overlay) {

            overlay.addEventListener(
                "click",
                closeSidebar
            );

        }

        document
            .querySelectorAll(".admin-nav-link")
            .forEach(function (link) {

                link.addEventListener(
                    "click",
                    function () {

                        if (window.innerWidth <= 900) {
                            closeSidebar();
                        }

                    }
                );

            });

        window.addEventListener(
            "resize",
            function () {

                if (window.innerWidth > 900) {
                    closeSidebar();
                }

            }
        );

    });

</script>

@await RenderSectionAsync("Scripts", required: false)

</body>

</html>
