<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CSAAS</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/index.css" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg csaas-navbar">
            <div class="container-fluid">
                <a class="csaas-brand" asp-page="/Index">
                    <i class="bi bi-calendar3-week me-2"></i>CSAAS
                </a>
                <button class="navbar-toggler text-white" type="button" data-bs-toggle="collapse" data-bs-target="#csaasNav">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="csaasNav">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-3">
                        <li class="nav-item">
                            <a class="nav-link text-white fw-medium" asp-page="/Student/Dashboard">Student View</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white fw-medium" asp-page="/CP/Verification">CP Verification</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white fw-medium" asp-page="/Management/DeanDashboard">Management</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white fw-medium" asp-page="/Quality/AuditLog">Quality Audit</a>
                        </li>
                    </ul>
                    <div class="d-flex align-items-center gap-2">
                        <span class="nav-role-badge">Demo Mode</span>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="container-fluid px-4 py-4">
        @RenderBody()
    </main>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>