@using System.Security.Claims

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - CSAS</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap"
          rel="stylesheet" />

    <link rel="stylesheet"
          href="~/css/Layout.css"
          asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)
</head>

<body>

<div class="app-shell">

    <!-- =====================================================
         NAVBAR
         ===================================================== -->
    <header class="app-header">

        <nav class="app-navbar" aria-label="Main navigation">

            <a asp-page="/Dashboard" class="app-brand">

                <span class="app-brand-logo">
                    <img src="~/images/PNG_LOGO-_UNILAK-removebg-preview.png"
                         alt="UNILAK Logo" />
                </span>

                <span class="app-brand-text">
                    <strong>UNILAK</strong>
                    <small>Academic Awareness System</small>
                </span>

            </a>


            <div class="app-nav-user">

                <div class="app-nav-user-info">

                    <span class="app-nav-user-avatar">
                        <i class="bi bi-person-fill"
                           aria-hidden="true"></i>
                    </span>

                    <span class="app-nav-user-text">
                        <strong>@(User.Identity?.Name ?? "User")</strong>
                        <small>@(User.FindFirstValue(ClaimTypes.Role) ?? "User")</small>
                    </span>

                </div>


                @if (User.Identity?.IsAuthenticated == true)
                {
                    <form method="post"
                          action="/Account/Logout"
                          class="app-logout-form">

                        @Html.AntiForgeryToken()

                        <button type="submit"
                                class="app-logout-button"
                                title="Sign out of your account">

                            <i class="bi bi-box-arrow-right"
                               aria-hidden="true"></i>

                            <span>Logout</span>

                        </button>

                    </form>
                }

            </div>


            <button type="button"
                    class="app-mobile-toggle"
                    id="appMobileToggle"
                    aria-label="Open navigation menu"
                    aria-expanded="false"
                    aria-controls="appSidebar">

                <i class="bi bi-list"
                   aria-hidden="true"></i>

            </button>

        </nav>

    </header>


    <!-- =====================================================
         APP BODY
         ===================================================== -->
    <div class="app-body">


        <!-- =================================================
             SIDEBAR
             ================================================= -->
        <aside class="app-sidebar"
               id="appSidebar"
               aria-label="Sidebar navigation">

            <nav class="app-sidebar-nav">

                <span class="app-sidebar-group">
                    MAIN MENU
                </span>


                <!-- Dashboard -->
                <a asp-page="/Dashboard"
                   class="app-sidebar-link @(ViewContext.RouteData.Values["page"]?.ToString() == "/Dashboard" ? "active" : "")">

                    <i class="bi bi-grid-1x2"
                       aria-hidden="true"></i>

                    <span>Dashboard</span>

                </a>


                @if (User.IsInRole("Student"))
                {
                    <!-- My Courses -->
                    <a asp-page="/Student/MyCourses"
                       class="app-sidebar-link @(ViewContext.RouteData.Values["page"]?.ToString() == "/Student/MyCourses" ? "active" : "")">

                        <i class="bi bi-journal-bookmark"
                           aria-hidden="true"></i>

                        <span>My Courses</span>

                    </a>


                    <!-- My Schedule -->
                    <a asp-page="/Student/Schedule"
                       class="app-sidebar-link @(ViewContext.RouteData.Values["page"]?.ToString() == "/Student/Schedule" ? "active" : "")">

                        <i class="bi bi-calendar3"
                           aria-hidden="true"></i>

                        <span>My Schedule</span>

                    </a>
                }


                <span class="app-sidebar-group">
                    COMING SOON
                </span>


                <div class="app-sidebar-link app-sidebar-link-disabled"
                     aria-disabled="true">

                    <i class="bi bi-mortarboard"
                       aria-hidden="true"></i>

                    <span>Classroom</span>

                    <small class="app-coming-soon">Soon</small>

                </div>


                <div class="app-sidebar-link app-sidebar-link-disabled"
                     aria-disabled="true">

                    <i class="bi bi-list-task"
                       aria-hidden="true"></i>

                    <span>My Tasks List</span>

                    <small class="app-coming-soon">Soon</small>

                </div>


                <div class="app-sidebar-link app-sidebar-link-disabled"
                     aria-disabled="true">

                    <i class="bi bi-clipboard-check"
                       aria-hidden="true"></i>

                    <span>Exam List</span>

                    <small class="app-coming-soon">Soon</small>

                </div>


                <div class="app-sidebar-link app-sidebar-link-disabled"
                     aria-disabled="true">

                    <i class="bi bi-award"
                       aria-hidden="true"></i>

                    <span>My Result</span>

                    <small class="app-coming-soon">Soon</small>

                </div>


                <span class="app-sidebar-group">
                    REPORT &amp; OTHERS
                </span>


                <div class="app-sidebar-link app-sidebar-link-disabled"
                     aria-disabled="true">

                    <i class="bi bi-file-earmark-text"
                       aria-hidden="true"></i>

                    <span>Student Report</span>

                    <small class="app-coming-soon">Soon</small>

                </div>


                <div class="app-sidebar-link app-sidebar-link-disabled"
                     aria-disabled="true">

                    <i class="bi bi-people"
                       aria-hidden="true"></i>

                    <span>Community Chat</span>

                    <small class="app-coming-soon">Soon</small>

                </div>


                <div class="app-sidebar-link app-sidebar-link-disabled"
                     aria-disabled="true">

                    <i class="bi bi-life-preserver"
                       aria-hidden="true"></i>

                    <span>Technical Support</span>

                    <small class="app-coming-soon">Soon</small>

                </div>


                <!-- =================================================
                     SIDEBAR FOOTER
                     ================================================= -->
                <div class="app-sidebar-footer">

                    <span>
                        © @DateTime.Now.Year University of Lay Adventists of Kigali.
                    </span>

                    <span>
                        Course Schedule &amp; Academic Awareness System
                    </span>

                </div>

            </nav>

        </aside>


        <!-- =================================================
             MAIN CONTENT
             ================================================= -->
        <main class="app-main">

            @RenderBody()

        </main>

    </div>

</div>


<script src="~/lib/jquery/dist/jquery.min.js"
        asp-append-version="true"></script>

<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"
        asp-append-version="true"></script>

<script>
    document.addEventListener("DOMContentLoaded", function () {

        const toggle = document.getElementById("appMobileToggle");
        const sidebar = document.getElementById("appSidebar");

        if (!toggle || !sidebar) {
            return;
        }

        const icon = toggle.querySelector("i");

        function openSidebar() {
            sidebar.classList.add("open");
            toggle.setAttribute("aria-expanded", "true");
            toggle.setAttribute("aria-label", "Close navigation menu");

            if (icon) {
                icon.classList.remove("bi-list");
                icon.classList.add("bi-x-lg");
            }
        }

        function closeSidebar() {
            sidebar.classList.remove("open");
            toggle.setAttribute("aria-expanded", "false");
            toggle.setAttribute("aria-label", "Open navigation menu");

            if (icon) {
                icon.classList.remove("bi-x-lg");
                icon.classList.add("bi-list");
            }
        }

        toggle.addEventListener("click", function () {
            if (sidebar.classList.contains("open")) {
                closeSidebar();
            } else {
                openSidebar();
            }
        });

        document.addEventListener("click", function (event) {
            if (
                sidebar.classList.contains("open") &&
                !sidebar.contains(event.target) &&
                !toggle.contains(event.target)
            ) {
                closeSidebar();
            }
        });

        window.addEventListener("resize", function () {
            if (window.innerWidth > 900) {
                closeSidebar();
            }
        });

        const sidebarLinks = document.querySelectorAll(
            ".app-sidebar-link:not(.app-sidebar-link-disabled)"
        );

        sidebarLinks.forEach(function (link) {
            link.addEventListener("click", function () {
                if (window.innerWidth <= 900) {
                    closeSidebar();
                }
            });
        });

    });
</script>

@await RenderSectionAsync("Scripts", required: false)

</body>
</html>