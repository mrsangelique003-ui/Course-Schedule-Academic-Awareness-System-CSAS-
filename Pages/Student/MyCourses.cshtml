@page
@model CourseScheduleSystem.Web.Pages.Student.MyCoursesModel

@using CourseScheduleSystem.Web.Models

@{
    ViewData["Title"] = "My Courses";
    ViewData["StudentId"] = Model.CurrentStudent?.RegNo ?? "—";
}

<link rel="stylesheet"
      href="~/css/Student/MyCourses.css"
      asp-append-version="true" />

<div class="student-courses-page">

    <!-- Page Header -->
    <section class="courses-page-header">

        <div class="courses-header-content">

            <div class="courses-eyebrow">
                <i class="bi bi-book"></i>
                Academic Courses
            </div>

            <h1>My Courses</h1>

            <p>
                See your registered courses, lecturers, credits,
                and class information.
            </p>

        </div>

        <div class="courses-student-badge">

            <div class="courses-student-avatar">
                <i class="bi bi-person"></i>
            </div>

            <div class="courses-student-details">

                <span>Student</span>

                <strong>
                    @(Model.CurrentStudent?.FullName ?? "Student")
                </strong>

                <small>
                    @(Model.CurrentStudent?.RegNo ?? "—")
                </small>

            </div>

        </div>

    </section>


    <!-- Course Statistics -->
    <section class="courses-stats">

        <div class="course-stat-card">

            <div class="course-stat-icon course-stat-icon-blue">
                <i class="bi bi-book"></i>
            </div>

            <div class="course-stat-content">
                <span>Total Courses</span>
                <strong>@Model.TotalCourses</strong>
            </div>

        </div>


        <div class="course-stat-card">

            <div class="course-stat-icon course-stat-icon-green">
                <i class="bi bi-check-circle"></i>
            </div>

            <div class="course-stat-content">
                <span>Enrolled</span>
                <strong>@Model.EnrolledCourses</strong>
            </div>

        </div>


        <div class="course-stat-card">

            <div class="course-stat-icon course-stat-icon-yellow">
                <i class="bi bi-clock"></i>
            </div>

            <div class="course-stat-content">
                <span>Pending</span>
                <strong>@Model.PendingCourses</strong>
            </div>

        </div>


        <div class="course-stat-card">

            <div class="course-stat-icon course-stat-icon-purple">
                <i class="bi bi-award"></i>
            </div>

            <div class="course-stat-content">
                <span>Total Credits</span>
                <strong>@Model.TotalCredits</strong>
            </div>

        </div>

    </section>


    <!-- Courses Panel -->
    <section class="courses-panel">

        <div class="courses-panel-header">

            <div>
                <span class="courses-panel-label">
                    Academic Registration
                </span>

                <h2>Your Courses</h2>
            </div>

            <div class="courses-count">
                <i class="bi bi-collection"></i>
                <span>
                    @Model.TotalCourses
                    @(Model.TotalCourses == 1 ? "course" : "courses")
                </span>
            </div>

        </div>


        @if (Model.Courses.Any())
        {
            <div class="courses-list">

                @foreach (var course in Model.Courses)
                {
                    var statusClass =
                        course.Status switch
                        {
                            EnrollmentStatus.Enrolled =>
                                "course-status-enrolled",

                            EnrollmentStatus.Pending =>
                                "course-status-pending",

                            EnrollmentStatus.Closed =>
                                "course-status-closed",

                            _ =>
                                "course-status-default"
                        };

                    var statusIcon =
                        course.Status switch
                        {
                            EnrollmentStatus.Enrolled =>
                                "bi-check-circle-fill",

                            EnrollmentStatus.Pending =>
                                "bi-clock-fill",

                            EnrollmentStatus.Closed =>
                                "bi-x-circle-fill",

                            _ =>
                                "bi-info-circle-fill"
                        };

                    <article class="course-card">

                        <!-- Course Card Header -->
                        <div class="course-card-top">

                            <div class="course-heading">

                                <span class="course-code">
                                    @course.Code
                                </span>

                                <h3>
                                    @course.Name
                                </h3>

                            </div>

                            <div class="course-status @statusClass">
                                <i class="bi @statusIcon"></i>
                                <span>@course.Status</span>
                            </div>

                        </div>


                        <!-- Course Description -->
                        @if (!string.IsNullOrWhiteSpace(course.Description))
                        {
                            <div class="course-description">
                                <p>
                                    @course.Description
                                </p>
                            </div>
                        }


                        <!-- Course Information -->
                        <div class="course-details">

                            <div class="course-detail">

                                <div class="course-detail-icon">
                                    <i class="bi bi-person"></i>
                                </div>

                                <div class="course-detail-content">
                                    <span>Lecturer</span>

                                    <strong>
                                        @course.LecturerName
                                    </strong>
                                </div>

                            </div>


                            <div class="course-detail">

                                <div class="course-detail-icon">
                                    <i class="bi bi-award"></i>
                                </div>

                                <div class="course-detail-content">
                                    <span>Credits</span>

                                    <strong>
                                        @course.Credits
                                        @(course.Credits == 1
                                            ? "Credit"
                                            : "Credits")
                                    </strong>
                                </div>

                            </div>


                            <div class="course-detail">

                                <div class="course-detail-icon">
                                    <i class="bi bi-clock"></i>
                                </div>

                                <div class="course-detail-content">
                                    <span>Study Session</span>

                                    <strong>
                                        @course.StudySession
                                    </strong>
                                </div>

                            </div>

                        </div>


                        <!-- Course Dates -->
                        @if (course.StartDate.HasValue ||
                             course.EndDate.HasValue)
                        {
                            <div class="course-dates">

                                @if (course.StartDate.HasValue)
                                {
                                    <div class="course-date">

                                        <i class="bi bi-calendar-event"></i>

                                        <div>
                                            <span>Starts</span>

                                            <strong>
                                                @course.StartDate.Value
                                                    .ToString("dd MMM yyyy")
                                            </strong>
                                        </div>

                                    </div>
                                }


                                @if (course.EndDate.HasValue)
                                {
                                    <div class="course-date">

                                        <i class="bi bi-calendar-check"></i>

                                        <div>
                                            <span>Ends</span>

                                            <strong>
                                                @course.EndDate.Value
                                                    .ToString("dd MMM yyyy")
                                            </strong>
                                        </div>

                                    </div>
                                }

                            </div>
                        }


                        <!-- Course Footer -->
                        <div class="course-card-footer">

                            <span class="course-reference">
                                Course ID: @course.CourseId
                            </span>

                            <a asp-page="/Student/CourseDetails"
                               asp-route-id="@course.CourseId"
                               class="course-details-button">

                                <span>View Details</span>

                                <i class="bi bi-arrow-right"></i>

                            </a>

                        </div>

                    </article>
                }

            </div>
        }
        else
        {
            <!-- Empty State -->
            <div class="courses-empty">

                <div class="courses-empty-icon">
                    <i class="bi bi-journal-x"></i>
                </div>

                <h3>No courses yet</h3>

                <p>
                    You do not have any registered courses at the moment.
                    Your courses will appear here once you are enrolled.
                </p>

                <a asp-page="/Dashboard"
                   class="courses-empty-button">

                    <i class="bi bi-arrow-left"></i>
                    Back to Dashboard

                </a>

            </div>
        }

    </section>


    <!-- Information Notice -->
    <section class="courses-information">

        <div class="courses-information-icon">
            <i class="bi bi-info-circle"></i>
        </div>

        <div class="courses-information-content">

            <h3>Need help with a course?</h3>

            <p>
                If your course information, lecturer, or enrollment
                status is incorrect, contact your academic administrator
                or class representative.
            </p>

        </div>

    </section>

</div>