@page
@model CourseScheduleSystem.Web.Pages.Student.ChangePasswordModel

@{
ViewData["Title"] = "Change Password";
ViewData["StudentId"] = User.FindFirst("RegNo")?.Value ?? "—";
}

<link rel="stylesheet" href="~/css/Student/ChangePassword.css" asp-append-version="true" />

<div class="change-password-page">


<div class="change-password-header">
    <div>
        <span class="change-password-eyebrow">
            <i class="bi bi-shield-lock"></i>
            Account Security
        </span>

        <h1>Change Password</h1>

        <p>
            Update your password to keep your student account secure.
        </p>
    </div>

    <a asp-page="/Student/Profile" class="change-password-back">
        <i class="bi bi-arrow-left"></i>
        <span>Back to Profile</span>
    </a>
</div>

@if (TempData["PasswordChanged"] != null)
{
    <div class="password-success" role="alert">
        <div class="password-message-icon">
            <i class="bi bi-check-circle"></i>
        </div>

        <div>
            <strong>Password changed successfully</strong>

            <p>
                @TempData["PasswordChanged"]
            </p>
        </div>
    </div>
}

<div class="change-password-layout">

    <section class="change-password-card">

        <div class="change-password-card-header">
            <div class="change-password-icon">
                <i class="bi bi-key"></i>
            </div>

            <div>
                <h2>Update Your Password</h2>

                <p>
                    Enter your current password and choose a new one.
                </p>
            </div>
        </div>

        <form method="post" class="change-password-form">

            <div asp-validation-summary="ModelOnly"
                 class="password-validation-summary"
                 role="alert">
            </div>

            <div class="password-field">

                <label asp-for="Input.CurrentPassword">
                    Current Password
                </label>

                <div class="password-input-wrapper">

                    <i class="bi bi-lock password-field-icon"></i>

                    <input asp-for="Input.CurrentPassword"
                           type="password"
                           class="password-input"
                           autocomplete="current-password"
                           placeholder="Enter your current password" />

                    <button type="button"
                            class="password-toggle"
                            data-target="Input_CurrentPassword"
                            aria-label="Show current password">
                        <i class="bi bi-eye"></i>
                    </button>

                </div>

                <span asp-validation-for="Input.CurrentPassword"
                      class="password-field-error">
                </span>

            </div>

            <div class="password-field">

                <label asp-for="Input.NewPassword">
                    New Password
                </label>

                <div class="password-input-wrapper">

                    <i class="bi bi-shield-lock password-field-icon"></i>

                    <input asp-for="Input.NewPassword"
                           type="password"
                           class="password-input"
                           autocomplete="new-password"
                           placeholder="Enter your new password" />

                    <button type="button"
                            class="password-toggle"
                            data-target="Input_NewPassword"
                            aria-label="Show new password">
                        <i class="bi bi-eye"></i>
                    </button>

                </div>

                <span asp-validation-for="Input.NewPassword"
                      class="password-field-error">
                </span>

                <small class="password-help">
                    Your password must contain at least 8 characters.
                </small>

            </div>

            <div class="password-field">

                <label asp-for="Input.ConfirmPassword">
                    Confirm New Password
                </label>

                <div class="password-input-wrapper">

                    <i class="bi bi-check2-circle password-field-icon"></i>

                    <input asp-for="Input.ConfirmPassword"
                           type="password"
                           class="password-input"
                           autocomplete="new-password"
                           placeholder="Confirm your new password" />

                    <button type="button"
                            class="password-toggle"
                            data-target="Input_ConfirmPassword"
                            aria-label="Show new password">
                        <i class="bi bi-eye"></i>
                    </button>

                </div>

                <span asp-validation-for="Input.ConfirmPassword"
                      class="password-field-error">
                </span>

            </div>

            <div class="password-form-actions">

                <a asp-page="/Student/Profile"
                   class="password-cancel-button">
                    Cancel
                </a>

                <button type="submit"
                        class="password-submit-button">
                    <i class="bi bi-shield-check"></i>
                    <span>Change Password</span>
                </button>

            </div>

        </form>

    </section>

    <aside class="password-security-card">

        <div class="security-card-header">

            <div class="security-icon">
                <i class="bi bi-shield-check"></i>
            </div>

            <div>
                <h2>Password Security</h2>

                <p>
                    Keep your account protected.
                </p>
            </div>

        </div>

        <div class="security-list">

            <div class="security-item">

                <span class="security-item-icon">
                    <i class="bi bi-check2"></i>
                </span>

                <div>
                    <strong>Use at least 8 characters</strong>

                    <p>
                        Longer passwords are generally harder to guess.
                    </p>
                </div>

            </div>

            <div class="security-item">

                <span class="security-item-icon">
                    <i class="bi bi-check2"></i>
                </span>

                <div>
                    <strong>Use a unique password</strong>

                    <p>
                        Avoid reusing your university password elsewhere.
                    </p>
                </div>

            </div>

            <div class="security-item">

                <span class="security-item-icon">
                    <i class="bi bi-check2"></i>
                </span>

                <div>
                    <strong>Keep your password private</strong>

                    <p>
                        Never share your password with another person.
                    </p>
                </div>

            </div>

        </div>

        <div class="security-notice">

            <i class="bi bi-info-circle"></i>

            <p>
                After changing your password, use the new password the next time you sign in.
            </p>

        </div>

    </aside>

</div>


</div>

@section Scripts { <partial name="_ValidationScriptsPartial" />


<script>
    document.querySelectorAll(".password-toggle").forEach(function (button) {
        button.addEventListener("click", function () {
            const targetId = button.getAttribute("data-target");
            const input = document.getElementById(targetId);
            const icon = button.querySelector("i");

            if (!input || !icon) {
                return;
            }

            if (input.type === "password") {
                input.type = "text";
                icon.classList.remove("bi-eye");
                icon.classList.add("bi-eye-slash");
                button.setAttribute("aria-label", "Hide password");
            } else {
                input.type = "password";
                icon.classList.remove("bi-eye-slash");
                icon.classList.add("bi-eye");
                button.setAttribute("aria-label", "Show password");
            }
        });
    });
</script>
}
