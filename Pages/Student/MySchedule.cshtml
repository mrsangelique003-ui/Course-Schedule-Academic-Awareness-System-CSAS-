@page
@model CourseScheduleSystem.Web.Pages.Student.MyScheduleModel
@{ ViewData["Title"]="My Schedule"; Layout="~/Pages/Shared/_DashboardLayout.cshtml"; ViewData["Role"]="Student"; ViewData["ActiveNav"]="schedule"; ViewData["UserName"]=User.Identity?.Name??"Student"; }

<div class="dash-welcome">
    <div><h2 class="dash-heading">My Schedule</h2><p class="dash-subheading">@DateTime.Now.ToString("dddd, dd MMMM yyyy") · CIS Department</p></div>
    <div class="dash-welcome-badge" style="background:rgba(21,86,200,.1);color:#1556c8;"><i class="bi bi-calendar-week-fill"></i> Semester 1 · 2026</div>
</div>

<div class="dash-panel">
    <div class="panel-header">
        <span><i class="bi bi-calendar-week-fill me-2"></i>Weekly Timetable — Day Session</span>
        <select class="panel-select" onchange="filterSession(this.value)">
            <option>Day</option><option>Evening</option><option>Weekend</option>
        </select>
    </div>
    <div class="table-responsive">
        <table class="dash-table">
            <thead><tr><th>Day</th><th>Time</th><th>Course</th><th>Code</th><th>Room</th><th>Lecturer</th><th>Status</th></tr></thead>
            <tbody>
                <tr style="background:#f0fdf4;">
                    <td><strong>Monday</strong></td><td>08:00–10:00</td>
                    <td>Software Engineering</td><td><span class="room-badge">CSE301</span></td>
                    <td><span class="room-badge">A204</span></td><td>Dr. J. Mugisha</td>
                    <td><span class="sched-badge badge-ongoing">Ongoing</span></td>
                </tr>
                <tr><td><strong>Tuesday</strong></td><td>10:00–12:00</td><td>Database Systems</td><td><span class="room-badge">CSE305</span></td><td><span class="room-badge">B101</span></td><td>Mrs. A. Byukusenge</td><td><span class="sched-badge badge-upcoming">Upcoming</span></td></tr>
                <tr><td><strong>Wednesday</strong></td><td>13:00–15:00</td><td>Human-Computer Interaction</td><td><span class="room-badge">CSE310</span></td><td><span class="room-badge">A108</span></td><td>Mr. E. Niyonsenga</td><td><span class="sched-badge badge-upcoming">Upcoming</span></td></tr>
                <tr><td><strong>Thursday</strong></td><td>08:00–10:00</td><td>Software Architecture</td><td><span class="room-badge">CSE402</span></td><td><span class="room-badge">C302</span></td><td>Dr. P. Habimana</td><td><span class="sched-badge badge-upcoming">Upcoming</span></td></tr>
                <tr style="background:#f8fafc;"><td><strong>Friday</strong></td><td colspan="5" style="color:#9ca3af;font-style:italic;">No classes scheduled</td><td></td></tr>
            </tbody>
        </table>
    </div>
</div>

<div class="dash-panel mt-4">
    <div class="panel-header"><span><i class="bi bi-geo-alt-fill me-2 text-warning"></i>Room Shift Alerts</span><span class="panel-badge">Today</span></div>
    <div style="padding:1rem 1.25rem;">
        <div style="background:#fff7ed;border:1px solid #fed7aa;border-radius:10px;padding:.85rem 1rem;display:flex;align-items:center;gap:12px;">
            <i class="bi bi-exclamation-triangle-fill" style="color:#ea580c;font-size:20px;flex-shrink:0;"></i>
            <div>
                <div style="font-size:13px;font-weight:700;color:#92400e;">CSE301 · Mon 08:00 — Room Changed</div>
                <div style="font-size:12px;color:#78350f;margin-top:2px;">Room A204 → Lab 01 (Block D). Effective today. Approved by HOD.</div>
            </div>
        </div>
    </div>
</div>
