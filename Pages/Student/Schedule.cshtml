@page
@model CourseScheduleSystem.Web.Pages.Student.ScheduleModel

@using CourseScheduleSystem.Web.Models

@{
ViewData["Title"] = "My Schedule";
ViewData["StudentId"] = Model.CurrentStudent?.RegNo ?? "—";


var today = DateTime.Today.DayOfWeek;

var todaysClasses = Model.ScheduleItems
    .Count(x => x.DayOfWeek == today);

var ongoingCount = Model.TodayScheduleItems
    .Count(x => x.ClassStatus == "Ongoing");

var upcomingCount = Model.TodayScheduleItems
    .Count(x => x.ClassStatus == "Upcoming");

var completedCount = Model.TodayScheduleItems
    .Count(x => x.ClassStatus == "Completed");


}

<link rel="stylesheet"
      href="~/css/Student/Schedule.css"
      asp-append-version="true" />

<div class="schedule-page">


<!-- =====================================================
     PAGE HEADER
     ===================================================== -->

<section class="schedule-header">

    <div class="schedule-header-content">

        <div>

            <span class="page-eyebrow">
                <i class="bi bi-calendar3" aria-hidden="true"></i>
                Academic Schedule
            </span>

            <h1>
                My Schedule
            </h1>

            <p>
                View your scheduled classes, lecturers, rooms, and study sessions.
            </p>

        </div>

        <div class="student-badge">

            <span class="student-badge-icon">
                <i class="bi bi-person" aria-hidden="true"></i>
            </span>

            <div>

                <span class="student-badge-label">
                    Student
                </span>

                <strong>
                    @(Model.CurrentStudent?.RegNo ?? "—")
                </strong>

            </div>

        </div>

    </div>

</section>


<!-- =====================================================
     SCHEDULE STATISTICS
     ===================================================== -->

<section class="schedule-stats">

    <div class="schedule-stat-card">

        <div class="schedule-stat-icon">
            <i class="bi bi-calendar-check"
               aria-hidden="true"></i>
        </div>

        <div class="schedule-stat-content">

            <span>
                Total Classes
            </span>

            <strong>
                @Model.TotalClasses
            </strong>

        </div>

    </div>


    <div class="schedule-stat-card">

        <div class="schedule-stat-icon">
            <i class="bi bi-journal-bookmark"
               aria-hidden="true"></i>
        </div>

        <div class="schedule-stat-content">

            <span>
                Enrolled Courses
            </span>

            <strong>
                @Model.TotalCourses
            </strong>

        </div>

    </div>


    <div class="schedule-stat-card">

        <div class="schedule-stat-icon">
            <i class="bi bi-broadcast-pin"
               aria-hidden="true"></i>
        </div>

        <div class="schedule-stat-content">

            <span>
                Ongoing Today
            </span>

            <strong>
                @ongoingCount
            </strong>

        </div>

    </div>


    <div class="schedule-stat-card">

        <div class="schedule-stat-icon">
            <i class="bi bi-calendar-day"
               aria-hidden="true"></i>
        </div>

        <div class="schedule-stat-content">

            <span>
                Today's Classes
            </span>

            <strong>
                @todaysClasses
            </strong>

        </div>

    </div>

</section>


<!-- =====================================================
     TODAY'S CLASS MONITOR
     ===================================================== -->

<section class="today-schedule-panel">

    <div class="today-schedule-header">

        <div>

            <span class="section-eyebrow">
                TODAY'S SCHEDULE
            </span>

            <h2>
                Today's Classes
            </h2>

            <p>
                @Model.Today.ToString("dddd, dd MMMM yyyy")
            </p>

        </div>

        <div class="live-clock">

            <span>
                Current Time
            </span>

            <strong id="studentScheduleClock">
                @Model.CurrentTime.ToString("hh:mm tt")
            </strong>

        </div>

    </div>


    <!-- =================================================
         TODAY STATUS SUMMARY
         ================================================= -->

    <div class="today-status-summary">

        <div class="today-status-item ongoing">

            <span class="today-status-dot"></span>

            <div>

                <strong>
                    @ongoingCount
                </strong>

                <span>
                    Ongoing
                </span>

            </div>

        </div>


        <div class="today-status-item upcoming">

            <span class="today-status-dot"></span>

            <div>

                <strong>
                    @upcomingCount
                </strong>

                <span>
                    Upcoming
                </span>

            </div>

        </div>


        <div class="today-status-item completed">

            <span class="today-status-dot"></span>

            <div>

                <strong>
                    @completedCount
                </strong>

                <span>
                    Completed
                </span>

            </div>

        </div>

    </div>


    <!-- =================================================
         ONGOING
         ================================================= -->

    <div class="today-class-section">

        <div class="today-section-heading">

            <div class="today-section-title">

                <span class="today-section-icon ongoing">
                    <i class="bi bi-broadcast-pin"
                       aria-hidden="true"></i>
                </span>

                <div>

                    <h3>
                        Ongoing
                    </h3>

                    <p>
                        Classes currently in progress
                    </p>

                </div>

            </div>

            <span class="today-section-count">
                @ongoingCount
            </span>

        </div>


        @if (Model.OngoingClasses.Any())
        {
            <div class="today-class-list">

                @foreach (var item in Model.OngoingClasses)
                {
                    <article class="today-class-card ongoing-card">

                        <div class="today-class-time">

                            <strong>
                                @item.StartTime.ToString("hh:mm")
                            </strong>

                            <span>
                                @item.StartTime.ToString("tt")
                            </span>

                            <div class="today-time-line"></div>

                            <strong>
                                @item.EndTime.ToString("hh:mm")
                            </strong>

                            <span>
                                @item.EndTime.ToString("tt")
                            </span>

                        </div>


                        <div class="today-class-information">

                            <div class="today-course-topline">

                                <span class="today-course-code">
                                    @item.CourseCode
                                </span>

                                <span class="today-live-badge">

                                    <span></span>

                                    LIVE NOW

                                </span>

                            </div>

                            <h4>
                                @item.CourseName
                            </h4>

                            <div class="today-class-details">

                                <span>
                                    <i class="bi bi-person-badge"
                                       aria-hidden="true"></i>

                                    @item.LecturerName
                                </span>

                                <span>
                                    <i class="bi bi-geo-alt"
                                       aria-hidden="true"></i>

                                    @item.Building
                                    @if (!string.IsNullOrWhiteSpace(item.RoomNumber))
                                    {
                                        <span>
                                            · @item.RoomNumber
                                        </span>
                                    }
                                </span>

                                <span>
                                    <i class="bi bi-clock"
                                       aria-hidden="true"></i>

                                    @item.StudySession
                                </span>

                            </div>

                        </div>

                        <div class="today-class-status ongoing">

                            <i class="bi bi-broadcast-pin"
                               aria-hidden="true"></i>

                            Ongoing

                        </div>

                    </article>
                }

            </div>
        }
        else
        {
            <div class="today-empty-state">

                <div class="today-empty-icon">
                    <i class="bi bi-broadcast"
                       aria-hidden="true"></i>
                </div>

                <div>

                    <strong>
                        No class is currently ongoing
                    </strong>

                    <span>
                        Your current schedule has no class in progress.
                    </span>

                </div>

            </div>
        }

    </div>


    <!-- =================================================
         UPCOMING
         ================================================= -->

    <div class="today-class-section">

        <div class="today-section-heading">

            <div class="today-section-title">

                <span class="today-section-icon upcoming">
                    <i class="bi bi-clock"
                       aria-hidden="true"></i>
                </span>

                <div>

                    <h3>
                        Upcoming
                    </h3>

                    <p>
                        Classes scheduled later today
                    </p>

                </div>

            </div>

            <span class="today-section-count">
                @upcomingCount
            </span>

        </div>


        @if (Model.UpcomingClasses.Any())
        {
            <div class="today-class-list">

                @foreach (var item in Model.UpcomingClasses)
                {
                    <article class="today-class-card upcoming-card">

                        <div class="today-class-time">

                            <strong>
                                @item.StartTime.ToString("hh:mm")
                            </strong>

                            <span>
                                @item.StartTime.ToString("tt")
                            </span>

                            <div class="today-time-line"></div>

                            <strong>
                                @item.EndTime.ToString("hh:mm")
                            </strong>

                            <span>
                                @item.EndTime.ToString("tt")
                            </span>

                        </div>


                        <div class="today-class-information">

                            <div class="today-course-topline">

                                <span class="today-course-code">
                                    @item.CourseCode
                                </span>

                                <span class="today-upcoming-badge">
                                    UPCOMING
                                </span>

                            </div>

                            <h4>
                                @item.CourseName
                            </h4>

                            <div class="today-class-details">

                                <span>
                                    <i class="bi bi-person-badge"
                                       aria-hidden="true"></i>

                                    @item.LecturerName
                                </span>

                                <span>
                                    <i class="bi bi-geo-alt"
                                       aria-hidden="true"></i>

                                    @item.Building
                                    @if (!string.IsNullOrWhiteSpace(item.RoomNumber))
                                    {
                                        <span>
                                            · @item.RoomNumber
                                        </span>
                                    }
                                </span>

                                <span>
                                    <i class="bi bi-clock"
                                       aria-hidden="true"></i>

                                    @item.StudySession
                                </span>

                            </div>

                        </div>

                        <div class="today-class-status upcoming">

                            <i class="bi bi-clock"
                               aria-hidden="true"></i>

                            Upcoming

                        </div>

                    </article>
                }

            </div>
        }
        else
        {
            <div class="today-empty-state">

                <div class="today-empty-icon">
                    <i class="bi bi-calendar-check"
                       aria-hidden="true"></i>
                </div>

                <div>

                    <strong>
                        No upcoming classes
                    </strong>

                    <span>
                        You have no more classes scheduled for today.
                    </span>

                </div>

            </div>
        }

    </div>


    <!-- =================================================
         COMPLETED
         ================================================= -->

    <div class="today-class-section">

        <div class="today-section-heading">

            <div class="today-section-title">

                <span class="today-section-icon completed">
                    <i class="bi bi-check2-circle"
                       aria-hidden="true"></i>
                </span>

                <div>

                    <h3>
                        Completed
                    </h3>

                    <p>
                        Classes that have already finished today
                    </p>

                </div>

            </div>

            <span class="today-section-count">
                @completedCount
            </span>

        </div>


        @if (Model.CompletedClasses.Any())
        {
            <div class="today-class-list">

                @foreach (var item in Model.CompletedClasses)
                {
                    <article class="today-class-card completed-card">

                        <div class="today-class-time">

                            <strong>
                                @item.StartTime.ToString("hh:mm")
                            </strong>

                            <span>
                                @item.StartTime.ToString("tt")
                            </span>

                            <div class="today-time-line"></div>

                            <strong>
                                @item.EndTime.ToString("hh:mm")
                            </strong>

                            <span>
                                @item.EndTime.ToString("tt")
                            </span>

                        </div>


                        <div class="today-class-information">

                            <div class="today-course-topline">

                                <span class="today-course-code">
                                    @item.CourseCode
                                </span>

                                <span class="today-completed-badge">

                                    <i class="bi bi-check2"
                                       aria-hidden="true"></i>

                                    COMPLETED

                                </span>

                            </div>

                            <h4>
                                @item.CourseName
                            </h4>

                            <div class="today-class-details">

                                <span>
                                    <i class="bi bi-person-badge"
                                       aria-hidden="true"></i>

                                    @item.LecturerName
                                </span>

                                <span>
                                    <i class="bi bi-geo-alt"
                                       aria-hidden="true"></i>

                                    @item.Building
                                    @if (!string.IsNullOrWhiteSpace(item.RoomNumber))
                                    {
                                        <span>
                                            · @item.RoomNumber
                                        </span>
                                    }
                                </span>

                                <span>
                                    <i class="bi bi-clock"
                                       aria-hidden="true"></i>

                                    @item.StudySession
                                </span>

                            </div>

                        </div>

                        <div class="today-class-status completed">

                            <i class="bi bi-check-circle-fill"
                               aria-hidden="true"></i>

                            Completed

                        </div>

                    </article>
                }

            </div>
        }
        else
        {
            <div class="today-empty-state">

                <div class="today-empty-icon">
                    <i class="bi bi-check2-circle"
                       aria-hidden="true"></i>
                </div>

                <div>

                    <strong>
                        No completed classes
                    </strong>

                    <span>
                        No scheduled class has finished yet today.
                    </span>

                </div>

            </div>
        }

    </div>

</section>


<!-- =====================================================
     WEEKLY SCHEDULE
     ===================================================== -->

@if (Model.ScheduleItems.Any())
{
    <section class="schedule-panel">

        <div class="schedule-panel-header">

            <div>

                <span class="section-eyebrow">
                    WEEKLY TIMETABLE
                </span>

                <h2>
                    Class Schedule
                </h2>

            </div>

            <span class="class-count">

                @Model.TotalClasses

                @(Model.TotalClasses == 1
                    ? "Class"
                    : "Classes")

            </span>

        </div>


        <div class="schedule-list">

            @foreach (var dayGroup in Model.ScheduleItems
                .GroupBy(x => x.DayOfWeek)
                .OrderBy(x => x.Key))
            {
                <div class="schedule-day">

                    <div class="schedule-day-header">

                        <div class="day-icon">

                            <i class="bi bi-calendar-day"
                               aria-hidden="true"></i>

                        </div>

                        <div>

                            <span>
                                Day
                            </span>

                            <h3>
                                @dayGroup.Key
                            </h3>

                        </div>

                        <span class="day-class-count">

                            @dayGroup.Count()

                            @(dayGroup.Count() == 1
                                ? "class"
                                : "classes")

                        </span>

                    </div>


                    <div class="schedule-day-items">

                        @foreach (var item in dayGroup.OrderBy(x => x.StartTime))
                        {
                            <article class="schedule-card">

                                <div class="schedule-time">

                                    <strong>
                                        @item.StartTime.ToString("hh\\:mm")
                                    </strong>

                                    <span>
                                        @item.StartTime.ToString("tt")
                                    </span>

                                    <div class="time-line"></div>

                                    <strong>
                                        @item.EndTime.ToString("hh\\:mm")
                                    </strong>

                                    <span>
                                        @item.EndTime.ToString("tt")
                                    </span>

                                </div>


                                <div class="schedule-course">

                                    <div class="course-topline">

                                        <span class="course-code">
                                            @item.CourseCode
                                        </span>

                                        <span class="session-badge">

                                            <i class="bi bi-clock"
                                               aria-hidden="true"></i>

                                            @item.StudySession

                                        </span>

                                    </div>


                                    <h3>
                                        @item.CourseName
                                    </h3>


                                    <div class="schedule-details">

                                        <div class="schedule-detail">

                                            <i class="bi bi-person-badge"
                                               aria-hidden="true"></i>

                                            <div>

                                                <span>
                                                    Lecturer
                                                </span>

                                                <strong>
                                                    @item.LecturerName
                                                </strong>

                                            </div>

                                        </div>


                                        <div class="schedule-detail">

                                            <i class="bi bi-geo-alt"
                                               aria-hidden="true"></i>

                                            <div>

                                                <span>
                                                    Room
                                                </span>

                                                <strong>

                                                    @item.Building

                                                    @if (!string.IsNullOrWhiteSpace(item.RoomNumber))
                                                    {
                                                        <span>
                                                            · @item.RoomNumber
                                                        </span>
                                                    }

                                                </strong>

                                            </div>

                                        </div>

                                    </div>


                                    @if (!string.IsNullOrWhiteSpace(item.Notes))
                                    {
                                        <div class="schedule-notes">

                                            <i class="bi bi-info-circle"
                                               aria-hidden="true"></i>

                                            <span>
                                                @item.Notes
                                            </span>

                                        </div>
                                    }

                                </div>


                                <div class="schedule-status">

                                    <span>

                                        <i class="bi bi-check-circle-fill"
                                           aria-hidden="true"></i>

                                        @item.Status

                                    </span>

                                </div>

                            </article>
                        }

                    </div>

                </div>
            }

        </div>

    </section>
}
else
{
    <section class="schedule-empty">

        <div class="empty-icon">

            <i class="bi bi-calendar-x"
               aria-hidden="true"></i>

        </div>

        <h2>
            No Classes Scheduled
        </h2>

        @if (Model.TotalCourses == 0)
        {
            <p>
                You currently have no enrolled courses with a class schedule.
            </p>
        }
        else
        {
            <p>
                Your enrolled courses do not have any active scheduled
                classes yet.
            </p>
        }

        <a asp-page="/Student/MyCourses"
           class="empty-action">

            <i class="bi bi-journal-bookmark"
               aria-hidden="true"></i>

            View My Courses

        </a>

    </section>
}


<!-- =====================================================
     INFORMATION
     ===================================================== -->

<section class="schedule-information">

    <div class="information-icon">

        <i class="bi bi-lightbulb"
           aria-hidden="true"></i>

    </div>

    <div>

        <h3>
            Schedule Information
        </h3>

        <p>
            This timetable displays active classes for your enrolled
            courses. The Today's Classes section automatically identifies
            ongoing, upcoming, and completed classes based on the current
            day and time.
        </p>

    </div>

</section>


</div>

@section Scripts {

<script>
    document.addEventListener("DOMContentLoaded", function () {

        const clock =
            document.getElementById("studentScheduleClock");

        function updateClock() {

            if (!clock) {
                return;
            }

            const now = new Date();

            let hours = now.getHours();

            const minutes =
                String(now.getMinutes()).padStart(2, "0");

            const seconds =
                String(now.getSeconds()).padStart(2, "0");

            const period =
                hours >= 12 ? "PM" : "AM";

            hours =
                hours % 12 || 12;

            clock.textContent =
                `${String(hours).padStart(2, "0")}:${minutes}:${seconds} ${period}`;
        }

        updateClock();

        setInterval(updateClock, 1000);

    });
</script>

}
