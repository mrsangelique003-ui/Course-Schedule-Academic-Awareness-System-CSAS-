@page
@model CourseScheduleSystem.Web.Pages.Student.ProfileModel
@{ ViewData["Title"]="My Profile"; Layout="~/Pages/Shared/_DashboardLayout.cshtml"; ViewData["Role"]="Student"; ViewData["ActiveNav"]="profile"; ViewData["UserName"]=User.Identity?.Name??"Student"; string uname=User.Identity?.Name??"Student"; }

<div class="dash-welcome">
    <div><h2 class="dash-heading">My Profile</h2><p class="dash-subheading">Manage your personal and academic information</p></div>
</div>

<div style="display:grid;grid-template-columns:320px 1fr;gap:1.5rem;align-items:start;">
    <!-- Avatar card -->
    <div class="dash-panel">
        <div style="padding:2rem 1.5rem;text-align:center;">
            <div style="width:80px;height:80px;border-radius:50%;background:#1556c8;display:flex;align-items:center;justify-content:center;font-size:32px;font-weight:800;color:#fff;margin:0 auto 1rem;">
                @(uname.Length>0?uname[0].ToString().ToUpper():"S")
            </div>
            <div style="font-size:17px;font-weight:800;color:#142d4d;">@uname</div>
            <div style="font-size:12px;color:#6c8097;margin-top:3px;">Student · CIS Department</div>
            <div style="margin-top:1rem;padding:.5rem;background:#eff6ff;border-radius:8px;font-size:12px;font-weight:700;color:#1556c8;">
                <i class="bi bi-mortarboard-fill me-1"></i>Year 3 · Day Session
            </div>
        </div>
    </div>
    <!-- Details form -->
    <div class="dash-panel">
        <div class="panel-header"><span><i class="bi bi-person-circle me-2"></i>Profile Details</span>
            <button class="btn-dash-primary" style="font-size:11px;padding:4px 12px;" onclick="saveProfile()"><i class="bi bi-check-lg me-1"></i>Save Changes</button>
        </div>
        <div style="padding:1.25rem;display:grid;grid-template-columns:1fr 1fr;gap:1rem;">
            <div><label class="form-label fw-semibold" style="font-size:12px;">Full Name</label><input type="text" class="form-control" value="@uname" /></div>
            <div><label class="form-label fw-semibold" style="font-size:12px;">Reg. Number</label><input type="text" class="form-control" value="STU001" readonly style="background:#f8fafc;" /></div>
            <div><label class="form-label fw-semibold" style="font-size:12px;">Email</label><input type="email" class="form-control" value="stu001@student.unilak.ac.rw" /></div>
            <div><label class="form-label fw-semibold" style="font-size:12px;">Phone</label><input type="tel" class="form-control" placeholder="+250 7XX XXX XXX" /></div>
            <div><label class="form-label fw-semibold" style="font-size:12px;">Department</label><input type="text" class="form-control" value="Computer Information Systems (CIS)" readonly style="background:#f8fafc;" /></div>
            <div><label class="form-label fw-semibold" style="font-size:12px;">Study Session</label>
                <select class="form-select"><option selected>Day</option><option>Evening</option><option>Weekend</option></select>
            </div>
            <div><label class="form-label fw-semibold" style="font-size:12px;">Academic Year</label>
                <select class="form-select"><option>Year 1</option><option>Year 2</option><option selected>Year 3</option><option>Year 4</option></select>
            </div>
            <div><label class="form-label fw-semibold" style="font-size:12px;">Intake</label><input type="text" class="form-control" value="2023 — Semester 1" /></div>
        </div>
        <div style="padding:0 1.25rem 1rem;border-top:1px solid #e2e8f0;padding-top:1rem;">
            <div style="font-size:12px;font-weight:800;color:#6c8097;text-transform:uppercase;letter-spacing:.07em;margin-bottom:.75rem;">Change Password</div>
            <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:1rem;">
                <div><label class="form-label fw-semibold" style="font-size:12px;">Current Password</label><input type="password" class="form-control" placeholder="Current password" /></div>
                <div><label class="form-label fw-semibold" style="font-size:12px;">New Password</label><input type="password" class="form-control" placeholder="New password" /></div>
                <div><label class="form-label fw-semibold" style="font-size:12px;">Confirm Password</label><input type="password" class="form-control" placeholder="Confirm password" /></div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
function saveProfile(){
    var t=document.createElement('div');
    t.style.cssText='position:fixed;bottom:6rem;right:2rem;background:#059669;color:#fff;padding:.75rem 1.25rem;border-radius:10px;font-weight:700;font-size:13px;z-index:99999;box-shadow:0 8px 25px rgba(0,0,0,.2);';
    t.innerHTML='<i class="bi bi-check-circle-fill me-2"></i>Profile saved successfully!';
    document.body.appendChild(t);
    setTimeout(function(){t.remove();},3000);
}
</script>
}
