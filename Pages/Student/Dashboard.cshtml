@page
@model CourseScheduleSystem.Web.Pages.Student.DashboardModel
@{
    ViewData["Title"] = "Student Dashboard";
    Layout = "~/Pages/Shared/_DashboardLayout.cshtml";
    ViewData["ActiveNav"] = "home";
    ViewData["Role"] = "Student";
    ViewData["UserName"] = User.Identity?.Name ?? "Student";
}

<!-- ── WELCOME BAR ──────────────────────────────────────────────────── -->
<div class="dash-welcome">
    <div>
        <h2 class="dash-heading">Good morning, @ViewData["UserName"] 👋</h2>
        <p class="dash-subheading">Here's your academic overview for today — @DateTime.Now.ToString("dddd, dd MMMM yyyy")</p>
    </div>
    <div class="dash-welcome-badge">
        <i class="bi bi-mortarboard-fill"></i> Student · CIS Department
    </div>
</div>

<!-- ── STAT CARDS ───────────────────────────────────────────────────── -->
<div class="dash-stats">
    <div class="stat-card stat-blue">
        <div class="stat-icon"><i class="bi bi-calendar3"></i></div>
        <div class="stat-info"><span class="stat-val">4</span><span class="stat-label">Classes Today</span></div>
    </div>
    <div class="stat-card stat-green">
        <div class="stat-icon"><i class="bi bi-book-fill"></i></div>
        <div class="stat-info"><span class="stat-val">6</span><span class="stat-label">Enrolled Courses</span></div>
    </div>
    <div class="stat-card stat-orange">
        <div class="stat-icon"><i class="bi bi-alarm-fill"></i></div>
        <div class="stat-info"><span class="stat-val">2</span><span class="stat-label">Deadlines Soon</span></div>
    </div>
    <div class="stat-card stat-red">
        <div class="stat-icon"><i class="bi bi-bell-fill"></i></div>
        <div class="stat-info"><span class="stat-val">5</span><span class="stat-label">Unread Notifications</span></div>
    </div>
</div>

<!-- ── MAIN GRID ─────────────────────────────────────────────────────── -->
<div class="dash-grid">

    <!-- TODAY'S SCHEDULE -->
    <div class="dash-panel">
        <div class="panel-header">
            <span><i class="bi bi-calendar-week-fill me-2"></i>Today's Schedule</span>
            <span class="panel-badge">Monday</span>
        </div>
        <div class="schedule-list">
            <div class="schedule-item">
                <div class="sched-time"><span>08:00</span><span class="sched-end">10:00</span></div>
                <div class="sched-bar bar-blue"></div>
                <div class="sched-info">
                    <div class="sched-course">Software Engineering</div>
                    <div class="sched-meta"><i class="bi bi-geo-alt"></i> Block A — Room A204 &nbsp;|&nbsp; <i class="bi bi-person"></i> Dr. J. Mugisha</div>
                </div>
                <span class="sched-badge badge-ongoing">Ongoing</span>
            </div>
            <div class="schedule-item">
                <div class="sched-time"><span>10:00</span><span class="sched-end">12:00</span></div>
                <div class="sched-bar bar-purple"></div>
                <div class="sched-info">
                    <div class="sched-course">Database Systems</div>
                    <div class="sched-meta"><i class="bi bi-geo-alt"></i> Block B — Room B101 &nbsp;|&nbsp; <i class="bi bi-person"></i> Mrs. A. Byukusenge</div>
                </div>
                <span class="sched-badge badge-upcoming">Upcoming</span>
            </div>
            <div class="schedule-item">
                <div class="sched-time"><span>13:00</span><span class="sched-end">15:00</span></div>
                <div class="sched-bar bar-green"></div>
                <div class="sched-info">
                    <div class="sched-course">Human-Computer Interaction</div>
                    <div class="sched-meta"><i class="bi bi-geo-alt"></i> Block A — Room A108 &nbsp;|&nbsp; <i class="bi bi-person"></i> Mr. E. Niyonsenga</div>
                </div>
                <span class="sched-badge badge-upcoming">Upcoming</span>
            </div>
        </div>
    </div>

    <!-- NOTIFICATIONS -->
    <div class="dash-panel">
        <div class="panel-header">
            <span><i class="bi bi-bell-fill me-2"></i>Notifications</span>
            <a href="#" class="panel-link">Mark all read</a>
        </div>
        <div class="notif-list">
            <div class="notif-item notif-unread">
                <div class="notif-icon notif-orange"><i class="bi bi-geo-alt-fill"></i></div>
                <div class="notif-body">
                    <div class="notif-title">Room Shift — CSE301</div>
                    <div class="notif-text">Software Engineering moved from A204 → Lab 01 today.</div>
                    <div class="notif-time">5 minutes ago</div>
                </div>
            </div>
            <div class="notif-item notif-unread">
                <div class="notif-icon notif-red"><i class="bi bi-alarm-fill"></i></div>
                <div class="notif-body">
                    <div class="notif-title">Registration Deadline</div>
                    <div class="notif-text">CSE402 — Software Architecture closes in 2 days.</div>
                    <div class="notif-time">2 hours ago</div>
                </div>
            </div>
            <div class="notif-item">
                <div class="notif-icon notif-blue"><i class="bi bi-megaphone-fill"></i></div>
                <div class="notif-body">
                    <div class="notif-title">CP Announcement — CSE305</div>
                    <div class="notif-text">Tomorrow's class starts 30 min early. Bring your laptops.</div>
                    <div class="notif-time">Yesterday</div>
                </div>
            </div>
            <div class="notif-item">
                <div class="notif-icon notif-green"><i class="bi bi-check-circle-fill"></i></div>
                <div class="notif-body">
                    <div class="notif-title">Enrollment Confirmed</div>
                    <div class="notif-text">You are successfully enrolled in CSE310 HCI.</div>
                    <div class="notif-time">3 days ago</div>
                </div>
            </div>
        </div>
    </div>

</div>

<!-- ── ENROLLED COURSES ───────────────────────────────────────────── -->
<div class="dash-panel mt-4">
    <div class="panel-header">
        <span><i class="bi bi-collection-fill me-2"></i>Enrolled Courses</span>
        <span class="panel-badge">Semester 1 · 2026</span>
    </div>
    <div class="courses-grid">
        <div class="course-card">
            <div class="course-code">CSE301</div>
            <div class="course-name">Software Engineering</div>
            <div class="course-meta"><i class="bi bi-person-fill"></i> Dr. J. Mugisha</div>
            <div class="course-meta"><i class="bi bi-calendar3"></i> Mon 08:00–10:00 · A204</div>
            <div class="course-footer">
                <span class="course-status status-open">Open</span>
                <div class="course-actions">
                    <a href="https://chat.whatsapp.com/example1" target="_blank" class="btn-wa"><i class="bi bi-whatsapp"></i> WhatsApp</a>
                </div>
            </div>
            <div class="cp-info"><i class="bi bi-person-badge-fill"></i> CP: Bob N. — <a href="#">Contact</a></div>
        </div>
        <div class="course-card">
            <div class="course-code">CSE305</div>
            <div class="course-name">Database Systems</div>
            <div class="course-meta"><i class="bi bi-person-fill"></i> Mrs. A. Byukusenge</div>
            <div class="course-meta"><i class="bi bi-calendar3"></i> Tue 10:00–12:00 · B101</div>
            <div class="course-footer">
                <span class="course-status status-open">Open</span>
                <div class="course-actions">
                    <a href="https://chat.whatsapp.com/example2" target="_blank" class="btn-wa"><i class="bi bi-whatsapp"></i> WhatsApp</a>
                </div>
            </div>
            <div class="cp-info"><i class="bi bi-person-badge-fill"></i> CP: Alice U. — <a href="#">Contact</a></div>
        </div>
        <div class="course-card">
            <div class="course-code">CSE310</div>
            <div class="course-name">Human-Computer Interaction</div>
            <div class="course-meta"><i class="bi bi-person-fill"></i> Mr. E. Niyonsenga</div>
            <div class="course-meta"><i class="bi bi-calendar3"></i> Wed 13:00–15:00 · A108</div>
            <div class="course-footer">
                <span class="course-status status-open">Open</span>
                <div class="course-actions">
                    <a href="https://chat.whatsapp.com/example3" target="_blank" class="btn-wa"><i class="bi bi-whatsapp"></i> WhatsApp</a>
                </div>
            </div>
            <div class="cp-info"><i class="bi bi-person-badge-fill"></i> CP: John K. — <a href="#">Contact</a></div>
        </div>
        <div class="course-card course-card-deadline">
            <div class="course-code">CSE402</div>
            <div class="course-name">Software Architecture</div>
            <div class="course-meta"><i class="bi bi-person-fill"></i> Dr. P. Habimana</div>
            <div class="course-meta"><i class="bi bi-calendar3"></i> Thu 08:00–10:00 · C302</div>
            <div class="course-footer">
                <span class="course-status status-closing">Closing Soon</span>
                <div class="course-actions">
                    <a href="https://chat.whatsapp.com/example4" target="_blank" class="btn-wa"><i class="bi bi-whatsapp"></i> WhatsApp</a>
                </div>
            </div>
            <div class="cp-info"><i class="bi bi-alarm-fill text-warning"></i> Registration closes Sept 04</div>
        </div>
    </div>
</div>

<!-- ═══════════════════════════════════════════════════════════════════
     DEFENSE & GRADUATION SECTION — Finalist Students (Year 4)
══════════════════════════════════════════════════════════════════════ -->
<div class="dash-panel mt-4" id="finalistSection">
    <div class="panel-header" style="background:linear-gradient(135deg,#153f83,#1556c8);color:#fff;border-radius:13px 13px 0 0;">
        <span style="display:flex;align-items:center;gap:10px;">
            <span style="width:36px;height:36px;background:rgba(255,255,255,.15);border-radius:50%;
                         display:flex;align-items:center;justify-content:center;font-size:18px;">
                🎓
            </span>
            <div>
                <div style="font-size:14px;font-weight:800;">Finalist Corner — Year 4</div>
                <div style="font-size:11px;opacity:.75;font-weight:400;">Defense schedules, graduation requirements &amp; final year info</div>
            </div>
        </span>
        <span style="background:rgba(255,255,255,.2);border-radius:20px;font-size:11px;font-weight:700;padding:4px 12px;">
            2025/2026 Cohort
        </span>
    </div>

    <!-- Quick Info Cards -->
    <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:1rem;padding:1.25rem 1.25rem .5rem;">
        <div style="background:#eff6ff;border:1px solid #bfdbfe;border-radius:12px;padding:1rem;text-align:center;">
            <div style="font-size:22px;margin-bottom:6px;">📋</div>
            <div style="font-size:20px;font-weight:800;color:#1556c8;">Oct 15</div>
            <div style="font-size:11px;color:#6c8097;">Project Submission</div>
        </div>
        <div style="background:#ecfdf5;border:1px solid #bbf7d0;border-radius:12px;padding:1rem;text-align:center;">
            <div style="font-size:22px;margin-bottom:6px;">🗣️</div>
            <div style="font-size:20px;font-weight:800;color:#059669;">Nov 10</div>
            <div style="font-size:11px;color:#6c8097;">Defense Period Starts</div>
        </div>
        <div style="background:#fef9c3;border:1px solid #fde68a;border-radius:12px;padding:1rem;text-align:center;">
            <div style="font-size:22px;margin-bottom:6px;">🎖️</div>
            <div style="font-size:20px;font-weight:800;color:#a16207;">Dec 5</div>
            <div style="font-size:11px;color:#6c8097;">Results Released</div>
        </div>
        <div style="background:#fdf4ff;border:1px solid #e9d5ff;border-radius:12px;padding:1rem;text-align:center;">
            <div style="font-size:22px;margin-bottom:6px;">🎓</div>
            <div style="font-size:20px;font-weight:800;color:#7c3aed;">Jan 2027</div>
            <div style="font-size:11px;color:#6c8097;">Graduation Ceremony</div>
        </div>
    </div>

    <div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem;padding:.5rem 1.25rem 1.25rem;">

        <!-- Defense Schedule -->
        <div>
            <div style="font-size:13px;font-weight:800;color:#142d4d;margin-bottom:.75rem;
                        display:flex;align-items:center;gap:7px;">
                <i class="bi bi-calendar-event-fill" style="color:#1556c8;"></i> My Defense Schedule
            </div>
            <div style="border:1px solid #e2e8f0;border-radius:10px;overflow:hidden;">
                <div style="background:#f8fafc;padding:.6rem 1rem;font-size:11px;font-weight:700;
                            color:#6c8097;display:grid;grid-template-columns:1fr 1fr 1fr;">
                    <span>Date</span><span>Time</span><span>Room</span>
                </div>
                <div style="padding:.75rem 1rem;display:grid;grid-template-columns:1fr 1fr 1fr;
                            font-size:13px;border-top:1px solid #e2e8f0;align-items:center;">
                    <span style="font-weight:700;color:#142d4d;">Nov 12, 2026</span>
                    <span style="color:#1556c8;font-weight:600;">09:00 – 10:00</span>
                    <span><span class="room-badge">Lab 01</span></span>
                </div>
                <div style="padding:.75rem 1rem;font-size:12px;color:#6c8097;
                            border-top:1px solid #e2e8f0;background:#fafafa;">
                    <i class="bi bi-people-fill me-1"></i>
                    <strong>Panel:</strong> Dr. J. Mugisha (Chair) · Mrs. A. Byukusenge · Mr. E. Niyonsenga
                </div>
            </div>
            <div style="margin-top:.75rem;padding:.65rem .9rem;background:#fef9c3;
                        border:1px solid #fde68a;border-radius:9px;font-size:12px;color:#92400e;">
                <i class="bi bi-exclamation-triangle-fill me-1"></i>
                <strong>Reminder:</strong> Submit final project soft copy to HOD office by <strong>Oct 15, 2026</strong>.
            </div>
        </div>

        <!-- Graduation Requirements Checklist -->
        <div>
            <div style="font-size:13px;font-weight:800;color:#142d4d;margin-bottom:.75rem;
                        display:flex;align-items:center;gap:7px;">
                <i class="bi bi-list-check" style="color:#059669;"></i> Graduation Requirements
            </div>
            <div style="display:flex;flex-direction:column;gap:.5rem;">
                <div style="display:flex;align-items:center;gap:10px;padding:.6rem .85rem;
                            background:#ecfdf5;border:1px solid #bbf7d0;border-radius:9px;">
                    <i class="bi bi-check-circle-fill" style="color:#15803d;font-size:15px;"></i>
                    <span style="font-size:13px;font-weight:600;color:#14532d;">All courses passed (CGS ≥ 50%)</span>
                </div>
                <div style="display:flex;align-items:center;gap:10px;padding:.6rem .85rem;
                            background:#ecfdf5;border:1px solid #bbf7d0;border-radius:9px;">
                    <i class="bi bi-check-circle-fill" style="color:#15803d;font-size:15px;"></i>
                    <span style="font-size:13px;font-weight:600;color:#14532d;">Final Year Project submitted</span>
                </div>
                <div style="display:flex;align-items:center;gap:10px;padding:.6rem .85rem;
                            background:#fef9c3;border:1px solid #fde68a;border-radius:9px;">
                    <i class="bi bi-hourglass-split" style="color:#a16207;font-size:15px;"></i>
                    <span style="font-size:13px;font-weight:600;color:#a16207;">Project defense — Pending</span>
                </div>
                <div style="display:flex;align-items:center;gap:10px;padding:.6rem .85rem;
                            background:#fef2f2;border:1px solid #fecaca;border-radius:9px;">
                    <i class="bi bi-x-circle-fill" style="color:#dc2626;font-size:15px;"></i>
                    <span style="font-size:13px;font-weight:600;color:#dc2626;">Clearance form — Not submitted</span>
                </div>
                <div style="display:flex;align-items:center;gap:10px;padding:.6rem .85rem;
                            background:#fef2f2;border:1px solid #fecaca;border-radius:9px;">
                    <i class="bi bi-x-circle-fill" style="color:#dc2626;font-size:15px;"></i>
                    <span style="font-size:13px;font-weight:600;color:#dc2626;">Library clearance — Not done</span>
                </div>
                <a href="https://umurongosmart.com" target="_blank"
                   style="display:flex;align-items:center;justify-content:center;gap:7px;
                          background:#142d4d;color:#fff;text-decoration:none;
                          border-radius:9px;padding:.6rem;font-size:13px;font-weight:700;
                          margin-top:.25rem;">
                    <i class="bi bi-box-arrow-up-right"></i> Submit Clearance via UmurongoSmart
                </a>
            </div>
        </div>
    </div>

    <!-- Important Downloads -->
    <div style="border-top:1px solid #e2e8f0;padding:1rem 1.25rem;
                display:flex;align-items:center;flex-wrap:wrap;gap:.75rem;">
        <span style="font-size:12px;font-weight:700;color:#6c8097;margin-right:.25rem;">
            <i class="bi bi-download me-1"></i>Downloads:
        </span>
        <a href="#" style="display:inline-flex;align-items:center;gap:6px;background:#f1f5f9;
                           border:1px solid #e2e8f0;border-radius:7px;padding:5px 12px;
                           font-size:12px;font-weight:600;color:#142d4d;text-decoration:none;">
            <i class="bi bi-file-earmark-pdf" style="color:#dc2626;"></i> Defense Guidelines
        </a>
        <a href="#" style="display:inline-flex;align-items:center;gap:6px;background:#f1f5f9;
                           border:1px solid #e2e8f0;border-radius:7px;padding:5px 12px;
                           font-size:12px;font-weight:600;color:#142d4d;text-decoration:none;">
            <i class="bi bi-file-earmark-word" style="color:#1556c8;"></i> Clearance Form
        </a>
        <a href="#" style="display:inline-flex;align-items:center;gap:6px;background:#f1f5f9;
                           border:1px solid #e2e8f0;border-radius:7px;padding:5px 12px;
                           font-size:12px;font-weight:600;color:#142d4d;text-decoration:none;">
            <i class="bi bi-file-earmark-text" style="color:#059669;"></i> Project Format Template
        </a>
        <a href="#" style="display:inline-flex;align-items:center;gap:6px;background:#f1f5f9;
                           border:1px solid #e2e8f0;border-radius:7px;padding:5px 12px;
                           font-size:12px;font-weight:600;color:#142d4d;text-decoration:none;">
            <i class="bi bi-calendar-check" style="color:#7c3aed;"></i> Graduation Schedule
        </a>
    </div>
</div>
