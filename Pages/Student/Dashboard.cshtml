@section Scripts {
<script>
    function filterCourses() {
        var q  = document.getElementById('courseSearch').value.toLowerCase();
        var st = document.getElementById('courseFilter').value;
        var rows = document.querySelectorAll('#allCoursesTable tbody tr:not(.yr-hdr)');
        var vis  = 0;

        rows.forEach(function(r) {
            var matchQ  = !q  || r.innerText.toLowerCase().includes(q);
            var matchSt = !st || r.getAttribute('data-st') === st;
            r.style.display = (matchQ && matchSt) ? '' : 'none';
            if (matchQ && matchSt) vis++;
        });

        // Hide year headers with no visible children
        document.querySelectorAll('.yr-hdr').forEach(function(h) {
            var sib = h.nextElementSibling;
            var show = false;
            while (sib && !sib.classList.contains('yr-hdr')) {
                if (sib.style.display !== 'none') { show = true; break; }
                sib = sib.nextElementSibling;
            }
            h.style.display = show ? '' : 'none';
        });

        document.getElementById('noCourses').style.display = vis ? 'none' : 'block';
    }

    function doEnroll(code, name) {
        if (!confirm('Enroll in ' + code + ' — ' + name + '?\n\nThis sends your enrollment request to the HOD for approval via UmurongoSmart. You will be notified once confirmed.')) return;
        var row = document.querySelector('tr[data-code="' + code + '"]');
        if (row) {
            row.setAttribute('data-st', 'enrolled');
            row.setAttribute('data-enrolled', '1');
            row.style.background = '#f5f3ff';
            row.cells[6].innerHTML = '<span class="cdot" style="background:#6366f1;"></span><b style="color:#4f46e5;font-size:12px;">Enrolled</b>';
            row.cells[7].innerHTML = '<span style="font-size:11px;color:#4f46e5;font-weight:700;background:#e0e7ff;padding:4px 10px;border-radius:7px;"><i class="bi bi-check-circle-fill me-1"></i>Done</span>';
        }
        var t = document.createElement('div');
        t.style.cssText = 'position:fixed;bottom:6rem;right:2rem;background:#16a34a;color:#fff;' +
            'padding:.75rem 1.25rem;border-radius:10px;font-weight:700;font-size:13px;' +
            'z-index:9999;box-shadow:0 8px 25px rgba(22,163,74,.4);display:flex;align-items:center;gap:8px;';
        t.innerHTML = '<i class="bi bi-check-circle-fill"></i> Enrollment request sent for <strong>' + code + '</strong>! HOD will confirm via UmurongoSmart.';
        document.body.appendChild(t);
        setTimeout(function() { t.remove(); }, 3500);
    }

    function notifyMe(code) {
        alert('You will be notified when registration opens for ' + code + '.');
        var row = document.querySelector('tr[data-code="' + code + '"]');
        if (row) {
            row.cells[7].innerHTML = '<span style="font-size:11px;color:#7c3aed;font-weight:700;' +
                'background:#f5f3ff;padding:4px 10px;border-radius:7px;">' +
                '<i class="bi bi-bell-fill me-1"></i>Notified</span>';
        }
    }
</script>
}
