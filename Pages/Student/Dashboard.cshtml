@page
@model CourseScheduleSystem.Web.Pages.Student.DashboardModel
@{
    ViewData["Title"] = "Student Dashboard";
    Layout = "~/Pages/Shared/_DashboardLayout.cshtml";
    ViewData["ActiveNav"] = "home";
    ViewData["Role"] = "Student";
    ViewData["UserName"] = User.Identity?.Name ?? "Student";
}

<!-- -- WELCOME BAR ---------------------------------------------------- -->
<div class="dash-welcome">
    <div>
        <h2 class="dash-heading">Good morning, @ViewData["UserName"] ??</h2>
        <p class="dash-subheading">Here's your academic overview for today � @DateTime.Now.ToString("dddd, dd MMMM yyyy")</p>
    </div>
    <div class="dash-welcome-badge">
        <i class="bi bi-mortarboard-fill"></i> Student � CIS Department
    </div>
</div>

<!-- -- STAT CARDS ----------------------------------------------------- -->
<div class="dash-stats">
    <div class="stat-card stat-blue">
        <div class="stat-icon"><i class="bi bi-calendar3"></i></div>
        <div class="stat-info"><span class="stat-val">4</span><span class="stat-label">Classes Today</span></div>
    </div>
    <div class="stat-card stat-green">
        <div class="stat-icon"><i class="bi bi-book-fill"></i></div>
        <div class="stat-info"><span class="stat-val">6</span><span class="stat-label">Enrolled Courses</span></div>
    </div>
    <div class="stat-card stat-orange">
        <div class="stat-icon"><i class="bi bi-alarm-fill"></i></div>
        <div class="stat-info"><span class="stat-val">2</span><span class="stat-label">Deadlines Soon</span></div>
    </div>
    <div class="stat-card stat-red">
        <div class="stat-icon"><i class="bi bi-bell-fill"></i></div>
        <div class="stat-info"><span class="stat-val">5</span><span class="stat-label">Unread Notifications</span></div>
    </div>
</div>

<!-- -- MAIN GRID ------------------------------------------------------- -->
<div class="dash-grid">

    <!-- TODAY'S SCHEDULE -->
    <div class="dash-panel">
        <div class="panel-header">
            <span><i class="bi bi-calendar-week-fill me-2"></i>Today's Schedule</span>
            <span class="panel-badge">Monday</span>
        </div>
        <div class="schedule-list">
            <div class="schedule-item">
                <div class="sched-time"><span>08:00</span><span class="sched-end">10:00</span></div>
                <div class="sched-bar bar-blue"></div>
                <div class="sched-info">
                    <div class="sched-course">Software Engineering</div>
                    <div class="sched-meta"><i class="bi bi-geo-alt"></i> Block A � Room A204 &nbsp;|&nbsp; <i class="bi bi-person"></i> Dr. J. Mugisha</div>
                </div>
                <span class="sched-badge badge-ongoing">Ongoing</span>
            </div>
            <div class="schedule-item">
                <div class="sched-time"><span>10:00</span><span class="sched-end">12:00</span></div>
                <div class="sched-bar bar-purple"></div>
                <div class="sched-info">
                    <div class="sched-course">Database Systems</div>
                    <div class="sched-meta"><i class="bi bi-geo-alt"></i> Block B � Room B101 &nbsp;|&nbsp; <i class="bi bi-person"></i> Mrs. A. Byukusenge</div>
                </div>
                <span class="sched-badge badge-upcoming">Upcoming</span>
            </div>
            <div class="schedule-item">
                <div class="sched-time"><span>13:00</span><span class="sched-end">15:00</span></div>
                <div class="sched-bar bar-green"></div>
                <div class="sched-info">
                    <div class="sched-course">Human-Computer Interaction</div>
                    <div class="sched-meta"><i class="bi bi-geo-alt"></i> Block A � Room A108 &nbsp;|&nbsp; <i class="bi bi-person"></i> Mr. E. Niyonsenga</div>
                </div>
                <span class="sched-badge badge-upcoming">Upcoming</span>
            </div>
        </div>
    </div>

    <!-- NOTIFICATIONS -->
    <div class="dash-panel">
        <div class="panel-header">
            <span><i class="bi bi-bell-fill me-2"></i>Notifications</span>
            <a href="#" class="panel-link">Mark all read</a>
        </div>
        <div class="notif-list">
            <div class="notif-item notif-unread">
                <div class="notif-icon notif-orange"><i class="bi bi-geo-alt-fill"></i></div>
                <div class="notif-body">
                    <div class="notif-title">Room Shift � CSE301</div>
                    <div class="notif-text">Software Engineering moved from A204 ? Lab 01 today.</div>
                    <div class="notif-time">5 minutes ago</div>
                </div>
            </div>
            <div class="notif-item notif-unread">
                <div class="notif-icon notif-red"><i class="bi bi-alarm-fill"></i></div>
                <div class="notif-body">
                    <div class="notif-title">Registration Deadline</div>
                    <div class="notif-text">CSE402 � Software Architecture closes in 2 days.</div>
                    <div class="notif-time">2 hours ago</div>
                </div>
            </div>
            <div class="notif-item">
                <div class="notif-icon notif-blue"><i class="bi bi-megaphone-fill"></i></div>
                <div class="notif-body">
                    <div class="notif-title">CP Announcement � CSE305</div>
                    <div class="notif-text">Tomorrow's class starts 30 min early. Bring your laptops.</div>
                    <div class="notif-time">Yesterday</div>
                </div>
            </div>
            <div class="notif-item">
                <div class="notif-icon notif-green"><i class="bi bi-check-circle-fill"></i></div>
                <div class="notif-body">
                    <div class="notif-title">Enrollment Confirmed</div>
                    <div class="notif-text">You are successfully enrolled in CSE310 HCI.</div>
                    <div class="notif-time">3 days ago</div>
                </div>
            </div>
        </div>
    </div>

</div>

