                </div>
            </div>
            <div class="cp-info"><i class="bi bi-person-badge-fill"></i> CP: Alice U. � <a href="#">Contact</a></div>
        </div>
        <div class="course-card">
            <div class="course-code">CSE310</div>
            <div class="course-name">Human-Computer Interaction</div>
            <div class="course-meta"><i class="bi bi-person-fill"></i> Mr. E. Niyonsenga</div>
            <div class="course-meta"><i class="bi bi-calendar3"></i> Wed 13:00�15:00 � A108</div>
            <div class="course-footer">
                <span class="course-status status-open">Open</span>
                <div class="course-actions">
