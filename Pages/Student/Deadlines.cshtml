@page
@model CourseScheduleSystem.Web.Pages.Student.DeadlinesModel
@{ ViewData["Title"]="Deadlines"; Layout="~/Pages/Shared/_DashboardLayout.cshtml"; ViewData["Role"]="Student"; ViewData["ActiveNav"]="deadlines"; ViewData["UserName"]=User.Identity?.Name??"Student"; }

