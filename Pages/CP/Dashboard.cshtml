        padding: 6px 14px; font-size: 12px; font-weight: 700;
        cursor: pointer; transition: .2s;
        animation: signPulse 2s infinite;
    }
    .btn-sign:hover { transform: translateY(-1px); box-shadow: 0 6px 18px rgba(5,150,105,.35); }
    @@keyframes signPulse {
        0%,100% { box-shadow: 0 0 0 0 rgba(5,150,105,.4); }
        50%      { box-shadow: 0 0 0 6px rgba(5,150,105,0); }
    }
</style>

@section Scripts {
<script>
    // ── CP Profile edit ────────────────────────────────────────────
    function toggleEditProfile() {
        var v = document.getElementById('profileView');
        var e = document.getElementById('profileEdit');
        v.style.display = v.style.display === 'none' ? 'grid' : 'none';
        e.style.display = e.style.display === 'none' ? 'block' : 'none';
    }

    function saveProfile() {
        var fields = {
            'pv-name':        'pe-name',
            'pv-phone':       'pe-phone',
            'pv-nationality': 'pe-nationality',
            'pv-dept':        'pe-dept',
            'pv-intake':      'pe-intake',
            'pv-year':        'pe-year',
            'pv-session':     'pe-session'
        };
        Object.keys(fields).forEach(function(view) {
            var input = document.getElementById(fields[view]);
            if (input) document.getElementById(view).textContent = input.value;
        });
        toggleEditProfile();
        showToast('Profile saved successfully!', '#059669');
    }

    // ── Flag form with saved notes ─────────────────────────────────
    function submitFlag(e) {
        e.preventDefault();
        var course = document.getElementById('flagCourse').value;
        var type   = document.querySelector('input[name="issue"]:checked').value;
        var notes  = document.getElementById('flagNotes').value.trim();
        if (!notes) { alert('Please add notes describing what happened. These are important for HOD review.'); return; }

        var today  = new Date().toLocaleDateString('en-GB',{day:'2-digit',month:'short',year:'numeric'});
        var badgeClass = type === 'Absent' ? 'badge-absent' : type === 'Late' ? 'badge-late' : 'badge-absent';
        var label  = type === 'Absent' ? 'Absent' : type === 'Late' ? 'Delayed' : 'Cancelled';

        var item = document.createElement('div');
        item.className = 'flag-item';
        item.innerHTML =
            '<span class="flag-badge ' + badgeClass + '">' + label + '</span>' +
            '<div class="flag-detail" style="flex:1;">' +
              '<div>' + course.split(' — ')[0] + ' · <span class="text-muted" style="font-size:11px;">' + today + '</span></div>' +
              '<div style="font-size:11px;color:#374151;margin-top:3px;font-style:italic;">"' + notes + '"</div>' +
            '</div>' +
            '<span class="flag-status pending">Pending</span>';

        document.getElementById('flagsLog').appendChild(item);
        document.getElementById('flagNotes').value = '';
        showToast('Flag saved — visible to HOD & Director of Quality', '#1556c8');
    }

    // ── Course completion signature ────────────────────────────────
    var _signRow = null;
    var _signCode = '';
    var _signName2 = '';
    var _signLecturer = '';

    function signCourse(code, name, lecturer, btn) {
        _signCode     = code;
        _signName2    = name;
        _signLecturer = lecturer;
        _signRow      = btn.closest('tr');
        document.getElementById('signModalTitle').textContent = 'Sign Completion — ' + code;
        document.getElementById('signModalSubtitle').textContent = name + ' · ' + lecturer;
        var m = document.getElementById('signModal');
        m.style.display = 'flex';
    }

    function closeSignModal() {
        document.getElementById('signModal').style.display = 'none';
    }

    function confirmSign() {
        var sigName    = document.getElementById('signName').value.trim();
        var comments   = document.getElementById('signComments').value.trim();
        var today      = new Date().toLocaleDateString('en-GB',{day:'2-digit',month:'short',year:'numeric'});
        if (!sigName) { alert('Please enter your name as signature.'); return; }

        // Update the row
        var sigCell = _signRow.querySelector('.sig-cell');
        sigCell.innerHTML =
            '<span style="display:inline-flex;align-items:center;gap:5px;font-size:11px;' +
            'font-weight:700;color:#059669;background:#ecfdf5;border:1px solid #bbf7d0;' +
            'border-radius:8px;padding:4px 10px;">' +
            '<i class="bi bi-patch-check-fill"></i> Signed by CP ' +
            '<span style="font-size:10px;color:#6c8097;font-weight:400;">' + today + '</span></span>';

        _signRow.cells[6].innerHTML =
            '<span class="sched-badge" style="background:#dcfce7;color:#15803d;">Completed</span>';

        // Add to signature log
        var log = document.getElementById('signatureLog');
        var entry = document.createElement('div');
        entry.style.cssText = 'background:#ecfdf5;border:1px solid #bbf7d0;border-radius:10px;' +
            'padding:.75rem 1rem;display:flex;align-items:center;justify-content:space-between;' +
            'flex-wrap:wrap;gap:.5rem;margin-top:.5rem;';
        entry.innerHTML =
            '<div>' +
              '<div style="font-size:13px;font-weight:700;color:#065f46;">' +
                '<i class="bi bi-patch-check-fill me-2 text-success"></i>' +
                _signCode + ' — ' + _signName2 +
              '</div>' +
              '<div style="font-size:11px;color:#6c8097;margin-top:2px;">' +
                'Signed by CP: ' + sigName + ' · ' + today + ' · Lecturer: ' + _signLecturer +
                (comments ? ' · Note: ' + comments : '') +
              '</div>' +
            '</div>' +
            '<span style="font-size:11px;font-weight:700;color:#059669;background:#fff;' +
              'border:1px solid #bbf7d0;border-radius:7px;padding:3px 10px;">Verified ✓</span>';
        log.appendChild(entry);

        closeSignModal();
        showToast('Course completion signed! HOD has been notified.', '#059669');
    }

    // Close modal on backdrop click
    document.getElementById('signModal').addEventListener('click', function(e) {
        if (e.target === this) closeSignModal();
    });

    // ── Toast helper ───────────────────────────────────────────────
    function showToast(msg, color) {
        var t = document.createElement('div');
        t.style.cssText = 'position:fixed;bottom:6rem;right:2rem;background:' + color + ';color:#fff;' +
            'padding:.75rem 1.25rem;border-radius:10px;font-weight:700;font-size:13px;' +
            'z-index:99999;box-shadow:0 8px 25px rgba(0,0,0,.25);' +
            'display:flex;align-items:center;gap:8px;';
        t.innerHTML = '<i class="bi bi-check-circle-fill"></i> ' + msg;
        document.body.appendChild(t);
        setTimeout(function() { t.remove(); }, 3500);
    }
</script>
}
