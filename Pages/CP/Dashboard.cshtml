@section Scripts {
<script>
// ── Tab switching ─────────────────────────────────────
function showCPTab(name, btn) {
    document.querySelectorAll('.cptab-content').forEach(function(t){ t.style.display='none'; });
    document.querySelectorAll('.cp-tab').forEach(function(b){ b.classList.remove('active'); });
    document.getElementById('cptab-'+name).style.display='block';
    if(btn) btn.classList.add('active');
    if(name==='chat') scrollChat();
}

// ── Attendance flag ───────────────────────────────────
function submitFlag(e) {
    e.preventDefault();
    var course = document.getElementById('flagCourse').value;
    var type   = document.querySelector('input[name="issue"]:checked').value;
    var notes  = document.getElementById('flagNotes').value.trim();
    if(!notes){ alert('Please add notes. They are required for HOD review.'); return; }
    var today = new Date().toLocaleDateString('en-GB',{day:'2-digit',month:'short',year:'numeric'});
    var isGood = type === 'Lecturer Presented Well';
    var item = document.createElement('div');
    item.className = 'flag-item';
    item.style.flexWrap = 'wrap';
    var badgeSt = isGood
        ? '<span style="background:#ecfdf5;color:#059669;font-size:11px;font-weight:700;padding:3px 9px;border-radius:20px;white-space:nowrap;"><i class="bi bi-star-fill me-1"></i>Presented Well</span>'
        : (type==='Lecturer Absent' ? '<span class="flag-badge badge-absent">Absent</span>' : '<span class="flag-badge badge-late">' + type + '</span>');
    item.innerHTML = badgeSt +
        '<div class="flag-detail" style="flex:1;min-width:0;">' +
          '<div style="font-size:13px;font-weight:700;">' + course.split(' — ')[0] + ' · <span class="text-muted" style="font-size:11px;font-weight:400;">' + today + '</span></div>' +
          '<div style="font-size:11px;color:#374151;margin-top:2px;font-style:italic;">"' + notes + '"</div>' +
        '</div>' +
        '<span style="font-size:11px;font-weight:700;color:' + (isGood?'#059669':'#f59e0b') + ';">' + (isGood?'Recorded':'Pending') + '</span>';
    document.getElementById('flagsLog').prepend(item);
    document.getElementById('flagNotes').value = '';
    toast('Flag saved — visible to HOD &amp; Director of Quality', '#1556c8');
}

// ── CP list filter ────────────────────────────────────
function filterCPs() {
    var q  = document.getElementById('cpSearch').value.toLowerCase();
    var yr = document.getElementById('cpYearF').value;
    var ss = document.getElementById('cpSessF').value;
    var rows = document.querySelectorAll('#cpTbody tr');
    var cnt = 0;
    rows.forEach(function(r){
        var ok = (!q || r.innerText.toLowerCase().includes(q))
              && (!yr || r.dataset.yr === yr)
              && (!ss || r.dataset.sess === ss);
        r.style.display = ok ? '' : 'none';
        if(ok) cnt++;
    });
    document.getElementById('cpCountLbl').textContent = cnt + ' CP' + (cnt!==1?'s':'');
}

// ── Add/Edit CP ───────────────────────────────────────
var _editRow = null;
function openCPModal(){ _editRow=null; clearCPForm(); document.getElementById('cpModalTitle').textContent='Add Class Representative'; document.getElementById('cpSaveLbl').textContent='Add CP'; document.getElementById('cpModal').style.display='flex'; }
function closeCPModal(){ document.getElementById('cpModal').style.display='none'; _editRow=null; }
function clearCPForm(){ ['f-name','f-regno','f-phone','f-nat','f-intake','f-courses'].forEach(function(id){ document.getElementById(id).value=''; }); document.getElementById('f-dept').value='CIS'; }
function editCP(btn) {
    var row = btn.closest('tr');
    _editRow = row;
    var cells = row.cells;
    // name is in cells[1] inner text (second div)
    var nameDiv = cells[1].querySelector('div div:first-child');
    document.getElementById('f-name').value    = nameDiv ? nameDiv.textContent.trim() : '';
    document.getElementById('f-regno').value   = cells[2].textContent.trim();
    document.getElementById('f-phone').value   = cells[3].textContent.trim();
    document.getElementById('f-nat').value     = cells[4].textContent.trim();
    document.getElementById('f-intake').value  = cells[6].textContent.trim();
    document.getElementById('f-year').value    = row.dataset.yr;
    document.getElementById('f-sess').value    = row.dataset.sess;
    document.getElementById('f-courses').value = cells[9].textContent.trim();
    document.getElementById('cpModalTitle').textContent = 'Update CP Details';
    document.getElementById('cpSaveLbl').textContent    = 'Save Changes';
    document.getElementById('cpModal').style.display    = 'flex';
}
function saveCP() {
    var name    = document.getElementById('f-name').value.trim();
    var regno   = document.getElementById('f-regno').value.trim();
    var phone   = document.getElementById('f-phone').value.trim();
    var nat     = document.getElementById('f-nat').value.trim();
    var intake  = document.getElementById('f-intake').value.trim();
    var yr      = document.getElementById('f-year').value;
    var sess    = document.getElementById('f-sess').value;
    var courses = document.getElementById('f-courses').value.trim();
    if(!name||!regno||!phone||!nat||!intake){ alert('Please fill all required fields.'); return; }

    if(_editRow) {
        // Update existing row
        var cells = _editRow.cells;
        var av = name[0].toUpperCase();
        var colors = ['#7c3aed','#1556c8','#059669','#dc2626','#ea580c','#0891b2','#d97706'];
        var col = colors[Math.floor(Math.random()*colors.length)];
        cells[1].innerHTML = '<div style="display:flex;align-items:center;gap:7px;"><div style="width:30px;height:30px;border-radius:50%;background:'+col+';display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:800;color:#fff;flex-shrink:0;">'+av+'</div><div style="font-weight:700;font-size:13px;">'+name+'</div></div>';
        cells[2].textContent = regno;
        cells[3].textContent = phone;
        cells[4].textContent = nat;
        cells[6].textContent = intake;
        cells[7].innerHTML   = '<span class="session-badge">'+yr+'</span>';
        cells[8].innerHTML   = '<span class="session-badge">'+sess+'</span>';
        cells[9].textContent = courses;
        _editRow.dataset.yr   = yr;
        _editRow.dataset.sess = sess;
        toast('CP details updated successfully!', '#059669');
    } else {
        // Add new row
        var tbody = document.getElementById('cpTbody');
        var rowCount = tbody.querySelectorAll('tr').length + 1;
        var av2 = name[0].toUpperCase();
        var palette = ['#7c3aed','#1556c8','#059669','#dc2626','#ea580c','#0891b2','#d97706','#db2777'];
        var c2 = palette[rowCount % palette.length];
        var hasActions = @(isReadOnly?"false":"true");
        var tr = document.createElement('tr');
        tr.dataset.yr   = yr;
        tr.dataset.sess = sess;
        tr.innerHTML =
            '<td>'+rowCount+'</td>' +
            '<td><div style="display:flex;align-items:center;gap:7px;"><div style="width:30px;height:30px;border-radius:50%;background:'+c2+';display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:800;color:#fff;flex-shrink:0;">'+av2+'</div><div style="font-weight:700;font-size:13px;">'+name+'</div></div></td>' +
            '<td>'+regno+'</td><td>'+phone+'</td><td>'+nat+'</td><td>CIS</td><td>'+intake+'</td>' +
            '<td><span class="session-badge">'+yr+'</span></td>' +
            '<td><span class="session-badge">'+sess+'</span></td>' +
            '<td style="font-size:12px;">'+courses+'</td>' +
            (hasActions ? '<td class="action-btns"><button class="btn-icon btn-edit" onclick="editCP(this)" title="Edit"><i class="bi bi-pencil-fill"></i></button><button class="btn-icon btn-del" onclick="removeCP(this)" title="Remove"><i class="bi bi-trash-fill"></i></button></td>' : '');
        tbody.appendChild(tr);
        filterCPs();
        toast('CP added to the list!', '#059669');
    }
    closeCPModal();
}
function removeCP(btn) {
    if(!confirm('Remove this CP from the list?')) return;
    btn.closest('tr').remove();
    filterCPs();
    toast('CP removed.', '#6b7280');
}

// ── Chat ─────────────────────────────────────────────
var hodReplies = [
    'Thank you for the update. I will look into this.',
    'Noted. Please also submit the required form.',
    'I will discuss this with the lecturer directly.',
    'Good work keeping me informed.',
    'This has been recorded for the monthly report.',
    'Understood. I will take action immediately.',
    'Please also send me the written report by end of day.'
];
function sendChat() {
    var input = document.getElementById('chatInput');
    var txt = input.value.trim();
    if(!txt) return;
    addMsg(txt,'out');
    input.value = '';
    setTimeout(function(){
        document.getElementById('chatTyping').style.display='flex';
        scrollChat();
    }, 300);
    setTimeout(function(){
        document.getElementById('chatTyping').style.display='none';
        addMsg(hodReplies[Math.floor(Math.random()*hodReplies.length)],'in');
    }, 2000);
}
function addMsg(txt, dir) {
    var box = document.getElementById('chatMessages');
    var now = 'Today ' + new Date().toLocaleTimeString('en-GB',{hour:'2-digit',minute:'2-digit'});
    var w = document.createElement('div');
    w.className = 'cmsg c' + dir;
    if(dir==='out'){
        w.innerHTML = '<div class="cbbl cbbl-out"><div class="cfrom" style="color:rgba(255,255,255,.7);">You (CP)</div><div class="ctxt">'+esc(txt)+'</div><div class="cts" style="color:rgba(255,255,255,.65);">'+now+'</div></div><div class="cav" style="background:#7c3aed;">B</div>';
    } else {
        w.innerHTML = '<div class="cav" style="background:#1556c8;">E</div><div class="cbbl cbbl-in"><div class="cfrom">Prof. Eric Mugisha (HOD)</div><div class="ctxt">'+esc(txt)+'</div><div class="cts">'+now+'</div></div>';
    }
    box.insertBefore(w, document.getElementById('chatTyping'));
    scrollChat();
}
function scrollChat(){ var b=document.getElementById('chatMessages'); if(b) b.scrollTop=b.scrollHeight; }
function chatKey(e){ if(e.key==='Enter'&&!e.shiftKey){e.preventDefault();sendChat();} }
function quickReply(m){ document.getElementById('chatInput').value=m; sendChat(); }
function esc(s){ return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/\n/g,'<br>'); }

// ── Room swap ─────────────────────────────────────────
function submitSwap(e){
    e.preventDefault();
    toast('Room swap request submitted! HOD will review shortly.','#1556c8');
}

// ── Announcements ─────────────────────────────────────
function submitAnn(e){
    e.preventDefault();
    var title = document.getElementById('annTitle').value.trim();
    var body  = document.getElementById('annBody').value.trim();
    if(!title||!body){alert('Please fill in the title and message.');return;}
    var today = new Date().toLocaleDateString('en-GB',{day:'2-digit',month:'short',year:'numeric'});
    var el = document.createElement('div');
    el.style.cssText='background:#f8fafc;border:1px solid #e2e8f0;border-radius:10px;padding:.75rem 1rem;';
    el.innerHTML='<div style="font-size:13px;font-weight:700;color:#142d4d;">'+title+'</div><div style="font-size:11px;color:#6c8097;margin-top:2px;">All my classes · '+today+' · 42 students notified</div>';
    document.getElementById('annLog').prepend(el);
    document.getElementById('annTitle').value='';
    document.getElementById('annBody').value='';
    toast('Announcement posted to class!','#059669');
}

// ── Course completion signature ───────────────────────
var _sigRow=null, _sigCode='', _sigName='', _sigLec='';
function signCourse(code,name,lec,btn){
    _sigCode=code; _sigName=name; _sigLec=lec; _sigRow=btn.closest('tr');
    document.getElementById('signTitle').textContent='Sign Completion — '+code;
    document.getElementById('signSub').textContent=name+' · '+lec;
    document.getElementById('signModal').style.display='flex';
}
function confirmSign(){
    var sn  = document.getElementById('signName').value.trim();
    var cm  = document.getElementById('signComments').value.trim();
    if(!sn){alert('Please enter your name.');return;}
    var today = new Date().toLocaleDateString('en-GB',{day:'2-digit',month:'short',year:'numeric'});
    if(_sigRow){
        _sigRow.querySelector('.sig-cell').innerHTML =
            '<span style="display:inline-flex;align-items:center;gap:5px;font-size:11px;font-weight:700;color:#059669;background:#ecfdf5;border:1px solid #bbf7d0;border-radius:8px;padding:4px 10px;">'
            +'<i class="bi bi-patch-check-fill"></i>Signed <span style="font-size:10px;color:#6c8097;font-weight:400;">'+today+'</span></span>';
    }
    var log = document.getElementById('signatureLog');
    var entry = document.createElement('div');
    entry.style.cssText='background:#ecfdf5;border:1px solid #bbf7d0;border-radius:10px;padding:.7rem 1rem;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:.5rem;margin-top:.5rem;';
    entry.innerHTML=
        '<div><div style="font-size:13px;font-weight:700;color:#065f46;"><i class="bi bi-patch-check-fill me-2 text-success"></i>'+_sigCode+' — '+_sigName+'</div>'
        +'<div style="font-size:11px;color:#6c8097;margin-top:2px;">Signed: '+sn+' · '+today+' · '+_sigLec+(cm?' · '+cm:'')+'</div></div>'
        +'<span style="font-size:11px;font-weight:700;color:#059669;background:#fff;border:1px solid #bbf7d0;border-radius:7px;padding:3px 10px;">Verified ✓</span>';
    log.appendChild(entry);
    document.getElementById('signModal').style.display='none';
    document.getElementById('signComments').value='';
    toast('Course signed! HOD has been notified.','#059669');
}
document.getElementById('signModal').addEventListener('click',function(e){if(e.target===this) this.style.display='none';});
document.getElementById('cpModal').addEventListener('click',function(e){if(e.target===this) closeCPModal();});

// ── Toast ─────────────────────────────────────────────
function toast(msg, color){
    var t=document.createElement('div');
    t.style.cssText='position:fixed;bottom:6rem;right:2rem;background:'+color+';color:#fff;'
        +'padding:.75rem 1.25rem;border-radius:10px;font-weight:700;font-size:13px;'
        +'z-index:99999;box-shadow:0 8px 25px rgba(0,0,0,.25);'
        +'display:flex;align-items:center;gap:8px;';
    t.innerHTML='<i class="bi bi-check-circle-fill"></i> '+msg;
    document.body.appendChild(t);
    setTimeout(function(){t.remove();},3500);
}

// Scroll chat on page load
scrollChat();
</script>
}
