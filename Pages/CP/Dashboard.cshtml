@page
@model CourseScheduleSystem.Web.Pages.CP.DashboardModel
@{
    ViewData["Title"] = "Class Representative Dashboard";
    Layout = "~/Pages/Shared/_DashboardLayout.cshtml";
    ViewData["ActiveNav"] = "home";
    ViewData["Role"] = "CP";
    ViewData["UserName"] = User.Identity?.Name ?? "CP";
}

<div class="dash-welcome">
    <div>
        <h2 class="dash-heading">Class Representative Dashboard</h2>
        <p class="dash-subheading">@DateTime.Now.ToString("dddd, dd MMMM yyyy") · CIS Department</p>
    </div>
    <div class="dash-welcome-badge" style="background:rgba(124,58,237,.15);color:#7c3aed;">
        <i class="bi bi-person-badge-fill"></i> Class Representative
    </div>
</div>

<div class="dash-stats">
    <div class="stat-card stat-blue">
        <div class="stat-icon"><i class="bi bi-people-fill"></i></div>
        <div class="stat-info"><span class="stat-val">42</span><span class="stat-label">Class Members</span></div>
    </div>
    <div class="stat-card stat-orange">
        <div class="stat-icon"><i class="bi bi-flag-fill"></i></div>
        <div class="stat-info"><span class="stat-val">3</span><span class="stat-label">Pending Flags</span></div>
    </div>
    <div class="stat-card stat-purple">
        <div class="stat-icon"><i class="bi bi-arrow-left-right"></i></div>
        <div class="stat-info"><span class="stat-val">1</span><span class="stat-label">Room Swap Requests</span></div>
    </div>
    <div class="stat-card stat-green">
        <div class="stat-icon"><i class="bi bi-megaphone-fill"></i></div>
        <div class="stat-info"><span class="stat-val">5</span><span class="stat-label">Announcements Sent</span></div>
    </div>
</div>

<div class="dash-grid">

    <!-- ATTENDANCE FLAGGING -->
    <div class="dash-panel">
        <div class="panel-header">
            <span><i class="bi bi-flag-fill me-2 text-danger"></i>Flag Attendance Issue</span>
        </div>
        <form class="flag-form">
            <div class="mb-3">
                <label class="form-label fw-semibold">Course / Session</label>
                <select class="form-select">
                    <option>CSE301 — Software Engineering · Mon 08:00</option>
                    <option>CSE305 — Database Systems · Tue 10:00</option>
                    <option>CSE310 — HCI · Wed 13:00</option>
                    <option>CSE402 — Software Architecture · Thu 08:00</option>
                </select>
            </div>
            <div class="mb-3">
                <label class="form-label fw-semibold">Issue Type</label>
                <div class="d-flex gap-3">
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="issue" id="absent" value="Absent" checked />
                        <label class="form-check-label" for="absent">Lecturer Absent</label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="issue" id="late" value="Late" />
                        <label class="form-check-label" for="late">Class Delayed</label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="issue" id="cancelled" value="Cancelled" />
                        <label class="form-check-label" for="cancelled">Cancelled</label>
                    </div>
                </div>
            </div>
            <div class="mb-3">
                <label class="form-label fw-semibold">Notes (optional)</label>
                <textarea class="form-control" rows="2" placeholder="Add context or details…"></textarea>
            </div>
            <button type="submit" class="btn-dash-primary"><i class="bi bi-flag-fill me-2"></i>Submit Flag</button>
        </form>

        <!-- Existing flags -->
        <div class="mt-3">
            <div class="flag-item">
                <span class="flag-badge badge-absent">Absent</span>
                <div class="flag-detail">CSE305 — Tue 10:00 · <span class="text-muted">28 Aug 2026</span></div>
                <span class="flag-status pending">Pending</span>
            </div>
            <div class="flag-item">
                <span class="flag-badge badge-late">Delayed</span>
                <div class="flag-detail">CSE301 — Mon 08:00 · <span class="text-muted">25 Aug 2026</span></div>
                <span class="flag-status reviewed">Reviewed</span>
            </div>
        </div>
    </div>

    <!-- ROOM SWAP REQUEST + ANNOUNCEMENTS -->
    <div>
        <!-- Room swap -->
        <div class="dash-panel mb-4">
            <div class="panel-header">
                <span><i class="bi bi-arrow-left-right me-2"></i>Request Room Swap</span>
            </div>
            <form class="flag-form">
                <div class="mb-3">
                    <label class="form-label fw-semibold">Affected Session</label>
                    <select class="form-select">
                        <option>CSE301 — Mon 08:00 · Room A204</option>
                        <option>CSE305 — Tue 10:00 · Room B101</option>
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">Preferred Room</label>
                    <select class="form-select">
                        <option>Lab 01 — Block D (Cap: 30)</option>
                        <option>Room C302 — Block C (Cap: 50)</option>
                        <option>Room A108 — Block A (Cap: 40)</option>
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">Reason</label>
                    <textarea class="form-control" rows="2" placeholder="Why is the swap needed?"></textarea>
                </div>
                <button type="submit" class="btn-dash-secondary"><i class="bi bi-arrow-left-right me-2"></i>Submit Request</button>
            </form>
        </div>

        <!-- Post announcement -->
        <div class="dash-panel">
            <div class="panel-header">
                <span><i class="bi bi-megaphone-fill me-2"></i>Post Announcement</span>
            </div>
            <form class="flag-form">
                <div class="mb-3">
                    <label class="form-label fw-semibold">Class / Course</label>
                    <select class="form-select">
                        <option>All my classes</option>
                        <option>CSE301 — Software Engineering</option>
                        <option>CSE305 — Database Systems</option>
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">Announcement</label>
                    <textarea class="form-control" rows="3" placeholder="Write your announcement…"></textarea>
                </div>
                <button type="submit" class="btn-dash-primary"><i class="bi bi-send-fill me-2"></i>Post Announcement</button>
            </form>
        </div>
    </div>
</div>

<!-- SCHEDULE (same as student) -->
<div class="dash-panel mt-4">
    <div class="panel-header">
        <span><i class="bi bi-calendar-week-fill me-2"></i>My Class Schedule</span>
    </div>
    <div class="table-responsive">
        <table class="dash-table">
            <thead><tr><th>Day</th><th>Time</th><th>Course</th><th>Room</th><th>Lecturer</th><th>Status</th></tr></thead>
            <tbody>
                <tr><td>Monday</td><td>08:00–10:00</td><td>Software Engineering</td><td><span class="room-badge">A204</span></td><td>Dr. J. Mugisha</td><td><span class="sched-badge badge-ongoing">Ongoing</span></td></tr>
                <tr><td>Tuesday</td><td>10:00–12:00</td><td>Database Systems</td><td><span class="room-badge">B101</span></td><td>Mrs. A. Byukusenge</td><td><span class="sched-badge badge-upcoming">Upcoming</span></td></tr>
                <tr><td>Wednesday</td><td>13:00–15:00</td><td>Human-Computer Interaction</td><td><span class="room-badge">A108</span></td><td>Mr. E. Niyonsenga</td><td><span class="sched-badge badge-upcoming">Upcoming</span></td></tr>
                <tr><td>Thursday</td><td>08:00–10:00</td><td>Software Architecture</td><td><span class="room-badge">C302</span></td><td>Dr. P. Habimana</td><td><span class="sched-badge badge-upcoming">Upcoming</span></td></tr>
            </tbody>
        </table>
    </div>
</div>
