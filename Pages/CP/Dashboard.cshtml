@page
@model CourseScheduleSystem.Web.Pages.CP.DashboardModel
@{
    ViewData["Title"] = "Class Representative Dashboard";
    Layout = "~/Pages/Shared/_DashboardLayout.cshtml";
    ViewData["ActiveNav"] = "home";
    ViewData["Role"] = "CP";
    ViewData["UserName"] = User.Identity?.Name ?? "CP";
    bool isReadOnly = User.IsInRole("DirectorOfQuality") || User.IsInRole("Dean") || User.IsInRole("HOD");
    string viewerRole = isReadOnly
        ? (User.IsInRole("DirectorOfQuality") ? "Director of Quality" : "Dean / HOD")
        : "Class Representative";
}

@if (isReadOnly)
{
    <div style="background:linear-gradient(135deg,#059669,#047857);color:#fff;border-radius:12px;
                padding:1rem 1.5rem;margin-bottom:1.25rem;display:flex;align-items:center;gap:12px;">
        <i class="bi bi-eye-fill" style="font-size:20px;flex-shrink:0;"></i>
        <div>
            <div style="font-weight:800;font-size:14px;">Read-Only View — @viewerRole</div>
            <div style="font-size:12px;opacity:.85;">Viewing CP dashboard. All flags, notes and actions are visible here.</div>
        </div>
    </div>
}

<div class="dash-welcome">
    <div>
        <h2 class="dash-heading">Class Representative Dashboard</h2>
        <p class="dash-subheading">@DateTime.Now.ToString("dddd, dd MMMM yyyy") · CIS Department — UNILAK</p>
    </div>
    <div class="dash-welcome-badge" style="background:rgba(124,58,237,.15);color:#7c3aed;">
        <i class="bi bi-person-badge-fill"></i> @viewerRole
    </div>
</div>

<div class="dash-stats" style="margin-bottom:1.5rem;">
    <div class="stat-card stat-blue">
        <div class="stat-icon"><i class="bi bi-people-fill"></i></div>
        <div class="stat-info"><span class="stat-val">42</span><span class="stat-label">Class Members</span></div>
    </div>
    <div class="stat-card stat-orange">
        <div class="stat-icon"><i class="bi bi-flag-fill"></i></div>
        <div class="stat-info"><span class="stat-val">3</span><span class="stat-label">Pending Flags</span></div>
    </div>
    <div class="stat-card stat-purple">
        <div class="stat-icon"><i class="bi bi-arrow-left-right"></i></div>
        <div class="stat-info"><span class="stat-val">1</span><span class="stat-label">Room Swaps</span></div>
    </div>
    <div class="stat-card stat-green">
        <div class="stat-icon"><i class="bi bi-megaphone-fill"></i></div>
        <div class="stat-info"><span class="stat-val">5</span><span class="stat-label">Announcements</span></div>
    </div>
</div>

<!-- TAB NAVIGATION -->
<div style="display:flex;flex-wrap:wrap;gap:.4rem;margin-bottom:1.5rem;">
    <button class="cp-tab active" onclick="showCPTab('overview',this)"><i class="bi bi-speedometer2 me-1"></i>Overview</button>
    <button class="cp-tab" onclick="showCPTab('flags',this)"><i class="bi bi-flag-fill me-1"></i>Attendance Flags</button>
    <button class="cp-tab" onclick="showCPTab('schedule',this)"><i class="bi bi-calendar-week-fill me-1"></i>Schedule &amp; Signatures</button>
    <button class="cp-tab" onclick="showCPTab('allcps',this)"><i class="bi bi-people-fill me-1"></i>All CIS Class Reps</button>
    <button class="cp-tab" onclick="showCPTab('chat',this)">
        <i class="bi bi-chat-dots-fill me-1"></i>Chat with HOD
        <span style="background:#dc2626;color:#fff;font-size:9px;font-weight:800;padding:1px 5px;border-radius:10px;margin-left:3px;">2</span>
    </button>
    <button class="cp-tab" onclick="showCPTab('roomswap',this)"><i class="bi bi-arrow-left-right me-1"></i>Room Swap</button>
    <button class="cp-tab" onclick="showCPTab('announce',this)"><i class="bi bi-megaphone-fill me-1"></i>Announcements</button>
</div>

<!-- ═══════════════ TAB: OVERVIEW ═══════════════ -->
<div id="cptab-overview" class="cptab-content">
    <div class="dash-grid">
        <div class="dash-panel">
            <div class="panel-header">
                <span><i class="bi bi-person-badge-fill me-2" style="color:#7c3aed;"></i>My CP Profile</span>
                @if (!isReadOnly){
                    <button class="btn-dash-primary" style="font-size:11px;padding:4px 12px;" onclick="showCPTab('allcps',document.querySelectorAll('.cp-tab')[3])">
                        <i class="bi bi-pencil-fill me-1"></i>Update Details
                    </button>
                }
            </div>
            <div style="padding:1rem 1.25rem;display:grid;grid-template-columns:1fr 1fr;gap:.6rem;">
                <div class="cpi-cell"><span class="cpi-lbl">Full Name</span><span class="cpi-val" id="ov-name">Bob Nkurunziza</span></div>
                <div class="cpi-cell"><span class="cpi-lbl">Phone</span><span class="cpi-val" id="ov-phone">+250 788 123 456</span></div>
                <div class="cpi-cell"><span class="cpi-lbl">Nationality</span><span class="cpi-val" id="ov-nat">Rwandan</span></div>
                <div class="cpi-cell"><span class="cpi-lbl">Department</span><span class="cpi-val">CIS — UNILAK</span></div>
                <div class="cpi-cell"><span class="cpi-lbl">Intake</span><span class="cpi-val" id="ov-intake">2023 — Sem 1</span></div>
                <div class="cpi-cell"><span class="cpi-lbl">Academic Year</span><span class="cpi-val" id="ov-year">Year 3</span></div>
                <div class="cpi-cell"><span class="cpi-lbl">Session</span><span class="cpi-val" id="ov-session">Day</span></div>
                <div class="cpi-cell" style="background:#eff6ff;border-color:#bfdbfe;">
                    <span class="cpi-lbl" style="color:#1556c8;">Reg. Number</span>
                    <span class="cpi-val" style="color:#1556c8;">CP001</span>
                </div>
            </div>
        </div>
        <div class="dash-panel">
            <div class="panel-header"><span><i class="bi bi-activity me-2"></i>Recent Activity</span></div>
            <div class="notif-list">
                <div class="notif-item notif-unread">
                    <div class="notif-icon notif-red"><i class="bi bi-flag-fill"></i></div>
                    <div class="notif-body">
                        <div class="notif-title">Flag Submitted — CSE305</div>
                        <div class="notif-text">Mrs. Byukusenge absent · 28 Aug 2026</div>
                        <div class="notif-time">2 hours ago</div>
                    </div>
                </div>
                <div class="notif-item">
                    <div class="notif-icon notif-blue"><i class="bi bi-arrow-left-right"></i></div>
                    <div class="notif-body">
                        <div class="notif-title">Room Swap Approved</div>
                        <div class="notif-text">CSE310 moved A108 → C302</div>
                        <div class="notif-time">Yesterday</div>
                    </div>
                </div>
                <div class="notif-item">
                    <div class="notif-icon notif-green"><i class="bi bi-pen-fill"></i></div>
                    <div class="notif-body">
                        <div class="notif-title">Course Signed — CSE402</div>
                        <div class="notif-text">Completion confirmed to HOD</div>
                        <div class="notif-time">25 Aug 2026</div>
                    </div>
                </div>
                <div class="notif-item">
                    <div class="notif-icon notif-orange"><i class="bi bi-chat-dots-fill"></i></div>
                    <div class="notif-body">
                        <div class="notif-title">HOD replied in Chat</div>
                        <div class="notif-text">"I will arrange C302 starting next week."</div>
                        <div class="notif-time">Today 08:15</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ═══════════════ TAB: ATTENDANCE FLAGS ═══════════════ -->
<div id="cptab-flags" class="cptab-content" style="display:none;">
    <div class="dash-grid">
        <div class="dash-panel">
            <div class="panel-header">
                <span><i class="bi bi-flag-fill me-2 text-danger"></i>Submit Attendance Flag</span>
                @if(isReadOnly){<span class="panel-badge" style="background:#ecfdf5;color:#059669;">Read-Only</span>}
            </div>
            <form class="flag-form" onsubmit="submitFlag(event)">
                <div class="mb-3">
                    <label class="form-label fw-semibold">Course / Session</label>
                    <select class="form-select" id="flagCourse" @(isReadOnly?"disabled":"")>
                        <option>CSE301 — Software Engineering · Mon 08:00</option>
                        <option>CSE305 — Database Systems · Tue 10:00</option>
                        <option>CSE310 — HCI · Wed 13:00</option>
                        <option>CSE402 — Software Architecture · Thu 08:00</option>
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">Issue Type</label>
                    <div style="display:flex;flex-direction:column;gap:.5rem;">
                        <label style="display:flex;align-items:center;gap:8px;cursor:pointer;">
                            <input type="radio" name="issue" value="Lecturer Absent" checked @(isReadOnly?"disabled":"") />
                            <span style="background:#fef2f2;color:#dc2626;padding:3px 10px;border-radius:7px;font-size:12px;font-weight:700;">Lecturer Absent</span>
                        </label>
                        <label style="display:flex;align-items:center;gap:8px;cursor:pointer;">
                            <input type="radio" name="issue" value="Class Delayed" @(isReadOnly?"disabled":"") />
                            <span style="background:#fff7ed;color:#ea580c;padding:3px 10px;border-radius:7px;font-size:12px;font-weight:700;">Class Delayed</span>
                        </label>
                        <label style="display:flex;align-items:center;gap:8px;cursor:pointer;">
                            <input type="radio" name="issue" value="Class Cancelled" @(isReadOnly?"disabled":"") />
                            <span style="background:#f5f3ff;color:#7c3aed;padding:3px 10px;border-radius:7px;font-size:12px;font-weight:700;">Class Cancelled</span>
                        </label>
                        <label style="display:flex;align-items:center;gap:8px;cursor:pointer;">
                            <input type="radio" name="issue" value="Lecturer Presented Well" @(isReadOnly?"disabled":"") />
                            <span style="background:#ecfdf5;color:#059669;padding:3px 10px;border-radius:7px;font-size:12px;font-weight:700;">
                                <i class="bi bi-star-fill me-1"></i>Lecturer Presented Well
                            </span>
                            <span style="font-size:11px;color:#6c8097;">— positive feedback</span>
                        </label>
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">
                        Notes / Context
                        <small class="text-muted fw-normal ms-1">— visible to HOD &amp; Director of Quality</small>
                    </label>
                    <textarea class="form-control" id="flagNotes" rows="3"
                              placeholder="Describe what happened — time, number of students, lecturer reason if known…"
                              @(isReadOnly?"readonly":"")></textarea>
                    <div style="font-size:11px;color:#059669;margin-top:3px;">
                        <i class="bi bi-shield-check me-1"></i>Saved and visible to HOD and Director of Quality
                    </div>
                </div>
                @if(!isReadOnly){
                    <button type="submit" class="btn-dash-primary">
                        <i class="bi bi-flag-fill me-2"></i>Submit &amp; Save Flag
                    </button>
                }
            </form>
        </div>
        <div class="dash-panel">
            <div class="panel-header">
                <span><i class="bi bi-journal-text me-2"></i>Saved Flags Log</span>
                <span class="panel-badge">Visible to HOD &amp; Quality</span>
            </div>
            <div id="flagsLog" style="padding:.75rem 1.25rem;display:flex;flex-direction:column;gap:.65rem;">
                <div class="flag-item">
                    <span class="flag-badge badge-absent">Absent</span>
                    <div class="flag-detail" style="flex:1;">
                        <div style="font-size:13px;font-weight:700;">CSE305 · Tue 10:00 <span class="text-muted" style="font-size:11px;font-weight:400;">28 Aug 2026</span></div>
                        <div style="font-size:11px;color:#374151;margin-top:2px;font-style:italic;">"Lecturer absent. 38 students waited 1 hour. No prior notice."</div>
                    </div>
                    <span class="flag-status pending">Pending</span>
                </div>
                <div class="flag-item">
                    <span class="flag-badge badge-late">Delayed</span>
                    <div class="flag-detail" style="flex:1;">
                        <div style="font-size:13px;font-weight:700;">CSE301 · Mon 08:00 <span class="text-muted" style="font-size:11px;font-weight:400;">25 Aug 2026</span></div>
                        <div style="font-size:11px;color:#374151;margin-top:2px;font-style:italic;">"Class started 30 min late. Reason: traffic."</div>
                    </div>
                    <span class="flag-status reviewed">Reviewed</span>
                </div>
                <div class="flag-item">
                    <span style="background:#ecfdf5;color:#059669;font-size:11px;font-weight:700;padding:3px 9px;border-radius:20px;white-space:nowrap;"><i class="bi bi-star-fill me-1"></i>Presented Well</span>
                    <div class="flag-detail" style="flex:1;">
                        <div style="font-size:13px;font-weight:700;">CSE402 · Thu 08:00 <span class="text-muted" style="font-size:11px;font-weight:400;">20 Aug 2026</span></div>
                        <div style="font-size:11px;color:#374151;margin-top:2px;font-style:italic;">"Dr. Habimana covered all topics clearly. Students very engaged."</div>
                    </div>
                    <span style="font-size:11px;font-weight:700;color:#059669;">Recorded</span>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ═══════════════ TAB: SCHEDULE & SIGNATURES ═══════════════ -->
<div id="cptab-schedule" class="cptab-content" style="display:none;">
    <div class="dash-panel">
        <div class="panel-header">
            <span><i class="bi bi-calendar-week-fill me-2"></i>Class Schedule &amp; Course Completion Signatures</span>
            <span class="panel-badge">Semester 1 · 2026</span>
        </div>
        <div style="padding:.5rem 1.25rem .2rem;font-size:12px;color:#6c8097;">
            <i class="bi bi-info-circle me-1"></i>
            The <strong style="color:#059669;">Sign Completion</strong> button appears only when all sessions for a course are done.
        </div>
        <div class="table-responsive">
            <table class="dash-table">
                <thead>
                    <tr><th>Day</th><th>Time</th><th>Course</th><th>Room</th><th>Lecturer</th><th>Progress</th><th>Status</th><th>Signature</th></tr>
                </thead>
                <tbody>
                    <tr>
                        <td>Monday</td><td>08:00–10:00</td>
                        <td><strong>CSE301</strong> Software Engineering</td>
                        <td><span class="room-badge">A204</span></td><td>Dr. J. Mugisha</td>
                        <td><div style="display:flex;align-items:center;gap:5px;"><div style="flex:1;height:6px;background:#e2e8f0;border-radius:4px;overflow:hidden;min-width:50px;"><div style="width:100%;height:100%;background:#22c55e;border-radius:4px;"></div></div><span style="font-size:11px;font-weight:700;color:#15803d;">16/16</span></div></td>
                        <td><span class="sched-badge" style="background:#dcfce7;color:#15803d;">Completed</span></td>
                        <td class="sig-cell"><button class="btn-sign" onclick="signCourse('CSE301','Software Engineering','Dr. J. Mugisha',this)"><i class="bi bi-pen-fill me-1"></i>Sign</button></td>
                    </tr>
                    <tr>
                        <td>Tuesday</td><td>10:00–12:00</td>
                        <td><strong>CSE305</strong> Database Systems</td>
                        <td><span class="room-badge">B101</span></td><td>Mrs. A. Byukusenge</td>
                        <td><div style="display:flex;align-items:center;gap:5px;"><div style="flex:1;height:6px;background:#e2e8f0;border-radius:4px;overflow:hidden;min-width:50px;"><div style="width:68.75%;height:100%;background:#3b82f6;border-radius:4px;"></div></div><span style="font-size:11px;font-weight:700;color:#1d4ed8;">11/16</span></div></td>
                        <td><span class="sched-badge badge-ongoing">Ongoing</span></td>
                        <td class="sig-cell"><span style="font-size:11px;color:#9ca3af;font-style:italic;"><i class="bi bi-hourglass-split me-1"></i>5 sessions left</span></td>
                    </tr>
                    <tr>
                        <td>Wednesday</td><td>13:00–15:00</td>
                        <td><strong>CSE310</strong> HCI</td>
                        <td><span class="room-badge">A108</span></td><td>Mr. E. Niyonsenga</td>
                        <td><div style="display:flex;align-items:center;gap:5px;"><div style="flex:1;height:6px;background:#e2e8f0;border-radius:4px;overflow:hidden;min-width:50px;"><div style="width:56.25%;height:100%;background:#3b82f6;border-radius:4px;"></div></div><span style="font-size:11px;font-weight:700;color:#1d4ed8;">9/16</span></div></td>
                        <td><span class="sched-badge badge-ongoing">Ongoing</span></td>
                        <td class="sig-cell"><span style="font-size:11px;color:#9ca3af;font-style:italic;"><i class="bi bi-hourglass-split me-1"></i>7 sessions left</span></td>
                    </tr>
                    <tr>
                        <td>Thursday</td><td>08:00–10:00</td>
                        <td><strong>CSE402</strong> Software Architecture</td>
                        <td><span class="room-badge">C302</span></td><td>Dr. P. Habimana</td>
                        <td><div style="display:flex;align-items:center;gap:5px;"><div style="flex:1;height:6px;background:#e2e8f0;border-radius:4px;overflow:hidden;min-width:50px;"><div style="width:100%;height:100%;background:#22c55e;border-radius:4px;"></div></div><span style="font-size:11px;font-weight:700;color:#15803d;">16/16</span></div></td>
                        <td><span class="sched-badge" style="background:#dcfce7;color:#15803d;">Completed</span></td>
                        <td class="sig-cell"><span style="display:inline-flex;align-items:center;gap:5px;font-size:11px;font-weight:700;color:#059669;background:#ecfdf5;border:1px solid #bbf7d0;border-radius:8px;padding:4px 10px;"><i class="bi bi-patch-check-fill"></i>Signed <span style="font-size:10px;color:#6c8097;font-weight:400;">25 Aug</span></span></td>
                    </tr>
                </tbody>
            </table>
        </div>
        <div id="signatureLog" style="padding:.5rem 1.25rem 1.25rem;">
            <div style="font-size:11px;font-weight:800;color:#6c8097;text-transform:uppercase;letter-spacing:.07em;margin-bottom:.5rem;"><i class="bi bi-pen me-1"></i>Signature Records</div>
            <div style="background:#ecfdf5;border:1px solid #bbf7d0;border-radius:10px;padding:.7rem 1rem;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:.5rem;">
                <div>
                    <div style="font-size:13px;font-weight:700;color:#065f46;"><i class="bi bi-patch-check-fill me-2 text-success"></i>CSE402 — Software Architecture</div>
                    <div style="font-size:11px;color:#6c8097;margin-top:2px;">Signed: Bob Nkurunziza · 25 Aug 2026 · Lecturer: Dr. P. Habimana</div>
                </div>
                <span style="font-size:11px;font-weight:700;color:#059669;background:#fff;border:1px solid #bbf7d0;border-radius:7px;padding:3px 10px;">Verified ✓</span>
            </div>
        </div>
    </div>
</div>

<!-- ═══════════════ TAB: ALL CIS CLASS REPRESENTATIVES ═══════════════ -->
<div id="cptab-allcps" class="cptab-content" style="display:none;">
    <div class="dash-panel">
        <div class="panel-header">
            <span><i class="bi bi-people-fill me-2" style="color:#7c3aed;"></i>All Class Representatives — CIS Department, UNILAK</span>
            @if(!isReadOnly){
                <button class="btn-dash-primary" onclick="openCPModal()">
                    <i class="bi bi-plus-lg me-1"></i>Add CP
                </button>
            }
        </div>

        <!-- Search & filter -->
        <div style="padding:.75rem 1.25rem;border-bottom:1px solid #e2e8f0;display:flex;gap:.65rem;flex-wrap:wrap;">
            <input type="text" id="cpSearch" placeholder="Search name, reg no, course…" oninput="filterCPs()"
                   style="border:1.5px solid #e2e8f0;border-radius:8px;padding:.45rem .9rem;font-size:13px;outline:none;flex:1;min-width:160px;" />
            <select id="cpYearF" onchange="filterCPs()" style="border:1.5px solid #e2e8f0;border-radius:8px;padding:.45rem .7rem;font-size:13px;outline:none;">
                <option value="">All Years</option>
                <option>Year 1</option><option>Year 2</option><option>Year 3</option><option>Year 4</option>
            </select>
            <select id="cpSessF" onchange="filterCPs()" style="border:1.5px solid #e2e8f0;border-radius:8px;padding:.45rem .7rem;font-size:13px;outline:none;">
                <option value="">All Sessions</option>
                <option>Day</option><option>Evening</option><option>Weekend</option>
            </select>
        </div>

        <div class="table-responsive">
            <table class="dash-table" id="cpTable">
                <thead>
                    <tr>
                        <th>#</th><th>Full Name</th><th>Reg. No</th><th>Phone</th>
                        <th>Nationality</th><th>Dept.</th><th>Intake</th>
                        <th>Year</th><th>Session</th><th>Courses</th>
                        @if(!isReadOnly){<th>Actions</th>}
                    </tr>
                </thead>
                <tbody id="cpTbody">
                    <tr data-yr="Year 3" data-sess="Day">
                        <td>1</td>
                        <td><div style="display:flex;align-items:center;gap:7px;"><div style="width:30px;height:30px;border-radius:50%;background:#7c3aed;display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:800;color:#fff;flex-shrink:0;">B</div><div><div style="font-weight:700;font-size:13px;">Bob Nkurunziza</div><div style="font-size:10px;color:#1556c8;font-weight:600;">● You</div></div></div></td>
                        <td>CP001</td><td>+250 788 123 456</td><td>Rwandan</td><td>CIS</td><td>2023-S1</td>
                        <td><span class="session-badge">Year 3</span></td><td><span class="session-badge">Day</span></td>
                        <td style="font-size:12px;">CSE301, CSE305</td>
                        @if(!isReadOnly){<td class="action-btns"><button class="btn-icon btn-edit" onclick="editCP(this)" title="Edit"><i class="bi bi-pencil-fill"></i></button></td>}
                    </tr>
                    <tr data-yr="Year 1" data-sess="Day">
                        <td>2</td>
                        <td><div style="display:flex;align-items:center;gap:7px;"><div style="width:30px;height:30px;border-radius:50%;background:#1556c8;display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:800;color:#fff;flex-shrink:0;">A</div><div style="font-weight:700;font-size:13px;">Alice Uwimana</div></div></td>
                        <td>CP002</td><td>+250 722 345 678</td><td>Rwandan</td><td>CIS</td><td>2025-S1</td>
                        <td><span class="session-badge">Year 1</span></td><td><span class="session-badge">Day</span></td>
                        <td style="font-size:12px;">CSC101, ENG101</td>
                        @if(!isReadOnly){<td class="action-btns"><button class="btn-icon btn-edit" onclick="editCP(this)" title="Edit"><i class="bi bi-pencil-fill"></i></button><button class="btn-icon btn-del" onclick="removeCP(this)" title="Remove"><i class="bi bi-trash-fill"></i></button></td>}
                    </tr>
