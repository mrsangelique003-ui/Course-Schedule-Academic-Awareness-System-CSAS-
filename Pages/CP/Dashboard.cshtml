@page
@model CourseScheduleSystem.Web.Pages.CP.DashboardModel

@{
    Layout = "/Pages/Shared/_CPLayout.cshtml";
    ViewData["Title"] = "CP Dashboard";
}

<div class="container-fluid py-2">

    <!-- ── PAGE HEADER ── -->
    <div class="cp-page-header">
        <div>
            <h1 class="cp-page-header-title">Class Representative Dashboard</h1>
            @if (Model.CurrentCp != null)
            {
                <p class="cp-page-header-sub">
                    <span>Welcome back,&nbsp;<strong>@Model.CurrentCp.FullName</strong></span>
                    <span class="cp-badge">
                        <i class="bi bi-person-badge-fill"></i>
                        Class Representative
                    </span>
                </p>
            }
        </div>
        <div class="cp-page-header-date">
            <i class="bi bi-calendar3"></i>
            <span>@DateTime.Now.ToString("dddd, MMMM d, yyyy")</span>
        </div>
    </div>


    <!-- ── STAT CARDS ── -->
    <div class="row g-3 g-md-4">

        <!-- Represented Courses -->
        <div class="col-6 col-xl-3">
            <div class="card cp-stat-card cp-stat-card--courses">
                <div class="card-body">
                    <div class="cp-stat-card-top">
                        <div>
                            <p class="cp-stat-label">Represented Courses</p>
                            <p class="cp-stat-value">@Model.TotalCourses</p>
                        </div>
                        <div class="cp-stat-icon cp-stat-icon--courses">
                            <i class="bi bi-journal-bookmark-fill"></i>
                        </div>
                    </div>
                    <div class="cp-stat-footer">
                        <i class="bi bi-info-circle"></i>
                        <span>Courses you represent</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Active Class Groups -->
        <div class="col-6 col-xl-3">
            <div class="card cp-stat-card cp-stat-card--groups">
                <div class="card-body">
                    <div class="cp-stat-card-top">
                        <div>
                            <p class="cp-stat-label">Active Class Groups</p>
                            <p class="cp-stat-value">@Model.TotalGroups</p>
                        </div>
                        <div class="cp-stat-icon cp-stat-icon--groups">
                            <i class="bi bi-people-fill"></i>
                        </div>
                    </div>
                    <div class="cp-stat-footer">
                        <i class="bi bi-circle-fill" style="color:#14b8a6; font-size:8px;"></i>
                        <span>Currently active</span>
                        <a asp-page="/CP/ClassGroups/ClassGroups" class="cp-stat-footer-link">
                            View <i class="bi bi-arrow-right"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Pending Sign-Off -->
        <div class="col-6 col-xl-3">
            <div class="card cp-stat-card cp-stat-card--signoff">
                <div class="card-body">
                    <div class="cp-stat-card-top">
                        <div>
                            <p class="cp-stat-label">Pending Sign-Off</p>
                            <p class="cp-stat-value">@Model.PendingCompletions</p>
                        </div>
                        <div class="cp-stat-icon cp-stat-icon--signoff">
                            <i class="bi bi-clipboard2-check-fill"></i>
                        </div>
                    </div>
                    <div class="cp-stat-footer">
                        @if (Model.PendingCompletions > 0)
                        {
                            <i class="bi bi-exclamation-circle" style="color:#b45309;"></i>
                            <span>Awaiting your review</span>
                        }
                        else
                        {
                            <i class="bi bi-check-circle" style="color:#0f766e;"></i>
                            <span>All up to date</span>
                        }
                        <a asp-page="/CP/SignOff" class="cp-stat-footer-link">
                            View <i class="bi bi-arrow-right"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Unread Messages -->
        <div class="col-6 col-xl-3">
            <div class="card cp-stat-card cp-stat-card--messages">
                <div class="card-body">
                    <div class="cp-stat-card-top">
                        <div>
                            <p class="cp-stat-label">Unread Messages</p>
                            <p class="cp-stat-value">@Model.UnreadMessages</p>
                        </div>
                        <div class="cp-stat-icon cp-stat-icon--messages">
                            <i class="bi bi-chat-dots-fill"></i>
                        </div>
                    </div>
                    <div class="cp-stat-footer">
                        @if (Model.UnreadMessages > 0)
                        {
                            <i class="bi bi-bell-fill" style="color:#7c3aed; font-size:11px;"></i>
                            <span>New from HOD</span>
                        }
                        else
                        {
                            <i class="bi bi-check-circle" style="color:#0f766e;"></i>
                            <span>No new messages</span>
                        }
                        <a asp-page="/CP/Chat" class="cp-stat-footer-link">
                            Open <i class="bi bi-arrow-right"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>

    </div>


    <!-- ── QUICK ACTIONS SECTION ── -->
    <div class="cp-section-divider">
        <span class="cp-section-divider-title">Quick Actions</span>
        <span class="cp-section-divider-line"></span>
    </div>

    <div class="row g-3 g-md-4">

        <!-- Class Groups -->
        <div class="col-md-6">
            <div class="card cp-action-card">
                <div class="card-body">
                    <div class="cp-action-card-icon-wrap cp-action-card-icon--groups">
                        <i class="bi bi-people-fill"></i>
                    </div>
                    <h5 class="cp-action-card-title">Class Groups</h5>
                    <p class="cp-action-card-desc">
                        Create and manage your class communication groups. Keep students organised and informed.
                    </p>
                    <a asp-page="/CP/ClassGroups/ClassGroups"
                       class="cp-action-card-btn cp-action-btn--primary">
                        <i class="bi bi-people"></i>
                        Manage Groups
                    </a>
                </div>
            </div>
        </div>

        <!-- Course Sign-Off -->
        <div class="col-md-6">
            <div class="card cp-action-card">
                <div class="card-body">
                    <div class="cp-action-card-icon-wrap cp-action-card-icon--signoff">
                        <i class="bi bi-clipboard2-check-fill"></i>
                    </div>
                    <h5 class="cp-action-card-title">Course Sign-Off</h5>
                    <p class="cp-action-card-desc">
                        Review and submit course completion details. Confirm lectures are delivered as planned.
                    </p>
                    <a asp-page="/CP/SignOff"
                       class="cp-action-card-btn cp-action-btn--amber">
                        <i class="bi bi-check2-square"></i>
                        View Sign-Off
                    </a>
                </div>
            </div>
        </div>

    </div>


    <!-- ── CIS CLASS REPRESENTATIVES LIST ── -->
    <div class="cp-section-divider mt-4">
        <span class="cp-section-divider-title">CIS Class Representatives</span>
        <span class="cp-section-divider-line"></span>
        <a asp-page="/CP/CisCps/CisCps" class="cp-stat-footer-link" style="white-space:nowrap; font-size:12px;">
            View all
        </a>
    </div>

    @if (!Model.CisReps.Any())
    {
        <p style="color:var(--text-muted); font-size:13px;">No active CIS representatives found.</p>
    }
    else
    {
        <div class="cg-list">

            <!-- Header -->
            <div class="cp-list-header">
                <div class="cp-list-hcol cp-lc-name">Name</div>
                <div class="cp-list-hcol cp-lc-dept">Department</div>
                <div class="cp-list-hcol cp-lc-intake">Intake</div>
                <div class="cp-list-hcol cp-lc-level">Level</div>
                <div class="cp-list-hcol cp-lc-nat">Nationality</div>
                <div class="cp-list-hcol cp-lc-phone">Phone</div>
            </div>

            @foreach (var rep in Model.CisReps)
            {
                var initials = string.Concat(
                    rep.FullName.Split(' ', StringSplitOptions.RemoveEmptyEntries)
                                .Take(2)
                                .Select(p => char.ToUpper(p[0])));

                <div class="cp-list-row">

                    <div class="cp-lc-name">
                        <div class="cp-list-avatar">@initials</div>
                        <div>
                            <div class="cp-list-name">@rep.FullName</div>
                            <div class="cp-list-regno">@rep.RegNo</div>
                        </div>
                    </div>

                    <div class="cp-lc-dept">
                        <span class="cp-list-text">@rep.Department</span>
                    </div>

                    <div class="cp-lc-intake">
                        <span class="cp-list-text">@rep.Intake</span>
                    </div>

                    <div class="cp-lc-level">
                        <span class="cp-list-text">@rep.Level</span>
                    </div>

                    <div class="cp-lc-nat">
                        <span class="cp-list-text">
                            @(string.IsNullOrWhiteSpace(rep.Nationality) ? "—" : rep.Nationality)
                        </span>
                    </div>

                    <div class="cp-lc-phone">
                        @if (!string.IsNullOrWhiteSpace(rep.PhoneNumber))
                        {
                            <a href="tel:@rep.PhoneNumber" class="cp-list-phone-link">
                                <i class="bi bi-telephone"></i>
                                @rep.PhoneNumber
                            </a>
                        }
                        else
                        {
                            <span class="cp-list-text" style="color:var(--text-light);font-style:italic;">Not set</span>
                        }
                    </div>

                </div>
            }

        </div>
    }

</div>
