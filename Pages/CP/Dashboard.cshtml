@page
@model CourseScheduleSystem.Web.Pages.CP.DashboardModel
@{
    ViewData["Title"] = "Class Representative Dashboard";
    Layout = "~/Pages/Shared/_DashboardLayout.cshtml";
    ViewData["ActiveNav"] = "home";
    ViewData["Role"] = "CP";
    ViewData["UserName"] = User.Identity?.Name ?? "CP";

    // Director of Quality, Dean, HOD get read-only view
    bool isReadOnly = User.IsInRole("DirectorOfQuality") || User.IsInRole("Dean") || User.IsInRole("HOD");
    string viewerRole = isReadOnly
        ? (User.IsInRole("DirectorOfQuality") ? "Director of Quality" : "Dean / HOD")
        : "Class Representative";
}

@* ── READ-ONLY BANNER (visible to Director of Quality / HOD / Dean) ── *@
@if (isReadOnly)
{
    <div style="background:linear-gradient(135deg,#059669,#047857);color:#fff;
                border-radius:12px;padding:1rem 1.5rem;margin-bottom:1.5rem;
                display:flex;align-items:center;gap:12px;">
        <i class="bi bi-eye-fill" style="font-size:22px;flex-shrink:0;"></i>
        <div>
            <div style="font-weight:800;font-size:14px;">Read-Only View — @viewerRole</div>
            <div style="font-size:12px;opacity:.85;">
                You are viewing the Class Representative dashboard in read-only mode.
                All flags, notes, and actions submitted by the CP are visible here.
            </div>
        </div>
    </div>
}

<!-- ── WELCOME ─────────────────────────────────────────────────────── -->
<div class="dash-welcome">
    <div>
        <h2 class="dash-heading">Class Representative Dashboard</h2>
        <p class="dash-subheading">@DateTime.Now.ToString("dddd, dd MMMM yyyy") · CIS Department</p>
    </div>
    <div class="dash-welcome-badge" style="background:rgba(124,58,237,.15);color:#7c3aed;">
        <i class="bi bi-person-badge-fill"></i> @viewerRole
    </div>
</div>

<!-- ── STAT CARDS ───────────────────────────────────────────────────── -->
<div class="dash-stats">
    <div class="stat-card stat-blue">
        <div class="stat-icon"><i class="bi bi-people-fill"></i></div>
        <div class="stat-info"><span class="stat-val">42</span><span class="stat-label">Class Members</span></div>
    </div>
    <div class="stat-card stat-orange">
        <div class="stat-icon"><i class="bi bi-flag-fill"></i></div>
        <div class="stat-info"><span class="stat-val">3</span><span class="stat-label">Pending Flags</span></div>
    </div>
    <div class="stat-card stat-purple">
        <div class="stat-icon"><i class="bi bi-arrow-left-right"></i></div>
        <div class="stat-info"><span class="stat-val">1</span><span class="stat-label">Room Swap Requests</span></div>
    </div>
    <div class="stat-card stat-green">
        <div class="stat-icon"><i class="bi bi-megaphone-fill"></i></div>
        <div class="stat-info"><span class="stat-val">5</span><span class="stat-label">Announcements Sent</span></div>
    </div>
</div>

<!-- ════════════════════════════════════════════════════════════════════
     SECTION 1: CP PROFILE DETAILS
════════════════════════════════════════════════════════════════════ -->
<div class="dash-panel mb-4">
    <div class="panel-header" style="background:linear-gradient(135deg,#7c3aed,#6d28d9);color:#fff;border-radius:13px 13px 0 0;">
        <span style="display:flex;align-items:center;gap:10px;">
            <span style="width:36px;height:36px;background:rgba(255,255,255,.15);border-radius:50%;
                         display:flex;align-items:center;justify-content:center;font-size:18px;">
                <i class="bi bi-person-vcard-fill"></i>
            </span>
            <div>
                <div style="font-size:14px;font-weight:800;">Class Representative Profile</div>
                <div style="font-size:11px;opacity:.75;">Official CP details visible to HOD, Director of Quality and Dean</div>
            </div>
        </span>
        @if (!isReadOnly)
        {
            <button onclick="toggleEditProfile()"
                    style="background:rgba(255,255,255,.2);border:1px solid rgba(255,255,255,.3);
                           color:#fff;border-radius:8px;padding:5px 14px;font-size:12px;font-weight:700;cursor:pointer;">
                <i class="bi bi-pencil-fill me-1"></i> Edit Profile
            </button>
        }
    </div>

    <div style="padding:1.25rem;">
        <!-- VIEW mode -->
        <div id="profileView" style="display:grid;grid-template-columns:repeat(3,1fr);gap:1rem;">
            <div style="background:#f8fafc;border:1px solid #e2e8f0;border-radius:10px;padding:.85rem 1rem;">
                <div style="font-size:10px;font-weight:800;color:#6c8097;text-transform:uppercase;letter-spacing:.07em;margin-bottom:4px;">Full Name</div>
                <div style="font-size:14px;font-weight:700;color:#142d4d;" id="pv-name">Bob Nkurunziza</div>
            </div>
            <div style="background:#f8fafc;border:1px solid #e2e8f0;border-radius:10px;padding:.85rem 1rem;">
                <div style="font-size:10px;font-weight:800;color:#6c8097;text-transform:uppercase;letter-spacing:.07em;margin-bottom:4px;">Phone Number</div>
                <div style="font-size:14px;font-weight:700;color:#142d4d;" id="pv-phone">+250 788 123 456</div>
            </div>
            <div style="background:#f8fafc;border:1px solid #e2e8f0;border-radius:10px;padding:.85rem 1rem;">
                <div style="font-size:10px;font-weight:800;color:#6c8097;text-transform:uppercase;letter-spacing:.07em;margin-bottom:4px;">Nationality</div>
                <div style="font-size:14px;font-weight:700;color:#142d4d;" id="pv-nationality">Rwandan</div>
            </div>
            <div style="background:#f8fafc;border:1px solid #e2e8f0;border-radius:10px;padding:.85rem 1rem;">
                <div style="font-size:10px;font-weight:800;color:#6c8097;text-transform:uppercase;letter-spacing:.07em;margin-bottom:4px;">Department</div>
                <div style="font-size:14px;font-weight:700;color:#142d4d;" id="pv-dept">Computer Information Systems (CIS)</div>
            </div>
            <div style="background:#f8fafc;border:1px solid #e2e8f0;border-radius:10px;padding:.85rem 1rem;">
                <div style="font-size:10px;font-weight:800;color:#6c8097;text-transform:uppercase;letter-spacing:.07em;margin-bottom:4px;">Intake / Cohort</div>
                <div style="font-size:14px;font-weight:700;color:#142d4d;" id="pv-intake">2023 — Semester 1</div>
            </div>
            <div style="background:#f8fafc;border:1px solid #e2e8f0;border-radius:10px;padding:.85rem 1rem;">
                <div style="font-size:10px;font-weight:800;color:#6c8097;text-transform:uppercase;letter-spacing:.07em;margin-bottom:4px;">Academic Year</div>
                <div style="font-size:14px;font-weight:700;color:#142d4d;" id="pv-year">Year 3</div>
            </div>
            <div style="background:#f8fafc;border:1px solid #e2e8f0;border-radius:10px;padding:.85rem 1rem;">
                <div style="font-size:10px;font-weight:800;color:#6c8097;text-transform:uppercase;letter-spacing:.07em;margin-bottom:4px;">Study Session</div>
                <div style="font-size:14px;font-weight:700;color:#142d4d;" id="pv-session">Day</div>
            </div>
            <div style="background:#f8fafc;border:1px solid #e2e8f0;border-radius:10px;padding:.85rem 1rem;">
                <div style="font-size:10px;font-weight:800;color:#6c8097;text-transform:uppercase;letter-spacing:.07em;margin-bottom:4px;">Reg. Number</div>
                <div style="font-size:14px;font-weight:700;color:#142d4d;" id="pv-regno">CP001</div>
            </div>
            <div style="background:#eff6ff;border:1px solid #bfdbfe;border-radius:10px;padding:.85rem 1rem;">
                <div style="font-size:10px;font-weight:800;color:#1556c8;text-transform:uppercase;letter-spacing:.07em;margin-bottom:4px;">Role</div>
                <div style="font-size:14px;font-weight:700;color:#1556c8;">
                    <i class="bi bi-person-badge-fill me-1"></i>Class Representative
                </div>
            </div>
        </div>

        <!-- EDIT mode (CP only) -->
        @if (!isReadOnly)
        {
            <div id="profileEdit" style="display:none;margin-top:1rem;">
                <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:1rem;">
                    <div>
                        <label class="form-label fw-semibold" style="font-size:12px;">Full Name</label>
                        <input type="text" id="pe-name" class="form-control" value="Bob Nkurunziza" />
                    </div>
                    <div>
                        <label class="form-label fw-semibold" style="font-size:12px;">Phone Number</label>
                        <input type="tel" id="pe-phone" class="form-control" value="+250 788 123 456" />
                    </div>
                    <div>
                        <label class="form-label fw-semibold" style="font-size:12px;">Nationality</label>
                        <input type="text" id="pe-nationality" class="form-control" value="Rwandan" />
                    </div>
                    <div>
                        <label class="form-label fw-semibold" style="font-size:12px;">Department</label>
                        <input type="text" id="pe-dept" class="form-control" value="Computer Information Systems (CIS)" />
                    </div>
                    <div>
                        <label class="form-label fw-semibold" style="font-size:12px;">Intake / Cohort</label>
                        <input type="text" id="pe-intake" class="form-control" value="2023 — Semester 1" />
                    </div>
                    <div>
                        <label class="form-label fw-semibold" style="font-size:12px;">Academic Year</label>
                        <select id="pe-year" class="form-select">
                            <option>Year 1</option><option>Year 2</option>
                            <option selected>Year 3</option><option>Year 4</option>
                        </select>
                    </div>
                    <div>
                        <label class="form-label fw-semibold" style="font-size:12px;">Study Session</label>
                        <select id="pe-session" class="form-select">
                            <option selected>Day</option>
                            <option>Evening</option><option>Weekend</option>
                        </select>
                    </div>
                </div>
                <div style="display:flex;gap:.75rem;margin-top:1rem;">
                    <button onclick="saveProfile()" class="btn-dash-primary">
                        <i class="bi bi-check-lg me-1"></i>Save Profile
                    </button>
                    <button onclick="toggleEditProfile()" class="btn-dash-cancel">Cancel</button>
                </div>
            </div>
        }
    </div>
</div>

<!-- ════════════════════════════════════════════════════════════════════
     SECTION 2: ATTENDANCE FLAGS + ROOM SWAP + ANNOUNCEMENTS
════════════════════════════════════════════════════════════════════ -->
<div class="dash-grid">

    <!-- ATTENDANCE FLAGGING -->
    <div class="dash-panel">
        <div class="panel-header">
            <span><i class="bi bi-flag-fill me-2 text-danger"></i>Flag Attendance Issue</span>
            @if (isReadOnly)
            {
                <span class="panel-badge" style="background:#ecfdf5;color:#059669;border:1px solid #bbf7d0;">
                    <i class="bi bi-eye-fill me-1"></i>Read-Only
                </span>
            }
        </div>
        <form class="flag-form" id="flagForm" onsubmit="submitFlag(event)">
            <div class="mb-3">
                <label class="form-label fw-semibold">Course / Session</label>
                <select class="form-select" id="flagCourse" @(isReadOnly ? "disabled" : "")>
                    <option>CSE301 — Software Engineering · Mon 08:00</option>
                    <option>CSE305 — Database Systems · Tue 10:00</option>
                    <option>CSE310 — HCI · Wed 13:00</option>
                    <option>CSE402 — Software Architecture · Thu 08:00</option>
                </select>
            </div>
            <div class="mb-3">
                <label class="form-label fw-semibold">Issue Type</label>
                <div class="d-flex gap-3">
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="issue" id="absent" value="Absent" checked @(isReadOnly ? "disabled" : "") />
                        <label class="form-check-label" for="absent">Lecturer Absent</label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="issue" id="late" value="Late" @(isReadOnly ? "disabled" : "") />
                        <label class="form-check-label" for="late">Class Delayed</label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="issue" id="cancelled" value="Cancelled" @(isReadOnly ? "disabled" : "") />
                        <label class="form-check-label" for="cancelled">Cancelled</label>
                    </div>
                </div>
            </div>
            <div class="mb-3">
                <label class="form-label fw-semibold">
                    Notes / Context
                    <span style="font-size:10px;color:#6c8097;font-weight:400;margin-left:6px;">
                        (saved and visible to HOD &amp; Director of Quality)
                    </span>
                </label>
                <textarea class="form-control" id="flagNotes" rows="3"
                          placeholder="Describe what happened in detail — time, number of students present, lecturer reason if known…"
                          @(isReadOnly ? "readonly" : "")></textarea>
                <div style="font-size:11px;color:#6c8097;margin-top:4px;">
                    <i class="bi bi-shield-check me-1 text-success"></i>
                    These notes are saved and visible to HOD and Director of Quality for review.
                </div>
            </div>
            @if (!isReadOnly)
            {
                <button type="submit" class="btn-dash-primary">
                    <i class="bi bi-flag-fill me-2"></i>Submit &amp; Save Flag
                </button>
            }
        </form>

        <!-- Saved Flags Log (visible to all) -->
        <div class="mt-3" id="flagsLog">
            <div style="font-size:11px;font-weight:800;color:#6c8097;text-transform:uppercase;
                        letter-spacing:.07em;padding:.5rem 0 .35rem;">
                <i class="bi bi-journal-text me-1"></i>Saved Flags — Visible to HOD &amp; Director of Quality
            </div>

            <div class="flag-item" data-course="CSE305" data-type="Absent"
                 data-notes="Lecturer did not show up at all. 38 students waited for 1 hour. No prior notice was given."
                 data-date="28 Aug 2026" data-status="pending">
                <span class="flag-badge badge-absent">Absent</span>
                <div class="flag-detail" style="flex:1;">
                    <div>CSE305 — Tue 10:00 · <span class="text-muted" style="font-size:11px;">28 Aug 2026</span></div>
                    <div style="font-size:11px;color:#374151;margin-top:3px;font-style:italic;">
                        "Lecturer did not show up at all. 38 students waited for 1 hour. No prior notice was given."
                    </div>
                </div>
                <span class="flag-status pending">Pending</span>
            </div>

            <div class="flag-item" data-course="CSE301" data-type="Delayed"
                 data-notes="Class started 30 minutes late. Lecturer arrived at 08:32. Reason given: traffic."
                 data-date="25 Aug 2026" data-status="reviewed">
                <span class="flag-badge badge-late">Delayed</span>
                <div class="flag-detail" style="flex:1;">
                    <div>CSE301 — Mon 08:00 · <span class="text-muted" style="font-size:11px;">25 Aug 2026</span></div>
                    <div style="font-size:11px;color:#374151;margin-top:3px;font-style:italic;">
                        "Class started 30 minutes late. Lecturer arrived at 08:32. Reason given: traffic."
                    </div>
                </div>
                <span class="flag-status reviewed">Reviewed</span>
            </div>
        </div>
    </div>

    <!-- ROOM SWAP + ANNOUNCEMENTS -->
    <div>
        <!-- Room swap -->
        <div class="dash-panel mb-4">
            <div class="panel-header">
                <span><i class="bi bi-arrow-left-right me-2"></i>Request Room Swap</span>
                @if (isReadOnly)
                {
                    <span class="panel-badge" style="background:#ecfdf5;color:#059669;border:1px solid #bbf7d0;">
                        <i class="bi bi-eye-fill me-1"></i>Read-Only
                    </span>
                }
            </div>
            <form class="flag-form">
                <div class="mb-3">
                    <label class="form-label fw-semibold">Affected Session</label>
                    <select class="form-select" @(isReadOnly ? "disabled" : "")>
                        <option>CSE301 — Mon 08:00 · Room A204</option>
                        <option>CSE305 — Tue 10:00 · Room B101</option>
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">Preferred Room</label>
                    <select class="form-select" @(isReadOnly ? "disabled" : "")>
                        <option>Lab 01 — Block D (Cap: 30)</option>
                        <option>Room C302 — Block C (Cap: 50)</option>
                        <option>Room A108 — Block A (Cap: 40)</option>
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">Reason</label>
                    <textarea class="form-control" rows="2"
                              placeholder="Why is the swap needed?"
                              @(isReadOnly ? "readonly" : "")></textarea>
                </div>
                @if (!isReadOnly)
                {
                    <button type="submit" class="btn-dash-secondary">
                        <i class="bi bi-arrow-left-right me-2"></i>Submit Request
                    </button>
                }
            </form>
        </div>

        <!-- Post announcement -->
        <div class="dash-panel">
            <div class="panel-header">
                <span><i class="bi bi-megaphone-fill me-2"></i>Post Announcement</span>
                @if (isReadOnly)
                {
                    <span class="panel-badge" style="background:#ecfdf5;color:#059669;border:1px solid #bbf7d0;">
                        <i class="bi bi-eye-fill me-1"></i>Read-Only
                    </span>
                }
            </div>
            <form class="flag-form">
                <div class="mb-3">
                    <label class="form-label fw-semibold">Class / Course</label>
                    <select class="form-select" @(isReadOnly ? "disabled" : "")>
                        <option>All my classes</option>
                        <option>CSE301 — Software Engineering</option>
                        <option>CSE305 — Database Systems</option>
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">Announcement</label>
                    <textarea class="form-control" rows="3"
                              placeholder="Write your announcement…"
                              @(isReadOnly ? "readonly" : "")></textarea>
                </div>
                @if (!isReadOnly)
                {
                    <button type="submit" class="btn-dash-primary">
                        <i class="bi bi-send-fill me-2"></i>Post Announcement
                    </button>
                }
            </form>
        </div>
    </div>
</div>

<!-- ════════════════════════════════════════════════════════════════════
     SECTION 3: HOD ENROLLMENT INFO
════════════════════════════════════════════════════════════════════ -->
<div class="dash-panel mt-4">
    <div class="panel-header" style="background:linear-gradient(135deg,#1e3a8a,#1556c8);color:#fff;border-radius:13px 13px 0 0;">
        <span style="display:flex;align-items:center;gap:10px;">
            <span style="width:36px;height:36px;background:rgba(255,255,255,.15);border-radius:50%;
                         display:flex;align-items:center;justify-content:center;font-size:17px;">
                <i class="bi bi-info-circle-fill"></i>
            </span>
            <div>
                <div style="font-size:14px;font-weight:800;">Course Enrollment — Managed by HOD</div>
                <div style="font-size:11px;opacity:.75;">Student enrollments are handled by the HOD through UmurongoSmart</div>
            </div>
        </span>
    </div>
    <div style="padding:1.5rem 1.25rem;">
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:1.25rem;">
            <div style="background:#eff6ff;border:1px solid #bfdbfe;border-radius:12px;padding:1.25rem;">
                <div style="display:flex;align-items:center;gap:10px;margin-bottom:.75rem;">
                    <span style="width:40px;height:40px;background:#1556c8;border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:18px;color:#fff;flex-shrink:0;">
                        <i class="bi bi-person-workspace"></i>
                    </span>
                    <div>
                        <div style="font-size:13px;font-weight:800;color:#142d4d;">HOD Responsibility</div>
                        <div style="font-size:11px;color:#6c8097;">Enrollment is not a CP function</div>
                    </div>
                </div>
                <p style="font-size:13px;color:#1e3a8a;line-height:1.7;margin:0;">
                    Course enrollment for all students is managed exclusively by the
                    <strong>HOD</strong> through the UmurongoSmart portal.
                </p>
            </div>
            <div style="background:#ecfdf5;border:1px solid #bbf7d0;border-radius:12px;padding:1.25rem;">
                <div style="display:flex;align-items:center;gap:10px;margin-bottom:.75rem;">
                    <span style="width:40px;height:40px;background:#059669;border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:18px;color:#fff;flex-shrink:0;">
                        <i class="bi bi-person-badge-fill"></i>
                    </span>
                    <div>
                        <div style="font-size:13px;font-weight:800;color:#142d4d;">What You Can Do as CP</div>
                        <div style="font-size:11px;color:#6c8097;">Your actual responsibilities</div>
                    </div>
                </div>
                <ul style="font-size:13px;color:#065f46;line-height:2;margin:0;padding-left:1.25rem;">
                    <li>Flag lecturer attendance issues</li>
                    <li>Request room swaps for your class</li>
                    <li>Post announcements to classmates</li>
                    <li>Escalate student concerns to HOD</li>
                </ul>
            </div>
        </div>
        <div style="margin-top:1.25rem;padding:1rem 1.25rem;background:#fef9c3;border:1px solid #fde68a;border-radius:12px;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:1rem;">
            <div>
                <div style="font-size:13px;font-weight:800;color:#92400e;margin-bottom:.25rem;">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>Need to escalate an enrollment issue?
                </div>
                <div style="font-size:12px;color:#78350f;">
                    Direct students with enrollment problems to contact the HOD through UmurongoSmart.
                </div>
            </div>
            <a href="https://umurongosmart.com" target="_blank"
               style="display:inline-flex;align-items:center;gap:8px;background:#142d4d;color:#fff;text-decoration:none;border-radius:9px;padding:.65rem 1.25rem;font-size:13px;font-weight:700;white-space:nowrap;">
                <i class="bi bi-box-arrow-up-right"></i> Open UmurongoSmart
            </a>
        </div>
    </div>
</div>

<!-- ════════════════════════════════════════════════════════════════════
     SECTION 4: CLASS SCHEDULE + COURSE COMPLETION SIGNATURE
     Signature button appears only when a course's scheduled days are done
════════════════════════════════════════════════════════════════════ -->
<div class="dash-panel mt-4">
    <div class="panel-header">
        <span><i class="bi bi-calendar-week-fill me-2"></i>My Class Schedule &amp; Course Completion</span>
        <span class="panel-badge">Semester 1 · 2026</span>
    </div>

    <div style="padding:.6rem 1.25rem .3rem;font-size:12px;color:#6c8097;">
        <i class="bi bi-info-circle me-1"></i>
        The <strong style="color:#059669;">Sign Completion</strong> button appears automatically
        when a course's scheduled sessions are finished.
        Your signature confirms to the lecturer that the course was delivered.
    </div>

    <div class="table-responsive">
        <table class="dash-table" id="scheduleTable">
            <thead>
                <tr>
                    <th>Day</th>
                    <th>Time</th>
                    <th>Course</th>
                    <th>Room</th>
                    <th>Lecturer</th>
                    <th>Progress</th>
                    <th>Status</th>
                    <th>CP Signature</th>
                </tr>
            </thead>
            <tbody>
                <!-- Course data: data-total=total sessions, data-done=completed sessions, data-enddate=end date -->
                <tr data-course="CSE301" data-total="16" data-done="16"
                    data-enddate="2026-08-28" data-signed="false">
                    <td>Monday</td>
                    <td>08:00–10:00</td>
