@page
@model CourseScheduleSystem.Web.Pages.CP.DashboardModel
@{
    ViewData["Title"] = "Class Representative Dashboard";
    Layout = "~/Pages/Shared/_DashboardLayout.cshtml";
    ViewData["ActiveNav"] = "home";
    ViewData["Role"] = "CP";
    ViewData["UserName"] = User.Identity?.Name ?? "CP";
}

<div class="dash-welcome">
    <div>
        <h2 class="dash-heading">Class Representative Dashboard</h2>
        <p class="dash-subheading">@DateTime.Now.ToString("dddd, dd MMMM yyyy") · CIS Department</p>
    </div>
    <div class="dash-welcome-badge" style="background:rgba(124,58,237,.15);color:#7c3aed;">
        <i class="bi bi-person-badge-fill"></i> Class Representative
    </div>
</div>

<div class="dash-stats">
    <div class="stat-card stat-blue">
        <div class="stat-icon"><i class="bi bi-people-fill"></i></div>
        <div class="stat-info"><span class="stat-val">42</span><span class="stat-label">Class Members</span></div>
    </div>
    <div class="stat-card stat-orange">
        <div class="stat-icon"><i class="bi bi-flag-fill"></i></div>
        <div class="stat-info"><span class="stat-val">3</span><span class="stat-label">Pending Flags</span></div>
    </div>
    <div class="stat-card stat-purple">
        <div class="stat-icon"><i class="bi bi-arrow-left-right"></i></div>
        <div class="stat-info"><span class="stat-val">1</span><span class="stat-label">Room Swap Requests</span></div>
    </div>
    <div class="stat-card stat-green">
        <div class="stat-icon"><i class="bi bi-megaphone-fill"></i></div>
        <div class="stat-info"><span class="stat-val">5</span><span class="stat-label">Announcements Sent</span></div>
    </div>
</div>

<div class="dash-grid">

    <!-- ATTENDANCE FLAGGING -->
    <div class="dash-panel">
        <div class="panel-header">
            <span><i class="bi bi-flag-fill me-2 text-danger"></i>Flag Attendance Issue</span>
        </div>
        <form class="flag-form">
            <div class="mb-3">
                <label class="form-label fw-semibold">Course / Session</label>
                <select class="form-select">
                    <option>CSE301 — Software Engineering · Mon 08:00</option>
                    <option>CSE305 — Database Systems · Tue 10:00</option>
                    <option>CSE310 — HCI · Wed 13:00</option>
                    <option>CSE402 — Software Architecture · Thu 08:00</option>
                </select>
            </div>
            <div class="mb-3">
                <label class="form-label fw-semibold">Issue Type</label>
                <div class="d-flex gap-3">
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="issue" id="absent" value="Absent" checked />
                        <label class="form-check-label" for="absent">Lecturer Absent</label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="issue" id="late" value="Late" />
                        <label class="form-check-label" for="late">Class Delayed</label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="issue" id="cancelled" value="Cancelled" />
                        <label class="form-check-label" for="cancelled">Cancelled</label>
                    </div>
                </div>
            </div>
            <div class="mb-3">
                <label class="form-label fw-semibold">Notes (optional)</label>
                <textarea class="form-control" rows="2" placeholder="Add context or details…"></textarea>
            </div>
            <button type="submit" class="btn-dash-primary"><i class="bi bi-flag-fill me-2"></i>Submit Flag</button>
        </form>

        <!-- Existing flags -->
        <div class="mt-3">
            <div class="flag-item">
                <span class="flag-badge badge-absent">Absent</span>
                <div class="flag-detail">CSE305 — Tue 10:00 · <span class="text-muted">28 Aug 2026</span></div>
                <span class="flag-status pending">Pending</span>
            </div>
            <div class="flag-item">
                <span class="flag-badge badge-late">Delayed</span>
                <div class="flag-detail">CSE301 — Mon 08:00 · <span class="text-muted">25 Aug 2026</span></div>
                <span class="flag-status reviewed">Reviewed</span>
            </div>
        </div>
    </div>

    <!-- ROOM SWAP REQUEST + ANNOUNCEMENTS -->
    <div>
        <!-- Room swap -->
        <div class="dash-panel mb-4">
            <div class="panel-header">
                <span><i class="bi bi-arrow-left-right me-2"></i>Request Room Swap</span>
            </div>
            <form class="flag-form">
                <div class="mb-3">
                    <label class="form-label fw-semibold">Affected Session</label>
                    <select class="form-select">
                        <option>CSE301 — Mon 08:00 · Room A204</option>
                        <option>CSE305 — Tue 10:00 · Room B101</option>
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">Preferred Room</label>
                    <select class="form-select">
                        <option>Lab 01 — Block D (Cap: 30)</option>
                        <option>Room C302 — Block C (Cap: 50)</option>
                        <option>Room A108 — Block A (Cap: 40)</option>
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">Reason</label>
                    <textarea class="form-control" rows="2" placeholder="Why is the swap needed?"></textarea>
                </div>
                <button type="submit" class="btn-dash-secondary"><i class="bi bi-arrow-left-right me-2"></i>Submit Request</button>
            </form>
        </div>

        <!-- Post announcement -->
        <div class="dash-panel">
            <div class="panel-header">
                <span><i class="bi bi-megaphone-fill me-2"></i>Post Announcement</span>
            </div>
            <form class="flag-form">
                <div class="mb-3">
                    <label class="form-label fw-semibold">Class / Course</label>
                    <select class="form-select">
                        <option>All my classes</option>
                        <option>CSE301 — Software Engineering</option>
                        <option>CSE305 — Database Systems</option>
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">Announcement</label>
                    <textarea class="form-control" rows="3" placeholder="Write your announcement…"></textarea>
                </div>
                <button type="submit" class="btn-dash-primary"><i class="bi bi-send-fill me-2"></i>Post Announcement</button>
            </form>
        </div>
    </div>
</div>

<!-- ═══════════════════════════════════════════════════
     ENROLLMENT INFO — HOD manages this via UmurongoSmart
════════════════════════════════════════════════════ -->
<div class="dash-panel mt-4">
    <div class="panel-header" style="background:linear-gradient(135deg,#1e3a8a,#1556c8);color:#fff;border-radius:13px 13px 0 0;">
        <span style="display:flex;align-items:center;gap:10px;">
            <span style="width:36px;height:36px;background:rgba(255,255,255,.15);border-radius:50%;
                         display:flex;align-items:center;justify-content:center;font-size:17px;">
                <i class="bi bi-info-circle-fill"></i>
            </span>
            <div>
                <div style="font-size:14px;font-weight:800;">Course Enrollment — Managed by HOD</div>
                <div style="font-size:11px;opacity:.75;">Student enrollments are handled by the HOD through UmurongoSmart</div>
            </div>
        </span>
    </div>
    <div style="padding:1.5rem 1.25rem;">
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:1.25rem;">

            <!-- Info card -->
            <div style="background:#eff6ff;border:1px solid #bfdbfe;border-radius:12px;padding:1.25rem;">
                <div style="display:flex;align-items:center;gap:10px;margin-bottom:.75rem;">
                    <span style="width:40px;height:40px;background:#1556c8;border-radius:10px;
                                 display:flex;align-items:center;justify-content:center;
                                 font-size:18px;color:#fff;flex-shrink:0;">
                        <i class="bi bi-person-workspace"></i>
                    </span>
                    <div>
                        <div style="font-size:13px;font-weight:800;color:#142d4d;">HOD Responsibility</div>
                        <div style="font-size:11px;color:#6c8097;">Enrollment is not a CP function</div>
                    </div>
                </div>
                <p style="font-size:13px;color:#1e3a8a;line-height:1.7;margin:0;">
                    Course enrollment for all students in your class is managed exclusively by the
                    <strong>Head of Department (HOD)</strong> through the UmurongoSmart portal.
                    Students submit enrollment requests and the HOD approves them.
                </p>
            </div>

            <!-- What CP can do -->
            <div style="background:#ecfdf5;border:1px solid #bbf7d0;border-radius:12px;padding:1.25rem;">
                <div style="display:flex;align-items:center;gap:10px;margin-bottom:.75rem;">
                    <span style="width:40px;height:40px;background:#059669;border-radius:10px;
                                 display:flex;align-items:center;justify-content:center;
                                 font-size:18px;color:#fff;flex-shrink:0;">
                        <i class="bi bi-person-badge-fill"></i>
                    </span>
                    <div>
                        <div style="font-size:13px;font-weight:800;color:#142d4d;">What You Can Do as CP</div>
                        <div style="font-size:11px;color:#6c8097;">Your actual responsibilities</div>
                    </div>
                </div>
                <ul style="font-size:13px;color:#065f46;line-height:2;margin:0;padding-left:1.25rem;">
                    <li>Flag lecturer attendance issues</li>
                    <li>Request room swaps for your class</li>
                    <li>Post announcements to classmates</li>
                    <li>Escalate student concerns to HOD</li>
                    <li>Share the WhatsApp group link given by HOD</li>
                </ul>
            </div>
        </div>

        <!-- Escalate to HOD via UmurongoSmart -->
        <div style="margin-top:1.25rem;padding:1rem 1.25rem;background:#fef9c3;border:1px solid #fde68a;
                    border-radius:12px;display:flex;align-items:center;justify-content:space-between;
                    flex-wrap:wrap;gap:1rem;">
            <div>
                <div style="font-size:13px;font-weight:800;color:#92400e;margin-bottom:.25rem;">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>Need to escalate an enrollment issue?
                </div>
                <div style="font-size:12px;color:#78350f;">
                    If a student in your class has an enrollment problem, direct them to contact
                    the HOD through UmurongoSmart or come to the department office.
                </div>
            </div>
            <a href="https://umurongosmart.com" target="_blank"
               style="display:inline-flex;align-items:center;gap:8px;
                      background:#142d4d;color:#fff;text-decoration:none;
                      border-radius:9px;padding:.65rem 1.25rem;
                      font-size:13px;font-weight:700;white-space:nowrap;">
                <i class="bi bi-box-arrow-up-right"></i> Open UmurongoSmart
            </a>
        </div>
    </div>
</div>
<!-- SCHEDULE (same as student) -->
<div class="dash-panel mt-4">
    <div class="panel-header">
        <span><i class="bi bi-calendar-week-fill me-2"></i>My Class Schedule</span>
    </div>
    <div class="table-responsive">
        <table class="dash-table">
            <thead><tr><th>Day</th><th>Time</th><th>Course</th><th>Room</th><th>Lecturer</th><th>Status</th></tr></thead>
            <tbody>
                <tr><td>Monday</td><td>08:00–10:00</td><td>Software Engineering</td><td><span class="room-badge">A204</span></td><td>Dr. J. Mugisha</td><td><span class="sched-badge badge-ongoing">Ongoing</span></td></tr>
                <tr><td>Tuesday</td><td>10:00–12:00</td><td>Database Systems</td><td><span class="room-badge">B101</span></td><td>Mrs. A. Byukusenge</td><td><span class="sched-badge badge-upcoming">Upcoming</span></td></tr>
                <tr><td>Wednesday</td><td>13:00–15:00</td><td>Human-Computer Interaction</td><td><span class="room-badge">A108</span></td><td>Mr. E. Niyonsenga</td><td><span class="sched-badge badge-upcoming">Upcoming</span></td></tr>
                <tr><td>Thursday</td><td>08:00–10:00</td><td>Software Architecture</td><td><span class="room-badge">C302</span></td><td>Dr. P. Habimana</td><td><span class="sched-badge badge-upcoming">Upcoming</span></td></tr>
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
<script>
    function publishGroupLink() {
        var course   = document.getElementById('groupCourse').value;
        var link     = document.getElementById('groupLink').value;
        var name     = document.getElementById('groupName').value;
        var session  = document.getElementById('groupSession').value;
        var deadline = document.getElementById('groupDeadline').value;

        if (!course || !link || !name) {
            alert('Please fill in the Course, Group Name, and WhatsApp Link fields.');
            return;
        }
        if (!link.startsWith('https://chat.whatsapp.com/')) {
            alert('Please enter a valid WhatsApp group link (must start with https://chat.whatsapp.com/)');
            return;
        }

        // Add new row to the table
        var tbody = document.getElementById('groupLinksBody');
        var dl = deadline ? new Date(deadline).toLocaleDateString('en-GB',{day:'2-digit',month:'short',year:'numeric'}) : 'No deadline';
        var row = '<tr>' +
            '<td><strong>' + course + '</strong></td>' +
            '<td>' + name + '</td>' +
            '<td><span class="session-badge">' + session + '</span></td>' +
            '<td>' + dl + '</td>' +
            '<td><a href="' + link + '" target="_blank" class="btn-wa"><i class="bi bi-whatsapp"></i> Join</a></td>' +
            '<td><span class="sched-badge badge-ongoing">Active</span></td>' +
            '<td class="action-btns">' +
              '<button class="btn-icon btn-edit"><i class="bi bi-pencil-fill"></i></button>' +
              '<button class="btn-icon btn-del" onclick="this.closest(\'tr\').remove()"><i class="bi bi-trash-fill"></i></button>' +
            '</td></tr>';
        tbody.insertAdjacentHTML('afterbegin', row);

        // Clear form
        document.getElementById('groupCourse').value  = '';
        document.getElementById('groupLink').value    = '';
        document.getElementById('groupName').value    = '';
        document.getElementById('groupDeadline').value= '';

        // Show success toast
        var toast = document.createElement('div');
        toast.style.cssText = 'position:fixed;bottom:2rem;right:2rem;background:#16a34a;color:#fff;padding:.75rem 1.25rem;border-radius:10px;font-weight:700;font-size:13px;z-index:9999;box-shadow:0 8px 25px rgba(0,0,0,.2);';
        toast.innerHTML = '<i class="bi bi-check-circle-fill me-2"></i>Group link published successfully!';
        document.body.appendChild(toast);
        setTimeout(function(){ toast.remove(); }, 3000);
    }
</script>
}

