@page
@model CourseScheduleSystem.Web.Pages.CP.CisCps.IndexModel

@{
    Layout = "/Pages/CP/_CPLayout.cshtml";
    ViewData["Title"] = "CIS Class Representatives";
}

<div class="container-fluid py-4">

    <div class="mb-4">
        <h1 class="h3 mb-1">CIS Class Representatives</h1>
        <p class="text-muted mb-0">
            View the active Class Representatives in the CIS department.
        </p>
    </div>

    @if (!Model.Representatives.Any())
    {
        <div class="card shadow-sm">
            <div class="card-body text-center py-5">
                <i class="bi bi-person-vcard display-5 text-muted"></i>

                <h5 class="mt-3">No representatives found</h5>

                <p class="text-muted mb-0">
                    There are currently no active CIS Class Representatives.
                </p>
            </div>
        </div>
    }
    else
    {
        <div class="row g-4">

            @foreach (var cp in Model.Representatives)
            {
                <div class="col-md-6 col-xl-4">
                    <div class="card shadow-sm h-100">
                        <div class="card-body">

                            <div class="d-flex align-items-center mb-3">
                                <div class="rounded-circle bg-primary text-white
                                            d-flex align-items-center justify-content-center"
                                     style="width:48px;height:48px;">
                                    <i class="bi bi-person-fill"></i>
                                </div>

                                <div class="ms-3">
                                    <h5 class="mb-0">@cp.FullName</h5>
                                    <small class="text-muted">
                                        @cp.RegNo
                                    </small>
                                </div>
                            </div>

                            <div class="mb-2">
                                <strong>Department:</strong>
                                @cp.Department
                            </div>

                            <div class="mb-2">
                                <strong>Intake:</strong>
                                @cp.Intake
                            </div>

                            <div class="mb-2">
                                <strong>Level:</strong>
                                @cp.Level
                            </div>

                            @if (!string.IsNullOrWhiteSpace(cp.Email))
                            {
                                <div class="mb-2">
                                    <i class="bi bi-envelope me-1"></i>
                                    @cp.Email
                                </div>
                            }

                            @if (!string.IsNullOrWhiteSpace(cp.PhoneNumber))
                            {
                                <div>
                                    <i class="bi bi-telephone me-1"></i>
                                    @cp.PhoneNumber
                                </div>
                            }

                        </div>
                    </div>
                </div>
            }

        </div>
    }
</div>