@page
@model CourseScheduleSystem.Web.Pages.CP.CisCps.IndexModel

@{
    Layout = "/Pages/Shared/_CPLayout.cshtml";
    ViewData["Title"] = "CIS Class Representatives";
}

<div class="container-fluid py-2">

    <!-- ── PAGE HEADER ── -->
    <div class="cp-page-header">
        <div>
            <h1 class="cp-page-header-title">CIS Class Representatives</h1>
            <p class="cp-page-header-sub">
                <span>Active representatives in the Faculty of Computing and Information Technology.</span>
                @if (Model.Representatives.Any())
                {
                    <span class="cp-badge">
                        <i class="bi bi-people-fill"></i>
                        @Model.Representatives.Count active
                    </span>
                }
            </p>
        </div>
        <div class="cp-page-header-date">
            <i class="bi bi-building"></i>
            <span>CIS Department</span>
        </div>
    </div>

    <!-- ── EMPTY STATE ── -->
    @if (!Model.Representatives.Any())
    {
        <div class="cp-empty-state">
            <div class="cp-empty-state-icon">
                <i class="bi bi-person-vcard"></i>
            </div>
            <h5 class="cp-empty-state-title">No representatives found</h5>
            <p class="cp-empty-state-desc">
                There are currently no active Class Representatives in the CIS department.
            </p>
        </div>
    }
    else
    {
        <div class="cg-list">

            <!-- ── List header ── -->
            <div class="cp-list-header">
                <div class="cp-list-hcol cp-lc-name">Name</div>
                <div class="cp-list-hcol cp-lc-dept">Department</div>
                <div class="cp-list-hcol cp-lc-intake">Intake</div>
                <div class="cp-list-hcol cp-lc-level">Level</div>
                <div class="cp-list-hcol cp-lc-nat">Nationality</div>
                <div class="cp-list-hcol cp-lc-phone">Phone</div>
            </div>

            <!-- ── List rows ── -->
            @foreach (var cp in Model.Representatives)
            {
                var initials = string.Concat(
                    cp.FullName.Split(' ', StringSplitOptions.RemoveEmptyEntries)
                               .Take(2)
                               .Select(p => char.ToUpper(p[0])));

                <div class="cp-list-row">

                    <!-- Name + RegNo -->
                    <div class="cp-lc-name">
                        <div class="cp-list-avatar">@initials</div>
                        <div>
                            <div class="cp-list-name">@cp.FullName</div>
                            <div class="cp-list-regno">@cp.RegNo</div>
                        </div>
                    </div>

                    <!-- Department -->
                    <div class="cp-lc-dept">
                        <span class="cp-list-text">@cp.Department</span>
                    </div>

                    <!-- Intake -->
                    <div class="cp-lc-intake">
                        <span class="cp-list-text">@cp.Intake</span>
                    </div>

                    <!-- Level -->
                    <div class="cp-lc-level">
                        <span class="cp-list-text">@cp.Level</span>
                    </div>

                    <!-- Nationality -->
                    <div class="cp-lc-nat">
                        <span class="cp-list-text">
                            @(string.IsNullOrWhiteSpace(cp.Nationality) ? "—" : cp.Nationality)
                        </span>
                    </div>

                    <!-- Phone -->
                    <div class="cp-lc-phone">
                        @if (!string.IsNullOrWhiteSpace(cp.PhoneNumber))
                        {
                            <a href="tel:@cp.PhoneNumber" class="cp-list-phone-link">
                                <i class="bi bi-telephone"></i>
                                @cp.PhoneNumber
                            </a>
                        }
                        else
                        {
                            <span class="cp-list-text" style="color:var(--text-light);font-style:italic;">Not set</span>
                        }
                    </div>

                </div>
            }

        </div>
    }

</div>
