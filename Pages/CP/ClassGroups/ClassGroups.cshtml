@page
@model CourseScheduleSystem.Web.Pages.CP.ClassGroups.IndexModel

@{
    Layout = "/Pages/Shared/_CPLayout.cshtml";
    ViewData["Title"] = "Class Groups";
}

<div class="container-fluid py-2">

    <!-- ── PAGE HEADER ── -->
    <div class="cp-page-header">
        <div>
            <h1 class="cp-page-header-title">Class Groups</h1>
            <p class="cp-page-header-sub">
                <span>Manage communication groups for your represented courses.</span>
                @if (Model.Groups.Any())
                {
                    <span class="cp-badge">
                        <i class="bi bi-people-fill"></i>
                        @Model.Groups.Count @(Model.Groups.Count == 1 ? "group" : "groups")
                    </span>
                }
            </p>
        </div>
        <a href="/CP/ClassGroups/Create" class="cp-header-btn">
            <i class="bi bi-plus-lg"></i>
            <span>Create Group</span>
        </a>
    </div>

    <!-- ── EMPTY STATE ── -->
    @if (!Model.Groups.Any())
    {
        <div class="cp-empty-state">
            <div class="cp-empty-state-icon">
                <i class="bi bi-people"></i>
            </div>
            <h5 class="cp-empty-state-title">No class groups yet</h5>
            <p class="cp-empty-state-desc">
                Create your first group to start organising your class communication.
            </p>
            <a href="/CP/ClassGroups/Create" class="cp-action-card-btn cp-action-btn--primary">
                <i class="bi bi-plus-lg"></i>
                Create Your First Group
            </a>
        </div>
    }
    else
    {
        <!-- ── GROUP TABLE (beautiful list layout) ── -->
        <div class="cg-list">

            <!-- List header -->
            <div class="cg-list-header">
                <div class="cg-list-header-col cg-col-name">Group Name</div>
                <div class="cg-list-header-col cg-col-course">Course</div>
                <div class="cg-list-header-col cg-col-meta">Level / Intake</div>
                <div class="cg-list-header-col cg-col-status">Status</div>
                <div class="cg-list-header-col cg-col-date">Created</div>
                <div class="cg-list-header-col cg-col-action">Link</div>
            </div>

            <!-- List rows -->
            @foreach (var group in Model.Groups)
            {
                <div class="cg-list-row">

                    <!-- Icon + Name -->
                    <div class="cg-col-name">
                        <div class="cg-row-icon">
                            <i class="bi bi-people-fill"></i>
                        </div>
                        <div class="cg-row-name-block">
                            <span class="cg-row-name">@group.GroupName</span>
                        </div>
                    </div>

                    <!-- Course -->
                    <div class="cg-col-course">
                        <span class="cg-course-chip">
                            <i class="bi bi-journal-bookmark"></i>
                            @group.Course.Name
                        </span>
                    </div>

                    <!-- Level / Intake -->
                    <div class="cg-col-meta">
                        <span class="cg-meta-line">
                            <i class="bi bi-mortarboard"></i>
                            @group.Level
                        </span>
                        <span class="cg-meta-line">
                            <i class="bi bi-calendar2"></i>
                            @group.Intake
                        </span>
                    </div>

                    <!-- Status badge -->
                    <div class="cg-col-status">
                        @if (group.IsPublished)
                        {
                            <span class="cp-status-badge cp-status-badge--published">
                                <i class="bi bi-broadcast"></i> Published
                            </span>
                        }
                        else
                        {
                            <span class="cp-status-badge cp-status-badge--draft">
                                <i class="bi bi-pencil-square"></i> Draft
                            </span>
                        }
                    </div>

                    <!-- Date -->
                    <div class="cg-col-date">
                        <span class="cg-date-text">
                            @group.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")
                        </span>
                    </div>

                    <!-- Action -->
                    <div class="cg-col-action">
                        @if (!string.IsNullOrWhiteSpace(group.GroupLink))
                        {
                            <a href="@group.GroupLink"
                               target="_blank"
                               rel="noopener noreferrer"
                               class="cg-open-btn">
                                <i class="bi bi-box-arrow-up-right"></i>
                                Open
                            </a>
                        }
                        else
                        {
                            <span class="cg-no-link">No link</span>
                        }
                    </div>

                </div>
            }

        </div><!-- /cg-list -->
    }

</div>
