@page
@model CourseScheduleSystem.Web.Pages.CP.ClassGroups.IndexModel

@{
    Layout = "/Pages/CP/_CPLayout.cshtml";
    ViewData["Title"] = "Class Groups";
}

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-1">Class Groups</h1>
            <p class="text-muted mb-0">
                Manage the communication groups for your courses.
            </p>
        </div>
<a href="/CP/ClassGroups/Create"
   class="btn btn-primary">
    <i class="bi bi-plus-lg"></i>
    Create Group
</a>
    </div>

    @if (!Model.Groups.Any())
    {
        <div class="card shadow-sm">
            <div class="card-body text-center py-5">
                <i class="bi bi-people display-5 text-muted"></i>

                <h5 class="mt-3">No class groups yet</h5>

                <p class="text-muted mb-0">
                    Your active class groups will appear here.
                </p>
            </div>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var group in Model.Groups)
            {
                <div class="col-md-6 col-xl-4">
                    <div class="card shadow-sm h-100">
                        <div class="card-body">

                            <div class="d-flex justify-content-between">
                                <h5 class="card-title">
                                    @group.GroupName
                                </h5>

                                @if (group.IsPublished)
                                {
                                    <span class="badge bg-success">
                                        Published
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">
                                        Draft
                                    </span>
                                }
                            </div>

                            <p class="text-muted mb-1">
                                @group.Course.Name
                            </p>

                            <p class="mb-2">
                                <strong>Intake:</strong> @group.Intake
                                <br />
                                <strong>Level:</strong> @group.Level
                            </p>

                            @if (!string.IsNullOrWhiteSpace(group.GroupLink))
                            {
                                <a href="@group.GroupLink"
                                   target="_blank"
                                   rel="noopener noreferrer"
                                   class="btn btn-outline-primary btn-sm">
                                    <i class="bi bi-box-arrow-up-right"></i>
                                    Open Group
                                </a>
                            }

                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>