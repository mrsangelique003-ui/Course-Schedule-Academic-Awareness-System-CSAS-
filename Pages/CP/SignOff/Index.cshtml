@page
@model CourseScheduleSystem.Web.Pages.CP.SignOff.IndexModel
@using CourseScheduleSystem.Web.Models

@{
    Layout = "/Pages/CP/_CPLayout.cshtml";
    ViewData["Title"] = "Course Sign-Off";
}

<div class="container-fluid py-4">

    <div class="mb-4">
        <h1 class="h3 mb-1">Course Sign-Off</h1>
        <p class="text-muted mb-0">
            Review the completion status of your represented courses.
        </p>
    </div>

    @if (!Model.Completions.Any())
    {
        <div class="card shadow-sm">
            <div class="card-body text-center py-5">
                <i class="bi bi-check2-square display-5 text-muted"></i>

                <h5 class="mt-3">No sign-off records</h5>

                <p class="text-muted mb-0">
                    Course completion records will appear here.
                </p>
            </div>
        </div>
    }
    else
    {
        <div class="card shadow-sm">
            <div class="card-body">

                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Course</th>
                                <th>Lecturer</th>
                                <th>Status</th>
                                <th>Submitted</th>
                                <th>Remarks</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var completion in Model.Completions)
                            {
                                <tr>
                                    <td>
                                        <strong>
                                            @completion.Course.Name
                                        </strong>
                                    </td>

                                    <td>
                                        @completion.Lecturer.FullName
                                    </td>

                                    <td>
                                        @switch (completion.Status)
                                        {
                                            case CourseCompletionStatus.Confirmed:
                                                <span class="badge bg-success">
                                                    Confirmed
                                                </span>
                                                break;

                                            case CourseCompletionStatus.Returned:
                                                <span class="badge bg-danger">
                                                    Returned
                                                </span>
                                                break;

                                            default:
                                                <span class="badge bg-warning text-dark">
                                                    Submitted
                                                </span>
                                                break;
                                        }
                                    </td>

                                    <td>
                                        @if (completion.SubmittedAt.HasValue)
                                        {
                                            @completion.SubmittedAt.Value.ToLocalTime().ToString("dd MMM yyyy HH:mm")
                                        }
                                        else
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                    </td>

                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(completion.Remarks))
                                        {
                                            @completion.Remarks
                                        }
                                        else
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

            </div>
        </div>
    }
</div>