@page
@model CourseScheduleSystem.Web.Pages.CP.SignOff.IndexModel
@using CourseScheduleSystem.Web.Models

@{
    Layout = "/Pages/CP/_CPLayout.cshtml";
    ViewData["Title"] = "Course Sign-Off";
}

<div class="container-fluid py-4">

    <div class="mb-4">
        <h1 class="h3 mb-1">Course Sign-Off</h1>
        <p class="text-muted mb-0">
            Review course completion submissions from lecturers.
        </p>
    </div>

    @if (!Model.Completions.Any())
    {
        <div class="card shadow-sm border-0">
            <div class="card-body text-center py-5">

                <i class="bi bi-clipboard-check display-5 text-muted"></i>

                <h5 class="mt-3">No course submissions</h5>

                <p class="text-muted mb-0">
                    Course completion submissions will appear here.
                </p>

            </div>
        </div>
    }
    else
    {
        <div class="row g-4">

            @foreach (var completion in Model.Completions)
            {
                <div class="col-12">

                    <div class="card shadow-sm border-0">

                        <div class="card-body">

                            <div class="d-flex justify-content-between align-items-start mb-3">

                                <div>
                                    <h5 class="mb-1">
                                        @completion.Course.Name
                                    </h5>

                                    <div class="text-muted">
                                        Lecturer:
                                        @completion.Lecturer.FullName
                                    </div>
                                </div>

                                @if (completion.Status == CourseCompletionStatus.Submitted)
                                {
                                    <span class="badge bg-warning text-dark">
                                        Submitted
                                    </span>
                                }
                                else if (completion.Status == CourseCompletionStatus.Confirmed)
                                {
                                    <span class="badge bg-success">
                                        Confirmed
                                    </span>
                                }
                                else if (completion.Status == CourseCompletionStatus.Returned)
                                {
                                    <span class="badge bg-danger">
                                        Returned
                                    </span>
                                }

                            </div>

                            @if (completion.SubmittedAt.HasValue)
                            {
                                <p class="text-muted small">
                                    Submitted:
                                    @completion.SubmittedAt.Value.ToLocalTime().ToString("dd MMM yyyy, HH:mm")
                                </p>
                            }

                            @if (!string.IsNullOrWhiteSpace(completion.Remarks))
                            {
                                <div class="alert alert-secondary">
                                    <strong>Remarks:</strong>
                                    @completion.Remarks
                                </div>
                            }

                            @if (completion.Status == CourseCompletionStatus.Submitted)
                            {
                                <div class="d-flex gap-2">

                                    <form method="post"
                                          asp-page-handler="Confirm">

                                        <input type="hidden"
                                               name="id"
                                               value="@completion.Id" />

                                        <button type="submit"
                                                class="btn btn-success">
                                            <i class="bi bi-check-lg"></i>
                                            Confirm
                                        </button>

                                    </form>

                                    <button type="button"
                                            class="btn btn-outline-danger"
                                            data-bs-toggle="collapse"
                                            data-bs-target="#return-@completion.Id">
                                        <i class="bi bi-arrow-return-left"></i>
                                        Return
                                    </button>

                                </div>

                                <div class="collapse mt-3"
                                     id="return-@completion.Id">

                                    <form method="post"
                                          asp-page-handler="Return">

                                        <input type="hidden"
                                               name="id"
                                               value="@completion.Id" />

                                        <div class="mb-3">
                                            <label class="form-label fw-semibold">
                                                Return Remarks
                                            </label>

                                            <textarea name="remarks"
                                                      class="form-control"
                                                      rows="3"
                                                      maxlength="1000"
                                                      placeholder="Explain why the course completion is being returned..."
                                                      required></textarea>
                                        </div>

                                        <button type="submit"
                                                class="btn btn-danger">
                                            <i class="bi bi-arrow-return-left"></i>
                                            Return Submission
                                        </button>

                                    </form>

                                </div>
                            }

                        </div>

                    </div>

                </div>
            }

        </div>
    }

</div>