@page
@model CourseScheduleSystem.Web.Pages.CP.Chat.IndexModel

@{
    Layout = "/Pages/CP/_CPLayout.cshtml";
    ViewData["Title"] = "HOD Chat";
}

<div class="container-fluid py-4">

    <div class="mb-4">
        <h1 class="h3 mb-1">HOD Chat</h1>
        <p class="text-muted mb-0">
            Messages between you and the Head of Department.
        </p>
    </div>

    <div class="card shadow-sm">

        <div class="card-header bg-white">
            <i class="bi bi-chat-dots me-2"></i>
            Conversation
        </div>

        <div class="card-body">

            @if (!Model.Messages.Any())
            {
                <div class="text-center py-5">
                    <i class="bi bi-chat-square-text display-5 text-muted"></i>

                    <h5 class="mt-3">No messages yet</h5>

                    <p class="text-muted mb-0">
                        Your HOD messages will appear here.
                    </p>
                </div>
            }
            else
            {
                <div class="d-flex flex-column gap-3">

                    @foreach (var message in Model.Messages)
                    {
                        <div class="border rounded p-3">

                            <div class="d-flex justify-content-between mb-2">
                                <strong>
                                    HOD
                                </strong>

                                <small class="text-muted">
                                    @message.SentAt.ToLocalTime()
                                        .ToString("dd MMM yyyy HH:mm")
                                </small>
                            </div>

                            <div>
                                @message.Message
                            </div>

                        </div>
                    }

                </div>
            }

        </div>

    </div>
</div>