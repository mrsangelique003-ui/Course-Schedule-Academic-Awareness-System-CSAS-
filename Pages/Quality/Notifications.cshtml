@page
@model CourseScheduleSystem.Web.Pages.Quality.NotificationsModel
@{ ViewData["Title"]="Notifications"; Layout="~/Pages/Shared/_DashboardLayout.cshtml"; ViewData["Role"]="DirectorOfQuality"; ViewData["ActiveNav"]="notif"; ViewData["UserName"]=User.Identity?.Name??"Director"; }

<div class="dash-welcome">
    <div><h2 class="dash-heading">Notifications</h2><p class="dash-subheading">Quality oversight alerts and endorsement requests</p></div>
    <button class="btn-dash-secondary" style="font-size:12px;" onclick="markAll()"><i class="bi bi-check-all me-1"></i>Mark All Read</button>
</div>

<div class="dash-panel">
    <div class="panel-header"><span><i class="bi bi-bell-fill me-2"></i>All Notifications</span><span class="panel-badge" id="uc">2 unread</span></div>
    <div id="nList" style="padding:.75rem 1.25rem;display:flex;flex-direction:column;gap:.5rem;">
        <div class="notif-item notif-unread">
            <div class="notif-icon notif-orange"><i class="bi bi-check2-square"></i></div>
            <div class="notif-body" style="flex:1;"><div class="notif-title">New Endorsement Request — CSE301</div><div class="notif-text">Room swap request from CP Bob Nkurunziza awaiting your endorsement.</div><div class="notif-time">28 Aug 2026</div></div>
            <span style="width:8px;height:8px;border-radius:50%;background:#059669;flex-shrink:0;margin-top:6px;"></span>
        </div>
        <div class="notif-item notif-unread">
            <div class="notif-icon notif-red"><i class="bi bi-exclamation-triangle-fill"></i></div>
            <div class="notif-body" style="flex:1;"><div class="notif-title">Capacity Alert — Room A108</div><div class="notif-text">CSE310 is over capacity (44 students in 40-seat room). Immediate action required.</div><div class="notif-time">27 Aug 2026</div></div>
            <span style="width:8px;height:8px;border-radius:50%;background:#059669;flex-shrink:0;margin-top:6px;"></span>
        </div>
        <div class="notif-item">
            <div class="notif-icon notif-blue"><i class="bi bi-clipboard-data-fill"></i></div>
            <div class="notif-body" style="flex:1;"><div class="notif-title">Compliance Report Ready</div><div class="notif-text">Week of 25 Aug compliance report is available for review.</div><div class="notif-time">26 Aug 2026</div></div>
        </div>
    </div>
</div>

@section Scripts {<script>function markAll(){document.querySelectorAll('.notif-unread').forEach(function(n){n.classList.remove('notif-unread');var d=n.querySelector('span[style*="border-radius:50%"]');if(d)d.remove();});document.getElementById('uc').textContent='0 unread';}</script>}
