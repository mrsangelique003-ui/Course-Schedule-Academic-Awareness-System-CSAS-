@page
@model CourseScheduleSystem.Web.Pages.IndexModel

@{
    Layout = null;
    ViewData["Title"] = "Course Schedule & Academic Awareness System";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>CSAS | Course Schedule and Academic Awareness System | UNILAK</title>
    <meta name="description" content="Course Schedule and Academic Awareness System for UNILAK students, lecturers, and academic staff." />
    <meta name="theme-color" content="#0b2545" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Plus+Jakarta+Sans:wght@500;600;700;800&family=DM+Serif+Display:ital@0;1&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/Index.css" asp-append-version="true" />
</head>

<body>
<div class="lp-root">

    <!-- ═══════════════════════════════════
         NAV — transparent over video
    ════════════════════════════════════ -->
    <header class="lp-nav-wrap" id="lpNav">
        <nav class="lp-nav" aria-label="Main navigation">

            <a asp-page="/Index" class="lp-brand" aria-label="CSAS Home">
                <span class="lp-brand-logo">
                    <img src="~/images/PNG_LOGO-_UNILAK-removebg-preview.png" alt="UNILAK" />
                </span>
                <span class="lp-brand-text">
                    <strong>UNILAK</strong>
                    <small>Academic Awareness System</small>
                </span>
            </a>

            <div class="lp-nav-links">
                <a href="#about"       class="lp-nav-link">About</a>
                <a href="#features"    class="lp-nav-link">Features</a>
                <a href="#users"       class="lp-nav-link">Users</a>
                <a href="#how-it-works" class="lp-nav-link">How It Works</a>
            </div>

            <div class="lp-nav-right">
                <a asp-page="/Account/Login" class="lp-nav-login">Login</a>
            </div>

            <button class="lp-nav-toggle" id="lpNavToggle" aria-label="Open menu" aria-expanded="false">
                <i class="bi bi-list"></i>
            </button>
        </nav>

        <!-- Mobile drawer -->
        <div class="lp-mobile-drawer" id="lpMobileDrawer">
            <a href="#about"        class="lp-mob-link" onclick="closeMobileMenu()">About</a>
            <a href="#features"     class="lp-mob-link" onclick="closeMobileMenu()">Features</a>
            <a href="#users"        class="lp-mob-link" onclick="closeMobileMenu()">Users</a>
            <a href="#how-it-works" class="lp-mob-link" onclick="closeMobileMenu()">How It Works</a>
            <a asp-page="/Account/Login" class="lp-mob-login">Login to the System</a>
        </div>
    </header>


    <main>

        <!-- ═══════════════════════════════════
             HERO — full-bleed video
        ════════════════════════════════════ -->
        <section class="lp-hero" aria-label="Welcome">

            <!-- Video background -->
            <div class="lp-hero-video-wrap" aria-hidden="true">
                <video class="lp-hero-video"
                       autoplay muted loop playsinline preload="auto"
                       poster="~/images/unilak-campus.jpg">
                    <source src="~/Videos/Hero.mp4" type="video/mp4" />
                </video>
                <div class="lp-hero-overlay"></div>
            </div>

            <!-- Hero content -->
            <div class="lp-hero-body">

                <h1 class="lp-hero-h1">
                    One platform for those
                    <em>who want to stay</em>
                    <span>informed.</span>
                </h1>

                <p class="lp-hero-sub">
                    Access course schedules, academic updates, and university information
                    from one centralized platform built for the entire UNILAK community.
                </p>

                <div class="lp-hero-actions">
                    <a asp-page="/Account/Login" class="lp-btn-white">
                        Login to the System
                    </a>
                    <a href="#about" class="lp-btn-ghost">
                        Learn More
                    </a>
                </div>

            </div>

            <!-- Scroll arrow -->
            <a href="#ticker" class="lp-hero-scroll" aria-label="Scroll down">
                <i class="bi bi-chevron-down"></i>
            </a>

        </section>


        <!-- ═══════════════════════════════════
             NEWS TICKER
        ════════════════════════════════════ -->
        <div class="lp-ticker" id="ticker">
            <div class="lp-ticker-label">
                <i class="bi bi-megaphone-fill"></i>
                Latest
            </div>
            <div class="lp-ticker-track-wrap">
                <div class="lp-ticker-track">
                    <span>Semester I 2026 schedules are now live on the platform</span>
                    <span>Room change notifications sent to all enrolled students</span>
                    <span>Course sign-off submissions now open for Class Representatives</span>
                    <span>Final Year Project presentations: Block D, 20 to 24 Oct 2026</span>
                    <span>HOD messages can now be sent directly to Class Representatives</span>
                    <!-- duplicate for seamless loop -->
                    <span>Semester I 2026 schedules are now live on the platform</span>
                    <span>Room change notifications sent to all enrolled students</span>
                    <span>Course sign-off submissions now open for Class Representatives</span>
                    <span>Final Year Project presentations: Block D, 20 to 24 Oct 2026</span>
                    <span>HOD messages can now be sent directly to Class Representatives</span>
                </div>
            </div>
        </div>


        <!-- ═══════════════════════════════════
             ABOUT / MISSION
        ════════════════════════════════════ -->
        <section class="lp-about" id="about">
            <div class="lp-container lp-about-grid">

                <div class="lp-about-left">
                    <span class="lp-eyebrow">About CSAS</span>
                    <h2 class="lp-h2">
                        Academic awareness,<br>
                        <em>built for UNILAK.</em>
                    </h2>
                    <p class="lp-body-text">
                        The Course Schedule and Academic Awareness System (CSAS) was built
                        to give every member of the UNILAK community: students, lecturers,
                        class representatives, and administrators instant access to the
                        academic information they need, when they need it.
                    </p>
                    <p class="lp-body-text">
                        No more missed schedules, room changes, or sign-off delays.
                        Everything is centralized, organized, and always up to date.
                    </p>
                    <a asp-page="/Account/Login" class="lp-text-link">
                        Access the platform
                    </a>
                </div>

                <div class="lp-about-right">
                    <div class="lp-mission-card">
                        <div class="lp-mission-card-icon">
                            <i class="bi bi-bullseye"></i>
                        </div>
                        <p class="lp-mission-label">Our Mission</p>
                        <blockquote class="lp-mission-quote">
                            "To provide every student and academic staff member with
                            seamless, real-time access to course schedules and
                            academic awareness tools."
                        </blockquote>
                    </div>
                    <img src="~/images/unilak-campus.jpg"
                         alt="UNILAK Campus"
                         class="lp-about-img"
                         loading="lazy" />
                </div>

            </div>
        </section>


        <!-- ═══════════════════════════════════
             STATS BAR
        ════════════════════════════════════ -->
        <div class="lp-stats-bar">
            <div class="lp-container lp-stats-inner">

                <div class="lp-stat-block">
                    <strong>6,000+</strong>
                    <span>Active Students</span>
                </div>
                <div class="lp-stat-divider"></div>
                <div class="lp-stat-block">
                    <strong>180</strong>
                    <span>Courses Available</span>
                </div>
                <div class="lp-stat-divider"></div>
                <div class="lp-stat-block">
                    <strong>70+</strong>
                    <span>Lecturers</span>
                </div>
                <div class="lp-stat-divider"></div>
                <div class="lp-stat-block">
                    <strong>24/7</strong>
                    <span>Platform Access</span>
                </div>
                <div class="lp-stat-divider"></div>
                <div class="lp-stat-block">
                    <strong>100%</strong>
                    <span>Online &amp; Real-time</span>
                </div>

            </div>
        </div>


        <!-- ═══════════════════════════════════
             FEATURES
        ════════════════════════════════════ -->
        <section class="lp-features" id="features">
            <div class="lp-container">

                <div class="lp-section-head">
                    <span class="lp-eyebrow">Platform Features</span>
                    <h2 class="lp-h2">What makes CSAS unique?</h2>
                    <p class="lp-section-sub">
                        In our experience, the best academic awareness comes from having
                        all the right tools in one place, accessible to everyone.
                    </p>
                </div>

                <div class="lp-features-grid">

                    <article class="lp-feat-card">
                        <div class="lp-feat-icon"><i class="bi bi-calendar3"></i></div>
                        <h3>Live Course Schedules</h3>
                        <p>View your weekly timetable in real time. Room changes and updates reflect immediately across the platform.</p>
                        <a href="#how-it-works" class="lp-feat-link">Learn more</a>
                    </article>

                    <article class="lp-feat-card">
                        <div class="lp-feat-icon"><i class="bi bi-megaphone"></i></div>
                        <h3>Academic Announcements</h3>
                        <p>HOD messages, room shifts, and important updates are pushed directly to Class Representatives.</p>
                        <a href="#how-it-works" class="lp-feat-link">Learn more</a>
                    </article>

                    <article class="lp-feat-card">
                        <div class="lp-feat-icon"><i class="bi bi-clipboard2-check"></i></div>
                        <h3>Course Sign-Off</h3>
                        <p>Class Representatives can review, confirm, or return course completion submissions from lecturers.</p>
                        <a href="#how-it-works" class="lp-feat-link">Learn more</a>
                    </article>

                    <article class="lp-feat-card">
                        <div class="lp-feat-icon"><i class="bi bi-people"></i></div>
                        <h3>Class Group Management</h3>
                        <p>CPs can create and manage class communication groups, keeping every student connected.</p>
                        <a href="#how-it-works" class="lp-feat-link">Learn more</a>
                    </article>

                    <article class="lp-feat-card">
                        <div class="lp-feat-icon"><i class="bi bi-chat-dots"></i></div>
                        <h3>Private HOD Chat</h3>
                        <p>A secure, private messaging channel between each Class Representative and the Head of Department.</p>
                        <a href="#how-it-works" class="lp-feat-link">Learn more</a>
                    </article>

                    <article class="lp-feat-card">
                        <div class="lp-feat-icon"><i class="bi bi-grid-1x2"></i></div>
                        <h3>Centralized Dashboard</h3>
                        <p>Every user: student, CP, or admin gets a personalized dashboard with everything relevant at a glance.</p>
                        <a href="#how-it-works" class="lp-feat-link">Learn more</a>
                    </article>

                </div>

            </div>
        </section>


        <!-- ═══════════════════════════════════
             WHO IS IT FOR — like ALU programs
        ════════════════════════════════════ -->
        <section class="lp-users" id="users">
            <div class="lp-container">

                <div class="lp-section-head">
                    <span class="lp-eyebrow">Built For The University</span>
                    <h2 class="lp-h2">One platform. Different academic needs.</h2>
                </div>

                <div class="lp-users-grid">

                    <article class="lp-user-card">
                        <div class="lp-user-card-top">
                            <div class="lp-user-icon"><i class="bi bi-mortarboard-fill"></i></div>
                            <span class="lp-user-tag">Students</span>
                        </div>
                        <h3>Stay on top of your schedule</h3>
                        <p>Check your timetable, find classrooms, view exam dates, and access your enrolled courses, all from one place.</p>
                        <ul class="lp-user-list">
                            <li><i class="bi bi-check2"></i> Weekly timetable</li>
                            <li><i class="bi bi-check2"></i> Classroom locations</li>
                            <li><i class="bi bi-check2"></i> Exam schedules</li>
                            <li><i class="bi bi-check2"></i> Course enrolment</li>
                        </ul>
                        <a asp-page="/Account/Login" class="lp-user-btn">Login as Student</a>
                    </article>

                    <article class="lp-user-card lp-user-card--accent">
                        <div class="lp-user-card-top">
                            <div class="lp-user-icon"><i class="bi bi-person-badge-fill"></i></div>
                            <span class="lp-user-tag">Class Representatives</span>
                        </div>
                        <h3>Lead your class with the right tools</h3>
                        <p>Manage class groups, review sign-off submissions, communicate with the HOD, and keep your cohort informed.</p>
                        <ul class="lp-user-list">
                            <li><i class="bi bi-check2"></i> Course sign-off review</li>
                            <li><i class="bi bi-check2"></i> Class group management</li>
                            <li><i class="bi bi-check2"></i> Private HOD messaging</li>
                            <li><i class="bi bi-check2"></i> CP profile directory</li>
                        </ul>
                        <a asp-page="/Account/Login" class="lp-user-btn">Login as CP</a>
                    </article>

                    <article class="lp-user-card">
                        <div class="lp-user-card-top">
                            <div class="lp-user-icon"><i class="bi bi-building"></i></div>
                            <span class="lp-user-tag">Administrators</span>
                        </div>
                        <h3>Manage the academic environment</h3>
                        <p>Oversee students, manage course completions, send messages to CPs, and keep the academic calendar running smoothly.</p>
                        <ul class="lp-user-list">
                            <li><i class="bi bi-check2"></i> Student management</li>
                            <li><i class="bi bi-check2"></i> HOD Chat with all CPs</li>
                            <li><i class="bi bi-check2"></i> Schedule oversight</li>
                            <li><i class="bi bi-check2"></i> Academic reports</li>
                        </ul>
                        <a asp-page="/Account/Login" class="lp-user-btn">Login as Admin</a>
                    </article>

                </div>

            </div>
        </section>


        <!-- ═══════════════════════════════════
             HOW IT WORKS — 3 steps
        ════════════════════════════════════ -->
        <section class="lp-steps" id="how-it-works">
            <div class="lp-container">

                <div class="lp-section-head">
                    <span class="lp-eyebrow">How It Works</span>
                    <h2 class="lp-h2">Simple access to academic information.</h2>
                    <p class="lp-section-sub">Get the information you need in three straightforward steps.</p>
                </div>

                <div class="lp-steps-grid">

                    <div class="lp-step">
                        <div class="lp-step-num">01</div>
                        <div class="lp-step-icon"><i class="bi bi-box-arrow-in-right"></i></div>
                        <h3>Login</h3>
                        <p>Sign in with your university credentials. Students, CPs, and admins each have their own dedicated dashboard.</p>
                    </div>

                    <div class="lp-step-arrow"></div>

                    <div class="lp-step">
                        <div class="lp-step-num">02</div>
                        <div class="lp-step-icon"><i class="bi bi-search"></i></div>
                        <h3>Explore</h3>
                        <p>Find your schedule, course details, classroom locations, and any academic updates relevant to your role.</p>
                    </div>

                    <div class="lp-step-arrow"></div>

                    <div class="lp-step">
                        <div class="lp-step-num">03</div>
                        <div class="lp-step-icon"><i class="bi bi-bell"></i></div>
                        <h3>Stay Updated</h3>
                        <p>Track schedule changes, sign-off statuses, HOD messages, and academic announcements throughout the semester.</p>
                    </div>

                </div>

            </div>
        </section>


        <!-- ═══════════════════════════════════
             TESTIMONIAL — like ALU parent quotes
        ════════════════════════════════════ -->
        <section class="lp-testimonial">
            <div class="lp-container lp-testimonial-inner">

                <div class="lp-quote-icon"><i class="bi bi-quote"></i></div>

                <blockquote class="lp-testimonial-quote">
                    "Having all my course schedules, classroom changes, and academic
                    updates in one place has completely changed how I prepare for
                    each week. CSAS is exactly what UNILAK needed."
                </blockquote>

                <div class="lp-testimonial-author">
                    <div class="lp-testimonial-avatar">
                        <i class="bi bi-person-fill"></i>
                    </div>
                    <div>
                        <strong>CIS Student</strong>
                        <span>UNILAK</span>
                    </div>
                </div>

            </div>
        </section>


        <!-- ═══════════════════════════════════
             FINAL CTA
        ════════════════════════════════════ -->
        <section class="lp-cta">
            <div class="lp-container lp-cta-inner">
                <span class="lp-eyebrow lp-eyebrow--light">Academic Awareness</span>
                <h2 class="lp-cta-h2">
                    Stay informed.<br>
                    <em>Stay organised.</em>
                </h2>
                <p class="lp-cta-sub">
                    The UNILAK academic community deserves a platform that keeps everyone
                    in sync, from the first lecture to the final sign-off.
                </p>
                <a asp-page="/Account/Login" class="lp-btn-white">
                    Login to the System
                </a>
            </div>
        </section>

    </main>


    <!-- ═══════════════════════════════════
         FOOTER
    ════════════════════════════════════ -->
    <footer class="lp-footer">
        <div class="lp-container">

            <div class="lp-footer-top">

                <div class="lp-footer-brand-col">
                    <a asp-page="/Index" class="lp-brand">
                        <span class="lp-brand-logo">
                            <img src="~/images/PNG_LOGO-_UNILAK-removebg-preview.png" alt="UNILAK" />
                        </span>
                        <span class="lp-brand-text">
                            <strong>UNILAK</strong>
                            <small>Academic Awareness System</small>
                        </span>
                    </a>
                    <p class="lp-footer-about">
                        CSAS is the official course schedule and academic awareness platform
                        for the UNILAK CIS Department.
                    </p>
                </div>

                <div class="lp-footer-col">
                    <h4>Platform</h4>
                    <a href="#features">Features</a>
                    <a href="#users">Users</a>
                    <a href="#how-it-works">How It Works</a>
                </div>

                <div class="lp-footer-col">
                    <h4>Access</h4>
                    <a asp-page="/Account/Login">Student Login</a>
                    <a asp-page="/Account/Login">CP Login</a>
                    <a asp-page="/Account/Login">Admin Login</a>
                </div>

                <div class="lp-footer-col">
                    <h4>University</h4>
                    <a href="#users">Students</a>
                    <a href="#users">Lecturers</a>
                    <a href="#users">Class Representatives</a>
                    <a href="#users">Administrators</a>
                </div>

                <div class="lp-footer-col">
                    <h4>Contact</h4>
                    <span><i class="bi bi-geo-alt"></i> Kigali, Rwanda</span>
                    <span><i class="bi bi-envelope"></i> info@unilak.ac.rw</span>
                    <span><i class="bi bi-telephone"></i> +250 788 000 000</span>
                </div>

            </div>

            <div class="lp-footer-bottom">
                <span>© @DateTime.Now.Year UNILAK. All rights reserved.</span>
                <span>Course Schedule &amp; Academic Awareness System</span>
            </div>

        </div>
    </footer>

</div><!-- /lp-root -->


<script>
document.addEventListener("DOMContentLoaded", function () {

    /* ── Nav scroll behaviour (transparent → solid) ── */
    var nav = document.getElementById("lpNav");
    function updateNav() {
        if (window.scrollY > 60) {
            nav.classList.add("lp-nav-solid");
        } else {
            nav.classList.remove("lp-nav-solid");
        }
    }
    window.addEventListener("scroll", updateNav, { passive: true });
    updateNav();

    /* ── Mobile drawer ── */
    var toggle  = document.getElementById("lpNavToggle");
    var drawer  = document.getElementById("lpMobileDrawer");
    var icon    = toggle.querySelector("i");

    toggle.addEventListener("click", function () {
        var open = drawer.classList.toggle("lp-drawer-open");
        toggle.setAttribute("aria-expanded", open);
        icon.className = open ? "bi bi-x-lg" : "bi bi-list";
    });

    document.addEventListener("click", function (e) {
        if (!nav.contains(e.target)) {
            drawer.classList.remove("lp-drawer-open");
            toggle.setAttribute("aria-expanded", "false");
            icon.className = "bi bi-list";
        }
    });

    window.addEventListener("resize", function () {
        if (window.innerWidth > 900) {
            drawer.classList.remove("lp-drawer-open");
            icon.className = "bi bi-list";
        }
    });
});

function closeMobileMenu() {
    var drawer = document.getElementById("lpMobileDrawer");
    var toggle = document.getElementById("lpNavToggle");
    var icon   = toggle.querySelector("i");
    drawer.classList.remove("lp-drawer-open");
    toggle.setAttribute("aria-expanded", "false");
    icon.className = "bi bi-list";
}
</script>

</body>
</html>
