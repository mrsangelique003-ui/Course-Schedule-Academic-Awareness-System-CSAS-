function _key(cpId) { return 'csas_hod_chat_' + cpId; }

function _load(cpId) {
    var s = localStorage.getItem(_key(cpId));
    if (s) return JSON.parse(s);
    var d = DEFAULTS[cpId] || [];
    if (d.length) localStorage.setItem(_key(cpId), JSON.stringify(d));
    return d;
}
function _save(cpId, msgs) {
    localStorage.setItem(_key(cpId), JSON.stringify(msgs));
}

