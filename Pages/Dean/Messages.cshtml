function openConversation(row) {
    _cpId    = row.dataset.cpid;
    _cpColor = row.dataset.color;
    _cpInit  = row.dataset.init;
    _cpName  = row.dataset.name;

    // Highlight row
    document.querySelectorAll('.cp-row').forEach(function(r){ r.classList.remove('active'); });
    row.classList.add('active');

    // Hide unread badge
    var badge = row.querySelector('.unread-badge');
    if (badge) badge.style.display = 'none';

    // Update header
    document.getElementById('chatHdAv').textContent   = _cpInit;
    document.getElementById('chatHdAv').style.background = _cpColor;
    document.getElementById('chatHdName').textContent = _cpName;
    document.getElementById('chatHdMeta').textContent =
        row.dataset.year + ' · ' + row.dataset.intake + ' · ' + row.dataset.session + ' Session';
    document.getElementById('chatPrivName').textContent = _cpName;

    // Show chat
    document.getElementById('chatEmpty').style.display  = 'none';
    document.getElementById('chatActive').style.display = 'flex';

    renderMsgs();
    document.getElementById('msgBox').focus();
}

