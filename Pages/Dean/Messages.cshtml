function filterCPs() {
    var q   = document.getElementById('cpSearch').value.toLowerCase();
    var int = document.getElementById('filterIntake').value;
    var yr  = document.getElementById('filterYear').value;
    var rows = document.querySelectorAll('.cp-row');
    var cnt  = 0;
    rows.forEach(function(r) {
        var ok = (!q   || r.dataset.name.toLowerCase().includes(q)
                        || r.dataset.intake.toLowerCase().includes(q))
              && (!int || r.dataset.intake === int)
              && (!yr  || r.dataset.year === yr);
        r.style.display = ok ? '' : 'none';
        if (ok) cnt++;
    });
    document.getElementById('cpCountLbl').textContent =
        cnt + ' Class Representative' + (cnt !== 1 ? 's' : '');
}

function esc(s) {
    return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/\n/g,'<br>');
}
</script>
