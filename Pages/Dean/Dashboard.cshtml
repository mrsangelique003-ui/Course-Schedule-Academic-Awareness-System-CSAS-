@page
@model CourseScheduleSystem.Web.Pages.Dean.DashboardModel
@{
    ViewData["Title"] = "Dean / HOD Dashboard";
    Layout = "~/Pages/Shared/_DashboardLayout.cshtml";
    ViewData["ActiveNav"] = "home";
    ViewData["Role"] = "Dean";
    ViewData["UserName"] = User.Identity?.Name ?? "Dean";
}

<div class="dash-welcome">
    <div>
        <h2 class="dash-heading">Dean &amp; HOD Dashboard</h2>
        <p class="dash-subheading">@DateTime.Now.ToString("dddd, dd MMMM yyyy") · Full Administrative Control</p>
    </div>
    <div class="dash-welcome-badge" style="background:rgba(21,86,200,.12);color:#1556c8;">
        <i class="bi bi-briefcase-fill"></i> Dean / HOD — CIT Faculty
    </div>
</div>

<!-- STATS -->
<div class="dash-stats">
    <div class="stat-card stat-blue">
        <div class="stat-icon"><i class="bi bi-book-half"></i></div>
        <div class="stat-info"><span class="stat-val">12</span><span class="stat-label">Active Courses</span></div>
    </div>
    <div class="stat-card stat-green">
        <div class="stat-icon"><i class="bi bi-people-fill"></i></div>
        <div class="stat-info"><span class="stat-val">340</span><span class="stat-label">Enrolled Students</span></div>
    </div>
    <div class="stat-card stat-purple">
        <div class="stat-icon"><i class="bi bi-person-workspace"></i></div>
        <div class="stat-info"><span class="stat-val">8</span><span class="stat-label">Lecturers</span></div>
    </div>
    <div class="stat-card stat-orange">
        <div class="stat-icon"><i class="bi bi-arrow-left-right"></i></div>
        <div class="stat-info"><span class="stat-val">3</span><span class="stat-label">Swap Requests</span></div>
    </div>
</div>

<!-- TAB NAVIGATION -->
<div class="dean-tabs">
    <button class="dean-tab active" onclick="showTab('timetable', this)"><i class="bi bi-calendar3 me-1"></i>Timetables</button>
    <button class="dean-tab" onclick="showTab('courses', this)"><i class="bi bi-book me-1"></i>Courses</button>
    <button class="dean-tab" onclick="showTab('rooms', this)"><i class="bi bi-building me-1"></i>Rooms</button>
    <button class="dean-tab" onclick="showTab('lecturers', this)"><i class="bi bi-person-workspace me-1"></i>Lecturers</button>
    <button class="dean-tab" onclick="showTab('swaps', this)"><i class="bi bi-arrow-left-right me-1"></i>Swap Approvals</button>
    <button class="dean-tab" onclick="showTab('users', this)"><i class="bi bi-people me-1"></i>Users</button>
    <button class="dean-tab" onclick="showTab('audit', this)"><i class="bi bi-journal-text me-1"></i>Audit Log</button>
</div>

