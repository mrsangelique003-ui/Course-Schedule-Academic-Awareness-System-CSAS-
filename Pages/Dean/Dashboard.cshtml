<!-- ═══════════════════════════════════════════════════
     MODALS
════════════════════════════════════════════════════ -->

<!-- Add Schedule Modal -->
<div id="modalAddSchedule" class="dean-modal" style="display:none;">
    <div class="dean-modal-box">
        <div class="dean-modal-header"><span>Add Schedule Entry</span><button onclick="closeModal('modalAddSchedule')">&times;</button></div>
        <div class="dean-modal-body">
            <div class="mb-3"><label class="form-label fw-semibold">Course</label><select class="form-select"><option>CSE301 — Software Engineering</option><option>CSE305 — Database Systems</option><option>CSE310 — HCI</option><option>CSE402 — Software Architecture</option></select></div>
            <div class="mb-3"><label class="form-label fw-semibold">Day of Week</label><select class="form-select"><option>Monday</option><option>Tuesday</option><option>Wednesday</option><option>Thursday</option><option>Friday</option><option>Saturday</option><option>Sunday</option></select></div>
            <div class="row mb-3"><div class="col"><label class="form-label fw-semibold">Start Time</label><input type="time" class="form-control" value="08:00" /></div><div class="col"><label class="form-label fw-semibold">End Time</label><input type="time" class="form-control" value="10:00" /></div></div>
            <div class="mb-3"><label class="form-label fw-semibold">Room</label><select class="form-select"><option>A204 — Block A (60)</option><option>B101 — Block B (80)</option><option>A108 — Block A (40)</option><option>C302 — Block C (50)</option><option>LAB01 — Block D (30)</option></select></div>
            <div class="mb-3"><label class="form-label fw-semibold">Study Session</label><select class="form-select"><option>Day</option><option>Evening</option><option>Weekend</option></select></div>
        </div>
        <div class="dean-modal-footer"><button class="btn-dash-primary">Save Entry</button><button class="btn-dash-cancel" onclick="closeModal('modalAddSchedule')">Cancel</button></div>
    </div>
</div>

<!-- Add Course Modal -->
<div id="modalAddCourse" class="dean-modal" style="display:none;">
    <div class="dean-modal-box">
        <div class="dean-modal-header"><span>Add Course</span><button onclick="closeModal('modalAddCourse')">&times;</button></div>
        <div class="dean-modal-body">
            <div class="mb-3"><label class="form-label fw-semibold">Course Code</label><input type="text" class="form-control" placeholder="e.g. CSE501" /></div>
            <div class="mb-3"><label class="form-label fw-semibold">Course Name</label><input type="text" class="form-control" placeholder="e.g. Advanced Algorithms" /></div>
            <div class="mb-3"><label class="form-label fw-semibold">Lecturer</label><select class="form-select"><option>Dr. J. Mugisha</option><option>Mrs. A. Byukusenge</option><option>Mr. E. Niyonsenga</option><option>Dr. P. Habimana</option></select></div>
            <div class="row mb-3"><div class="col"><label class="form-label fw-semibold">Reg. Opens</label><input type="date" class="form-control" /></div><div class="col"><label class="form-label fw-semibold">Reg. Closes</label><input type="date" class="form-control" /></div></div>
            <div class="mb-3"><label class="form-label fw-semibold">WhatsApp Group Link</label><input type="url" class="form-control" placeholder="https://chat.whatsapp.com/…" /></div>
            <div class="mb-3"><label class="form-label fw-semibold">Description</label><textarea class="form-control" rows="2"></textarea></div>
        </div>
