@page
@model CourseScheduleSystem.Web.Pages.Dean.AuditLogModel
@{ ViewData["Title"]="Audit Log"; Layout="~/Pages/Shared/_DashboardLayout.cshtml"; ViewData["Role"]="Dean"; ViewData["ActiveNav"]="auditlog"; ViewData["UserName"]=User.Identity?.Name??"Dean"; }

<div class="dash-welcome">
    <div><h2 class="dash-heading">System Audit Log</h2><p class="dash-subheading">All user actions across the CSAS platform — timestamped</p></div>
    <div class="dash-welcome-badge" style="background:rgba(180,83,9,.1);color:#b45309;"><i class="bi bi-journal-text"></i> Full History</div>
</div>

<div class="dash-panel">
    <div class="panel-header">
        <span><i class="bi bi-journal-text me-2"></i>Audit Log</span>
        <div style="display:flex;gap:.6rem;flex-wrap:wrap;">
            <select class="panel-select" id="actionFilter" onchange="filterAudit()">
                <option value="">All Actions</option><option>LOGIN</option><option>CREATE</option>
                <option>UPDATE</option><option>DELETE</option><option>ENDORSE</option>
            </select>
            <select class="panel-select" id="userFilter" onchange="filterAudit()">
                <option value="">All Users</option><option>bob (CP)</option><option>alice (Student)</option>
                <option>claire (Quality)</option><option>denis (Dean)</option><option>eric (HOD)</option>
            </select>
            <input type="date" class="panel-select" value="@DateTime.Now.ToString("yyyy-MM-dd")" />
        </div>
    </div>
    <div class="table-responsive">
        <table class="dash-table" id="auditTable">
            <thead><tr><th>Timestamp</th><th>User</th><th>Role</th><th>Action</th><th>Entity</th><th>Details</th><th>IP Address</th></tr></thead>
            <tbody id="auditBody">
                <tr data-action="CREATE" data-user="bob (CP)">
                    <td style="font-size:12px;">28 Aug 12:04</td><td><strong>bob</strong></td><td><span class="role-pill role-cp">CP</span></td>
                    <td><span class="audit-badge audit-create">CREATE</span></td><td>AttendanceFlag</td>
                    <td style="font-size:12px;">Flagged CSE305 Tue 10:00 as Absent</td><td style="font-size:11px;color:#9ca3af;">197.168.1.10</td>
                </tr>
                <tr data-action="LOGIN" data-user="alice (Student)">
                    <td style="font-size:12px;">28 Aug 11:52</td><td><strong>alice</strong></td><td><span class="role-pill role-student">Student</span></td>
                    <td><span class="audit-badge audit-read">LOGIN</span></td><td>Session</td>
                    <td style="font-size:12px;">Logged in successfully</td><td style="font-size:11px;color:#9ca3af;">197.168.1.22</td>
                </tr>
                <tr data-action="ENDORSE" data-user="claire (Quality)">
                    <td style="font-size:12px;">28 Aug 10:30</td><td><strong>claire</strong></td><td><span class="role-pill role-quality">Quality</span></td>
                    <td><span class="audit-badge audit-update">ENDORSE</span></td><td>RoomShift</td>
                    <td style="font-size:12px;">Endorsed swap CSE301 A204→Lab01</td><td style="font-size:11px;color:#9ca3af;">197.168.1.5</td>
                </tr>
                <tr data-action="UPDATE" data-user="denis (Dean)">
                    <td style="font-size:12px;">27 Aug 16:15</td><td><strong>denis</strong></td><td><span class="role-pill role-dean">Dean</span></td>
                    <td><span class="audit-badge audit-update">UPDATE</span></td><td>Course</td>
                    <td style="font-size:12px;">Updated CSE402 registration close date</td><td style="font-size:11px;color:#9ca3af;">197.168.1.1</td>
                </tr>
                <tr data-action="CREATE" data-user="eric (HOD)">
                    <td style="font-size:12px;">27 Aug 09:00</td><td><strong>eric</strong></td><td><span class="role-pill role-dean">HOD</span></td>
                    <td><span class="audit-badge audit-create">CREATE</span></td><td>ScheduleEntry</td>
                    <td style="font-size:12px;">Added CSE402 Thursday 08:00–10:00</td><td style="font-size:11px;color:#9ca3af;">197.168.1.2</td>
                </tr>
                <tr data-action="DELETE" data-user="denis (Dean)">
                    <td style="font-size:12px;">26 Aug 14:30</td><td><strong>denis</strong></td><td><span class="role-pill role-dean">Dean</span></td>
                    <td><span class="audit-badge audit-delete">DELETE</span></td><td>ScheduleEntry</td>
                    <td style="font-size:12px;">Removed duplicate Friday entry for CSE305</td><td style="font-size:11px;color:#9ca3af;">197.168.1.1</td>
                </tr>
                <tr data-action="LOGIN" data-user="alice (Student)">
                    <td style="font-size:12px;">26 Aug 08:00</td><td><strong>alice</strong></td><td><span class="role-pill role-student">Student</span></td>
                    <td><span class="audit-badge audit-read">LOGIN</span></td><td>Session</td>
                    <td style="font-size:12px;">Logged in successfully</td><td style="font-size:11px;color:#9ca3af;">197.168.1.22</td>
                </tr>
                <tr data-action="CREATE" data-user="system">
                    <td style="font-size:12px;">25 Aug 08:00</td><td><strong>system</strong></td><td><span class="role-pill" style="background:#f1f5f9;color:#6c8097;">System</span></td>
                    <td><span class="audit-badge audit-create">SEED</span></td><td>Database</td>
                    <td style="font-size:12px;">Initial seed data applied</td><td style="font-size:11px;color:#9ca3af;">localhost</td>
                </tr>
            </tbody>
        </table>
    </div>
    <div style="padding:.6rem 1.25rem;border-top:1px solid #e2e8f0;font-size:12px;color:#6c8097;background:#f8fafc;border-radius:0 0 13px 13px;">
        <span id="auditCount">Showing 8 records</span>
    </div>
</div>

@section Scripts {
<script>
function filterAudit() {
    var act  = document.getElementById('actionFilter').value;
    var usr  = document.getElementById('userFilter').value;
    var rows = document.querySelectorAll('#auditBody tr');
    var cnt  = 0;
    rows.forEach(function(r) {
        var ok = (!act || r.dataset.action === act) && (!usr || r.dataset.user === usr);
        r.style.display = ok ? '' : 'none';
        if (ok) cnt++;
    });
    document.getElementById('auditCount').textContent = 'Showing ' + cnt + ' records';
}
</script>
}
