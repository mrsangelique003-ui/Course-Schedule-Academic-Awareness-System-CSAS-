@page "{id:int?}"
@model CourseScheduleSystem.Web.Pages.Admin.AssignClassModel

@{
ViewData["Title"] = Model.IsEditMode ? "Update Class" : "Assign Class";
}

<link rel="stylesheet" href="~/css/Admin/AssignClass.css" />

<div class="assign-class-page">


<div class="page-header">
    <div>
        <div class="page-eyebrow">
            <i class="bi bi-calendar2-plus"></i>
            Classroom Management
        </div>

        <h1>@(Model.IsEditMode ? "Update Class" : "Assign Class")</h1>

        <p>
            @(Model.IsEditMode
                ? "Update the schedule, classroom, lecturer, and class representative."
                : "Create a scheduled class by assigning a course, room, lecturer, and class representative.")
        </p>
    </div>

    <a asp-page="/Admin/ClassroomManagement" class="btn btn-light">
        <i class="bi bi-arrow-left"></i>
        Back to Classes
    </a>
</div>

@if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
{
    <div class="alert alert-success">
        <i class="bi bi-check-circle-fill"></i>
        <span>@Model.SuccessMessage</span>
    </div>
}

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger">
        <i class="bi bi-exclamation-triangle-fill"></i>

        <div asp-validation-summary="All"></div>
    </div>
}

<form method="post" class="assign-form">

    <input type="hidden" asp-for="Input.Id" />

    <div class="form-layout">

        <section class="form-card">

            <div class="section-header">
                <div class="section-icon">
                    <i class="bi bi-book"></i>
                </div>

                <div>
                    <h2>Class Information</h2>
                    <p>Select the course and define the class schedule.</p>
                </div>
            </div>

            <div class="form-grid">

                <div class="form-group full-width">
                    <label asp-for="Input.CourseId">
                        Course
                        <span>*</span>
                    </label>

                    <select asp-for="Input.CourseId" class="form-control">
                        <option value="0">Select a course</option>

                        @foreach (var course in Model.Courses)
                        {
                            <option value="@course.Id">
                                @course.Code — @course.Name
                            </option>
                        }
                    </select>

                    <span asp-validation-for="Input.CourseId" class="field-error"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Input.RoomId">
                        Classroom
                        <span>*</span>
                    </label>

                    <select asp-for="Input.RoomId" class="form-control">
                        <option value="0">Select a classroom</option>

                        @foreach (var room in Model.Rooms)
                        {
                            <option value="@room.Id">
                                @room.RoomNumber — @room.Building
                                (Capacity @room.Capacity)
                            </option>
                        }
                    </select>

                    <span asp-validation-for="Input.RoomId" class="field-error"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Input.DayOfWeek">
                        Day
                        <span>*</span>
                    </label>

                    <select asp-for="Input.DayOfWeek" class="form-control">
                        @foreach (var day in Model.Days)
                        {
                            <option value="@day">
                                @day
                            </option>
                        }
                    </select>

                    <span asp-validation-for="Input.DayOfWeek" class="field-error"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Input.StartTime">
                        Start Time
                        <span>*</span>
                    </label>

                    <input
                        asp-for="Input.StartTime"
                        type="time"
                        class="form-control" />

                    <span asp-validation-for="Input.StartTime" class="field-error"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Input.EndTime">
                        End Time
                        <span>*</span>
                    </label>

                    <input
                        asp-for="Input.EndTime"
                        type="time"
                        class="form-control" />

                    <span asp-validation-for="Input.EndTime" class="field-error"></span>
                </div>

                <div class="form-group full-width">
                    <label asp-for="Input.StudySession">
                        Study Session
                        <span>*</span>
                    </label>

                    <select asp-for="Input.StudySession" class="form-control">
                        @foreach (var session in Model.StudySessions)
                        {
                            <option value="@session.Value">
                                @session.Label
                            </option>
                        }
                    </select>

                    <span asp-validation-for="Input.StudySession" class="field-error"></span>

                    <div class="session-help">
                        <span class="session-help-item day">
                            DAY
                        </span>

                        <span class="session-help-item evening">
                            EVENING
                        </span>

                        <span class="session-help-item weekend">
                            WEEKEND
                        </span>
                    </div>
                </div>

                <div class="form-group full-width">
                    <label asp-for="Input.Notes">
                        Notes
                    </label>

                    <textarea
                        asp-for="Input.Notes"
                        class="form-control"
                        rows="3"
                        maxlength="500"
                        placeholder="Optional notes about this class..."></textarea>

                    <span asp-validation-for="Input.Notes" class="field-error"></span>
                </div>

            </div>

        </section>

        <section class="form-card">

            <div class="section-header">
                <div class="section-icon">
                    <i class="bi bi-person-badge"></i>
                </div>

                <div>
                    <h2>Lecturer Assignment</h2>
                    <p>Search and assign the lecturer responsible for this class.</p>
                </div>
            </div>

            <div class="selection-search">
                <i class="bi bi-search"></i>

                <input
                    type="search"
                    id="lecturerSearch"
                    placeholder="Search lecturer by name or Staff ID..."
                    autocomplete="off" />
            </div>

            <div class="selection-list" id="lecturerList">

                <button
                    type="button"
                    class="selection-item remove-selection"
                    id="removeLecturer"
                    data-id="">

                    <span class="selection-icon">
                        <i class="bi bi-person-x"></i>
                    </span>

                    <span>
                        <strong>Remove lecturer</strong>
                        <small>Leave this class without a lecturer</small>
                    </span>
                </button>

                @foreach (var lecturer in Model.Lecturers)
                {
                    <button
                        type="button"
                        class="selection-item lecturer-item @(Model.Input.LecturerId == lecturer.Id ? "selected" : "")"
                        data-id="@lecturer.Id"
                        data-search="@($"{lecturer.FullName} {lecturer.StaffId} {lecturer.Department}")">

                        <span class="selection-icon">
                            <i class="bi bi-person-badge"></i>
                        </span>

                        <span>
                            <strong>@lecturer.FullName</strong>
                            <small>
                                @lecturer.StaffId · @lecturer.Department
                            </small>
                        </span>

                        <span class="selection-check">
                            <i class="bi bi-check-circle-fill"></i>
                        </span>
                    </button>
                }

            </div>

            <input type="hidden" asp-for="Input.LecturerId" />

            <div class="selected-summary" id="selectedLecturer">
                @if (Model.SelectedLecturer != null)
                {
                    <i class="bi bi-check-circle-fill"></i>

                    <span>
                        <strong>@Model.SelectedLecturer.FullName</strong>
                        <small>@Model.SelectedLecturer.StaffId</small>
                    </span>
                }
                else
                {
                    <i class="bi bi-person-dash"></i>

                    <span>
                        <strong>No lecturer selected</strong>
                        <small>You can assign one or leave the class unassigned.</small>
                    </span>
                }
            </div>

        </section>

        <section class="form-card representative-card">

            <div class="section-header">
                <div class="section-icon">
                    <i class="bi bi-people"></i>
                </div>

                <div>
                    <h2>Class Representative</h2>
                    <p>Search the registered representatives and assign one to this class.</p>
                </div>
            </div>

            <div class="selection-search">
                <i class="bi bi-search"></i>

                <input
                    type="search"
                    id="representativeSearch"
                    placeholder="Search by name, RegNo, email, or phone..."
                    autocomplete="off" />
            </div>

            <div class="representative-table-wrapper">

                <table class="representative-table">

                    <thead>
                        <tr>
                            <th>Representative</th>
                            <th>RegNo</th>
                            <th>Phone</th>
                            <th>Intake</th>
                            <th>Level</th>
                            <th></th>
                        </tr>
                    </thead>

                    <tbody id="representativeList">

                        <tr
                            class="remove-row @(Model.Input.ClassRepresentativeId == null ? "selected" : "")"
                            data-id="">

                            <td colspan="5">
                                <div class="representative-person">
                                    <span class="table-avatar remove-avatar">
                                        <i class="bi bi-person-x"></i>
                                    </span>

                                    <span>
                                        <strong>Remove representative</strong>
                                        <small>Leave this class without a CP</small>
                                    </span>
                                </div>
                            </td>

                            <td>
                                <button
                                    type="button"
                                    class="table-select remove-cp-button"
                                    data-id="">
                                    <i class="bi bi-check"></i>
                                </button>
                            </td>
                        </tr>

                        @foreach (var representative in Model.Representatives)
                        {
                            <tr
                                class="representative-row @(Model.Input.ClassRepresentativeId == representative.Id ? "selected" : "")"
                                data-id="@representative.Id"
                                data-search="@($"{representative.FullName} {representative.RegNo} {representative.Email} {representative.PhoneNumber} {representative.Department} {representative.Faculty} {representative.Intake} {representative.Level}")">

                                <td>
                                    <div class="representative-person">
                                        <span class="table-avatar">
                                            <i class="bi bi-person"></i>
                                        </span>

                                        <span>
                                            <strong>@representative.FullName</strong>
                                            <small>@representative.Email</small>
                                        </span>
                                    </div>
                                </td>

                                <td>
                                    <span class="table-value">
                                        @representative.RegNo
                                    </span>
                                </td>

                                <td>
                                    <span class="table-value">
                                        @representative.PhoneNumber
                                    </span>
                                </td>

                                <td>
                                    <span class="table-value">
                                        @representative.Intake
                                    </span>
                                </td>

                                <td>
                                    <span class="table-value">
                                        @representative.Level
                                    </span>
                                </td>

                                <td>
                                    <button
                                        type="button"
                                        class="table-select select-cp-button"
                                        data-id="@representative.Id">
                                        <i class="bi bi-check"></i>
                                    </button>
                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

            <input
                type="hidden"
                asp-for="Input.ClassRepresentativeId" />

            <div class="selected-summary" id="selectedRepresentative">

                @if (Model.SelectedRepresentative != null)
                {
                    <i class="bi bi-check-circle-fill"></i>

                    <span>
                        <strong>@Model.SelectedRepresentative.FullName</strong>
                        <small>
                            @Model.SelectedRepresentative.RegNo ·
                            @Model.SelectedRepresentative.PhoneNumber
                        </small>
                    </span>
                }
                else
                {
                    <i class="bi bi-person-dash"></i>

                    <span>
                        <strong>No representative selected</strong>
                        <small>You can assign one or leave the class unassigned.</small>
                    </span>
                }

            </div>

        </section>

        <section class="form-card class-state-card">

            <div class="section-header">
                <div class="section-icon">
                    <i class="bi bi-toggle2-on"></i>
                </div>

                <div>
                    <h2>Class Status</h2>
                    <p>Control whether this class remains active.</p>
                </div>
            </div>

            <label class="toggle-row">

                <span class="toggle-text">
                    <strong>Active Class</strong>
                    <small>
                        Active classes appear in classroom schedules.
                    </small>
                </span>

                <input
                    asp-for="Input.IsActive"
                    type="checkbox" />

                <span class="toggle-switch"></span>

            </label>

            @if (Model.IsEditMode)
            {
                <div class="existing-class-info">
                    <span>Class ID</span>
                    <strong>CLS-@Model.Input.Id.Value.ToString("D6")</strong>
                </div>
            }

        </section>

    </div>

    <div class="form-actions">

        <a
            asp-page="/Admin/ClassroomManagement"
            class="btn btn-light">
            Cancel
        </a>

        <button
            type="submit"
            class="btn btn-primary">

            <i class="bi bi-check2-circle"></i>

            @(Model.IsEditMode
                ? "Save Changes"
                : "Assign Class")

        </button>

    </div>

</form>


</div>

@section Scripts
{ <partial name="_ValidationScriptsPartial" />


<script>
    document.addEventListener("DOMContentLoaded", function () {

        const lecturerSearch =
            document.getElementById("lecturerSearch");

        const lecturerItems =
            Array.from(document.querySelectorAll(".lecturer-item"));

        const lecturerInput =
            document.getElementById("Input_LecturerId");

        const selectedLecturer =
            document.getElementById("selectedLecturer");

        const removeLecturer =
            document.getElementById("removeLecturer");

        function updateLecturer(id) {

            lecturerInput.value = id || "";

            lecturerItems.forEach(item => {
                item.classList.toggle(
                    "selected",
                    item.dataset.id === String(id)
                );
            });

            if (!id) {
                selectedLecturer.innerHTML = `
                    <i class="bi bi-person-dash"></i>
                    <span>
                        <strong>No lecturer selected</strong>
                        <small>You can assign one or leave the class unassigned.</small>
                    </span>
                `;
                return;
            }

            const item =
                lecturerItems.find(x => x.dataset.id === String(id));

            if (!item) {
                return;
            }

            const name =
                item.querySelector("strong")?.textContent?.trim() || "";

            const staffId =
                item.querySelector("small")?.textContent?.trim() || "";

            selectedLecturer.innerHTML = `
                <i class="bi bi-check-circle-fill"></i>
                <span>
                    <strong>${name}</strong>
                    <small>${staffId}</small>
                </span>
            `;
        }

        lecturerItems.forEach(item => {
            item.addEventListener("click", function () {
                updateLecturer(this.dataset.id);
            });
        });

        removeLecturer?.addEventListener("click", function () {
            updateLecturer("");
        });

        lecturerSearch?.addEventListener("input", function () {

            const value =
                this.value.trim().toLowerCase();

            lecturerItems.forEach(item => {

                const search =
                    item.dataset.search?.toLowerCase() || "";

                item.hidden =
                    value.length > 0 &&
                    !search.includes(value);
            });
        });

        const representativeSearch =
            document.getElementById("representativeSearch");

        const representativeRows =
            Array.from(document.querySelectorAll(".representative-row"));

        const representativeInput =
            document.getElementById("Input_ClassRepresentativeId");

        const selectedRepresentative =
            document.getElementById("selectedRepresentative");

        function updateRepresentative(id) {

            representativeInput.value = id || "";

            representativeRows.forEach(row => {
                row.classList.toggle(
                    "selected",
                    row.dataset.id === String(id)
                );
            });

            document
                .querySelector(".remove-row")
                ?.classList.toggle("selected", !id);

            if (!id) {

                selectedRepresentative.innerHTML = `
                    <i class="bi bi-person-dash"></i>
                    <span>
                        <strong>No representative selected</strong>
                        <small>You can assign one or leave the class unassigned.</small>
                    </span>
                `;

                return;
            }

            const row =
                representativeRows.find(
                    x => x.dataset.id === String(id)
                );

            if (!row) {
                return;
            }

            const name =
                row.querySelector("strong")?.textContent?.trim() || "";

            const values =
                Array.from(row.querySelectorAll(".table-value"))
                    .map(x => x.textContent.trim());

            selectedRepresentative.innerHTML = `
                <i class="bi bi-check-circle-fill"></i>
                <span>
                    <strong>${name}</strong>
                    <small>
                        ${values[0] || ""} · ${values[1] || ""}
                    </small>
                </span>
            `;
        }

        representativeRows.forEach(row => {

            row.addEventListener("click", function () {
                updateRepresentative(this.dataset.id);
            });

        });

        document
            .querySelector(".remove-cp-button")
            ?.addEventListener("click", function (event) {
                event.stopPropagation();
                updateRepresentative("");
            });

        representativeSearch?.addEventListener("input", function () {

            const value =
                this.value.trim().toLowerCase();

            representativeRows.forEach(row => {

                const search =
                    row.dataset.search?.toLowerCase() || "";

                row.hidden =
                    value.length > 0 &&
                    !search.includes(value);
            });
        });

    });
</script>


}
