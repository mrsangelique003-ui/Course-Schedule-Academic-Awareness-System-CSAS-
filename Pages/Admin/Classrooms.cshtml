@page
@model CourseScheduleSystem.Web.Pages.Admin.ClassroomsModel

@using System.Text.Json
@using CourseScheduleSystem.Web.Models

@{
ViewData["Title"] = "Classrooms";


var scheduleData = Model.ScheduleEntries.Select(s => new
{
    id = s.Id,
    roomId = s.RoomId,
    courseCode = s.Course?.Code ?? "",
    courseName = s.Course?.Name ?? "",
    lecturerId = s.LecturerId,
    lecturerName = s.Lecturer?.FullName ?? "",
    lecturerStaffId = s.Lecturer?.StaffId ?? "",
    representativeId = s.ClassRepresentativeId,
    representativeName = s.ClassRepresentative?.FullName ?? "",
    representativeRegNo = s.ClassRepresentative?.RegNo ?? "",
    representativePhone = s.ClassRepresentative?.PhoneNumber ?? "",
    representativeEmail = s.ClassRepresentative?.Email ?? "",
    representativeIntake = s.ClassRepresentative?.Intake ?? "",
    representativeLevel = s.ClassRepresentative?.Level ?? "",
    dayOfWeek = s.DayOfWeek.ToString(),
    startTime = s.StartTime.ToString("HH:mm"),
    endTime = s.EndTime.ToString("HH:mm"),
    startDate = s.StartDate.ToString("yyyy-MM-dd"),
    endDate = s.EndDate.ToString("yyyy-MM-dd"),
    studySession = s.StudySession.ToString(),
    status = s.Status.ToString(),
    notes = s.Notes ?? ""
});

var scheduleJson = JsonSerializer.Serialize(scheduleData);


}

<link rel="stylesheet" href="~/css/Admin/Classrooms.css" />

<div class="admin-page">


<header class="page-header">
    <div class="breadcrumb">
        <a asp-page="/Admin/Dashboard">
            <i class="bi bi-grid-1x2"></i>
            Dashboard
        </a>
        <i class="bi bi-chevron-right"></i>
        <span>Classrooms</span>
    </div>

    <div class="page-heading">
        <div>
            <h1>Classroom Management</h1>
            <p>
                Manage classrooms, monitor availability and view scheduled classes.
            </p>
        </div>
    </div>
</header>

@if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
{
    <div class="server-message success-message">
        <i class="bi bi-check-circle-fill"></i>
        <span>@Model.SuccessMessage</span>
    </div>
}

<section class="stats-grid">

    <article class="stat-card">
        <div class="stat-icon blue">
            <i class="bi bi-building"></i>
        </div>

        <div class="stat-content">
            <span class="stat-label">Total Classrooms</span>
            <strong>@Model.TotalClassrooms</strong>
        </div>
    </article>

    <article class="stat-card">
        <div class="stat-icon green">
            <i class="bi bi-door-open"></i>
        </div>

        <div class="stat-content">
            <span class="stat-label">Available</span>
            <strong>@Model.AvailableClassrooms</strong>
        </div>
    </article>

    <article class="stat-card">
        <div class="stat-icon orange">
            <i class="bi bi-door-closed"></i>
        </div>

        <div class="stat-content">
            <span class="stat-label">Unavailable</span>
            <strong>@Model.UnavailableClassrooms</strong>
        </div>
    </article>

    <article class="stat-card">
        <div class="stat-icon purple">
            <i class="bi bi-people"></i>
        </div>

        <div class="stat-content">
            <span class="stat-label">Total Capacity</span>
            <strong>@Model.TotalCapacity</strong>
        </div>
    </article>

</section>

<section class="content-panel">

    <div class="panel-toolbar">

        <div class="availability-filter">
            <button type="button"
                    class="filter-btn active"
                    data-filter="all">
                All
            </button>

            <button type="button"
                    class="filter-btn"
                    data-filter="available">
                Available
            </button>

            <button type="button"
                    class="filter-btn"
                    data-filter="unavailable">
                Unavailable
            </button>
        </div>

        <div class="toolbar-right">

            <div class="search-box">
                <i class="bi bi-search"></i>
                <input type="search"
                       id="classroomSearch"
                       placeholder="Search classrooms..."
                       autocomplete="off" />
            </div>

            <button type="button"
                    class="clear-filter-btn"
                    id="clearFilters">
                <i class="bi bi-arrow-counterclockwise"></i>
                <span>Clear</span>
            </button>

        </div>

    </div>

    <div class="table-info">
        <span>
            Showing <strong id="visibleCount">@Model.Classrooms.Count</strong>
            of <strong>@Model.Classrooms.Count</strong> classrooms
        </span>

        <span class="table-hint">
            <i class="bi bi-info-circle"></i>
            Select a classroom to view its scheduled classes
        </span>
    </div>

    @if (Model.Classrooms.Count > 0)
    {
        <div class="table-wrapper">

            <table class="classroom-table">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Classroom</th>
                        <th>Building</th>
                        <th>Room Type</th>
                        <th>Capacity</th>
                        <th>Availability</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody id="classroomTableBody">

                    @for (var i = 0; i < Model.Classrooms.Count; i++)
                    {
                        var classroom = Model.Classrooms[i];

                        <tr class="classroom-row"
                            data-room-number="@classroom.RoomNumber.ToLowerInvariant()"
                            data-building="@classroom.Building.ToLowerInvariant()"
                            data-room-type="@(classroom.RoomType ?? "").ToLowerInvariant()"
                            data-availability="@(classroom.IsAvailable ? "available" : "unavailable")"
                            data-room-id="@classroom.Id">

                            <td class="row-number">
                                @(i + 1)
                            </td>

                            <td>
                                <div class="room-cell">
                                    <div class="room-icon">
                                        <i class="bi bi-door-open"></i>
                                    </div>

                                    <div>
                                        <strong>@classroom.RoomNumber</strong>
                                        <span>Room ID: @classroom.Id</span>
                                    </div>
                                </div>
                            </td>

                            <td>
                                <span class="building-name">
                                    @classroom.Building
                                </span>
                            </td>

                            <td>
                                <span class="room-type">
                                    @(string.IsNullOrWhiteSpace(classroom.RoomType)
                                        ? "General Classroom"
                                        : classroom.RoomType)
                                </span>
                            </td>

                            <td>
                                <span class="capacity-value">
                                    <i class="bi bi-people"></i>
                                    @classroom.Capacity
                                </span>
                            </td>

                            <td>
                                @if (classroom.IsAvailable)
                                {
                                    <span class="status-badge available">
                                        <span class="status-dot"></span>
                                        Available
                                    </span>
                                }
                                else
                                {
                                    <span class="status-badge unavailable">
                                        <span class="status-dot"></span>
                                        Unavailable
                                    </span>
                                }
                            </td>

                            <td>
                                <div class="action-buttons">

                                    <button type="button"
                                            class="action-btn view-btn"
                                            data-view-room="@classroom.Id">
                                        <i class="bi bi-eye"></i>
                                        <span>View</span>
                                    </button>

                                    <a asp-page="/Admin/AssignClass"
                                       class="action-btn assign-btn">
                                        <i class="bi bi-calendar-plus"></i>
                                        <span>Assign Class</span>
                                    </a>

                                </div>
                            </td>

                        </tr>
                    }

                </tbody>
            </table>

        </div>

        <div class="filtered-empty" id="filteredEmpty">
            <div class="empty-icon">
                <i class="bi bi-search"></i>
            </div>

            <h3>No classrooms found</h3>

            <p>
                No classrooms match your current search or availability filter.
            </p>
        </div>
    }
    else
    {
        <div class="empty-state">
            <div class="empty-icon">
                <i class="bi bi-building-x"></i>
            </div>

            <h3>No classrooms available</h3>

            <p>
                There are currently no classrooms registered in the system.
            </p>
        </div>
    }

</section>


</div>

<div class="modal-overlay"
     id="viewClassroomModal"
     aria-hidden="true">


<div class="modal-card view-modal"
     role="dialog"
     aria-modal="true"
     aria-labelledby="viewClassroomTitle">

    <div class="modal-header">

        <div>
            <span class="modal-eyebrow">Classroom Details</span>

            <h2 id="viewClassroomTitle">Classroom</h2>

            <p id="viewClassroomSubtitle">
                Classroom information and scheduled classes.
            </p>
        </div>

        <button type="button"
                class="modal-close"
                data-close-modal
                aria-label="Close">
            <i class="bi bi-x-lg"></i>
        </button>

    </div>

    <div class="classroom-detail-grid">

        <div class="detail-card">
            <span>Room Number</span>
            <strong id="detailRoomNumber">—</strong>
        </div>

        <div class="detail-card">
            <span>Building</span>
            <strong id="detailBuilding">—</strong>
        </div>

        <div class="detail-card">
            <span>Room Type</span>
            <strong id="detailRoomType">—</strong>
        </div>

        <div class="detail-card">
            <span>Capacity</span>
            <strong id="detailCapacity">—</strong>
        </div>

    </div>

    <div class="availability-detail">
        <span>Current Availability</span>
        <span id="detailAvailability"
              class="status-badge available">
            <span class="status-dot"></span>
            Available
        </span>
    </div>

    <section class="assignment-section">

        <div class="section-heading">
            <div>
                <span class="section-eyebrow">Schedule</span>
                <h3>Scheduled Classes</h3>
            </div>

            <span class="schedule-count"
                  id="scheduleCount">
                0 classes
            </span>
        </div>

        <div class="assignment-details"
             id="assignmentDetails">
        </div>

    </section>

    <div class="modal-actions">
        <button type="button"
                class="secondary-btn"
                data-close-modal>
            <i class="bi bi-x"></i>
            Close
        </button>

        <a asp-page="/Admin/AssignClass"
           class="primary-btn">
            <i class="bi bi-calendar-plus"></i>
            Assign New Class
        </a>
    </div>

</div>


</div>

<div class="toast-container">
    <div class="success-toast"
         id="successToast">


    <div class="toast-icon">
        <i class="bi bi-check-lg"></i>
    </div>

    <div class="toast-content">
        <strong>Success</strong>
        <span id="toastMessage">Operation completed successfully.</span>
    </div>

    <button type="button"
            id="closeToast"
            aria-label="Close notification">
        <i class="bi bi-x"></i>
    </button>

</div>


</div>

<script>
    const classrooms = @Html.Raw(
        JsonSerializer.Serialize(
            Model.Classrooms.Select(r => new
            {
                id = r.Id,
                roomNumber = r.RoomNumber,
                building = r.Building,
                roomType = r.RoomType ?? "General Classroom",
                capacity = r.Capacity,
                isAvailable = r.IsAvailable
            })
        )
    );

    const scheduleEntries = @Html.Raw(scheduleJson);

    const searchInput = document.getElementById("classroomSearch");
    const clearFiltersButton = document.getElementById("clearFilters");
    const filterButtons = document.querySelectorAll(".filter-btn");
    const classroomRows = document.querySelectorAll(".classroom-row");
    const visibleCount = document.getElementById("visibleCount");
    const filteredEmpty = document.getElementById("filteredEmpty");

    let activeFilter = "all";

    function applyFilters() {
        const searchTerm = (searchInput?.value || "").trim().toLowerCase();
        let count = 0;

        classroomRows.forEach(row => {
            const roomNumber = row.dataset.roomNumber || "";
            const building = row.dataset.building || "";
            const roomType = row.dataset.roomType || "";
            const availability = row.dataset.availability || "";

            const matchesSearch =
                !searchTerm ||
                roomNumber.includes(searchTerm) ||
                building.includes(searchTerm) ||
                roomType.includes(searchTerm);

            const matchesFilter =
                activeFilter === "all" ||
                availability === activeFilter;

            const visible = matchesSearch && matchesFilter;

            row.style.display = visible ? "" : "none";

            if (visible) {
                count++;
            }
        });

        if (visibleCount) {
            visibleCount.textContent = count;
        }

        if (filteredEmpty) {
            filteredEmpty.classList.toggle(
                "show",
                count === 0 && classroomRows.length > 0
            );
        }
    }

    filterButtons.forEach(button => {
        button.addEventListener("click", () => {
            filterButtons.forEach(item => item.classList.remove("active"));

            button.classList.add("active");

            activeFilter = button.dataset.filter || "all";

            applyFilters();
        });
    });

    searchInput?.addEventListener("input", applyFilters);

    clearFiltersButton?.addEventListener("click", () => {
        if (searchInput) {
            searchInput.value = "";
        }

        activeFilter = "all";

        filterButtons.forEach(button => {
            button.classList.toggle(
                "active",
                button.dataset.filter === "all"
            );
        });

        applyFilters();
    });

    const viewModal = document.getElementById("viewClassroomModal");
    const assignmentDetails = document.getElementById("assignmentDetails");

    function escapeHtml(value) {
        return String(value ?? "")
            .replaceAll("&", "&amp;")
            .replaceAll("<", "&lt;")
            .replaceAll(">", "&gt;")
            .replaceAll('"', "&quot;")
            .replaceAll("'", "&#039;");
    }

    function getClassroom(roomId) {
        return classrooms.find(room => Number(room.id) === Number(roomId));
    }

    function getRoomSchedule(roomId) {
        return scheduleEntries
            .filter(item => Number(item.roomId) === Number(roomId))
            .sort((a, b) => {
                const dayOrder = {
                    Sunday: 0,
                    Monday: 1,
                    Tuesday: 2,
                    Wednesday: 3,
                    Thursday: 4,
                    Friday: 5,
                    Saturday: 6
                };

                const dayDifference =
                    (dayOrder[a.dayOfWeek] ?? 99) -
                    (dayOrder[b.dayOfWeek] ?? 99);

                if (dayDifference !== 0) {
                    return dayDifference;
                }

                return (a.startTime || "").localeCompare(b.startTime || "");
            });
    }

    function formatSession(session) {
        const value = String(session || "").toUpperCase();

        if (value === "DAY") {
            return "DAY";
        }

        if (value === "EVENING") {
            return "EVENING";
        }

        if (value === "WEEKEND") {
            return "WEEKEND";
        }

        return value || "—";
    }

    function formatDateRange(startDate, endDate) {
        if (!startDate && !endDate) {
            return "No date range";
        }

        if (startDate && endDate && startDate === endDate) {
            return startDate;
        }

        return `${startDate || "—"} to ${endDate || "—"}`;
    }

    function openViewModal(roomId) {
        const room = getClassroom(roomId);

        if (!room || !viewModal) {
            return;
        }

        document.getElementById("viewClassroomTitle").textContent =
            room.roomNumber;

        document.getElementById("viewClassroomSubtitle").textContent =
            `${room.building} · Classroom ID ${room.id}`;

        document.getElementById("detailRoomNumber").textContent =
            room.roomNumber;

        document.getElementById("detailBuilding").textContent =
            room.building;

        document.getElementById("detailRoomType").textContent =
            room.roomType || "General Classroom";

        document.getElementById("detailCapacity").textContent =
            `${room.capacity} seats`;

        const availabilityElement =
            document.getElementById("detailAvailability");

        availabilityElement.className =
            `status-badge ${room.isAvailable ? "available" : "unavailable"}`;

        availabilityElement.innerHTML = `
            <span class="status-dot"></span>
            ${room.isAvailable ? "Available" : "Unavailable"}
        `;

        const roomSchedules = getRoomSchedule(roomId);

        document.getElementById("scheduleCount").textContent =
            `${roomSchedules.length} ${roomSchedules.length === 1 ? "class" : "classes"}`;

        if (roomSchedules.length === 0) {
            assignmentDetails.innerHTML = `
                <div class="assignment-empty">
                    <div class="assignment-empty-icon">
                        <i class="bi bi-calendar-x"></i>
                    </div>

                    <div>
                        <strong>No classes scheduled</strong>
                        <p>
                            This classroom currently has no active scheduled classes.
                        </p>
                    </div>
                </div>
            `;
        } else {
            assignmentDetails.innerHTML = roomSchedules.map(item => {

                const lecturer =
                    item.lecturerName
                        ? `${escapeHtml(item.lecturerName)}${item.lecturerStaffId ? ` (${escapeHtml(item.lecturerStaffId)})` : ""}`
                        : "Unassigned";

                const representative =
                    item.representativeName
                        ? `${escapeHtml(item.representativeName)}${item.representativeRegNo ? ` (${escapeHtml(item.representativeRegNo)})` : ""}`
                        : "Unassigned";

                const representativeContact =
                    item.representativePhone ||
                    item.representativeEmail
                        ? `${escapeHtml(item.representativePhone || "No phone")}${item.representativeEmail ? ` · ${escapeHtml(item.representativeEmail)}` : ""}`
                        : "No contact information";

                return `
                    <article class="assignment-card">

                        <div class="assignment-card-header">
                            <div>
                                <span class="assignment-code">
                                    ${escapeHtml(item.courseCode || "COURSE")}
                                </span>

                                <h4>
                                    ${escapeHtml(item.courseName || "Unnamed Course")}
                                </h4>
                            </div>

                            <span class="session-badge">
                                ${escapeHtml(formatSession(item.studySession))}
                            </span>
                        </div>

                        <div class="assignment-grid">

                            <div>
                                <span>Lecturer</span>
                                <strong>${lecturer}</strong>
                            </div>

                            <div>
                                <span>Class Representative</span>
                                <strong>${representative}</strong>
                            </div>

                            <div>
                                <span>Day</span>
                                <strong>${escapeHtml(item.dayOfWeek)}</strong>
                            </div>

                            <div>
                                <span>Time</span>
                                <strong>
                                    ${escapeHtml(item.startTime)}
                                    –
                                    ${escapeHtml(item.endTime)}
                                </strong>
                            </div>

                            <div>
                                <span>Date Range</span>
                                <strong>
                                    ${escapeHtml(formatDateRange(item.startDate, item.endDate))}
                                </strong>
                            </div>

                            <div>
                                <span>Status</span>
                                <strong>${escapeHtml(item.status)}</strong>
                            </div>

                            <div>
                                <span>CP Contact</span>
                                <strong>${representativeContact}</strong>
                            </div>

                            <div>
                                <span>Intake / Level</span>
                                <strong>
                                    ${escapeHtml(
                                        [item.representativeIntake, item.representativeLevel]
                                            .filter(Boolean)
                                            .join(" · ") || "Not available"
                                    )}
                                </strong>
                            </div>

                        </div>

                        ${
                            item.notes
                                ? `
                                    <div class="assignment-note">
                                        <i class="bi bi-sticky"></i>
                                        <span>${escapeHtml(item.notes)}</span>
                                    </div>
                                `
                                : ""
                        }

                    </article>
                `;
            }).join("");
        }

        viewModal.classList.add("show");
        viewModal.setAttribute("aria-hidden", "false");
        document.body.classList.add("modal-open");
    }

    function closeViewModal() {
        if (!viewModal) {
            return;
        }

        viewModal.classList.remove("show");
        viewModal.setAttribute("aria-hidden", "true");
        document.body.classList.remove("modal-open");
    }

    document.querySelectorAll("[data-view-room]").forEach(button => {
        button.addEventListener("click", () => {
            openViewModal(button.dataset.viewRoom);
        });
    });

    document.querySelectorAll("[data-close-modal]").forEach(button => {
        button.addEventListener("click", closeViewModal);
    });

    viewModal?.addEventListener("click", event => {
        if (event.target === viewModal) {
            closeViewModal();
        }
    });

    document.addEventListener("keydown", event => {
        if (event.key === "Escape") {
            closeViewModal();
        }
    });

    const toast = document.getElementById("successToast");
    const toastMessage = document.getElementById("toastMessage");
    const closeToast = document.getElementById("closeToast");

    function showToast(message) {
        if (!toast) {
            return;
        }

        if (toastMessage) {
            toastMessage.textContent = message;
        }

        toast.classList.add("show");

        window.setTimeout(() => {
            toast.classList.remove("show");
        }, 4500);
    }

    closeToast?.addEventListener("click", () => {
        toast?.classList.remove("show");
    });

    @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
    {
        <text>
        showToast(@Html.Raw(JsonSerializer.Serialize(Model.SuccessMessage)));
        </text>
    }

    applyFilters();
</script>
