@page
@model CourseScheduleSystem.Web.Pages.ForgotPasswordModel
@{
    ViewData["Title"] = "Forgot Password | CSAS";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@700&display=swap" rel="stylesheet" />
    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
        body {
            font-family: 'DM Sans', sans-serif;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 2rem 1rem;
            background:
                linear-gradient(135deg, rgba(15,32,67,.90) 0%, rgba(21,86,200,.82) 100%),
                url('https://elearn.unilak.ac.rw/pluginfile.php?file=%2F1%2Fcore_admin%2Flogocompact%2F300x300%2F1768218512%2FPNG%20LOGO-%20UNILAK.png')
                no-repeat center center / cover fixed;
        }
        .fp-card {
            background: rgba(255,255,255,.97);
            border-radius: 18px;
            box-shadow: 0 25px 60px rgba(0,0,0,.35);
            padding: 2.5rem;
            width: 100%;
            max-width: 420px;
        }
        .fp-logo { text-align: center; margin-bottom: 1.5rem; }
        .fp-logo img { height: 72px; width: 72px; border-radius: 50%; box-shadow: 0 4px 15px rgba(21,62,131,.2); }
        .fp-title { font-family: 'Space Grotesk', sans-serif; font-size: 20px; font-weight: 700; color: #153f83; text-align: center; margin-bottom: .3rem; }
        .fp-sub   { font-size: 13px; color: #6c8097; text-align: center; margin-bottom: 1.5rem; }
        .form-label  { font-size: 13px; font-weight: 600; color: #374151; margin-bottom: 5px; }
        .form-control { border: 1.5px solid #e2e8f0; border-radius: 9px; padding: .65rem 1rem; font-size: 14px; }
        .form-control:focus { border-color: #1556c8; box-shadow: 0 0 0 3px rgba(21,86,200,.12); outline: none; }
        .input-wrap { position: relative; }
        .input-wrap .form-control { padding-left: 2.6rem; }
        .input-wrap .fi { position: absolute; left: .85rem; top: 50%; transform: translateY(-50%); color: #9ca3af; font-size: 15px; }
        .btn-fp {
            background: #142d4d; color: #fff; border: none;
            border-radius: 10px; padding: .8rem; width: 100%;
            font-size: 15px; font-weight: 700; cursor: pointer; transition: .2s; margin-top: .5rem;
        }
        .btn-fp:hover { background: #1556c8; }
        .back-link { text-align: center; font-size: 13px; margin-top: 1rem; }
        .back-link a { color: #1556c8; text-decoration: none; font-weight: 600; }
        .success-box {
            background: #ecfdf5; border: 1px solid #bbf7d0;
            border-radius: 12px; padding: 1.25rem; text-align: center;
        }
        .success-box i { font-size: 40px; color: #16a34a; display: block; margin-bottom: .75rem; }
        .success-box h5 { font-weight: 700; color: #15803d; margin-bottom: .5rem; }
        .success-box p  { font-size: 13px; color: #166534; line-height: 1.7; }
    </style>
</head>
<body>
<div class="fp-card">

    <div class="fp-logo">
        <img src="~/images/unilak-logo.png" alt="UNILAK" onerror="this.src='~/images/unilak-logo.svg'" />
    </div>

    <div class="fp-title">Forgot Password?</div>
    <div class="fp-sub">Enter your Registration Number and we'll guide you to reset access.</div>

    @if (Model.Submitted)
    {
        <div class="success-box">
            <i class="bi bi-check-circle-fill"></i>
            <h5>Request Received</h5>
            <p>
                Your password reset request has been submitted.<br />
                Please contact the <strong>CIS Department Administrator</strong> at UNILAK
                or visit the <a href="https://umurongosmart.com" target="_blank">UmurongoSmart support portal</a>
                with your Registration Number to reset your MIS password.
            </p>
            <a href="https://umurongosmart.com" target="_blank"
               style="display:inline-flex;align-items:center;gap:7px;margin-top:1rem;
                      background:#142d4d;color:#fff;text-decoration:none;
                      border-radius:9px;padding:.65rem 1.5rem;font-size:13px;font-weight:700;">
                <i class="bi bi-headset"></i> Open UmurongoSmart Support
            </a>
        </div>
    }
    else
    {
        @if (!string.IsNullOrEmpty(ViewData["Error"] as string))
        {
            <div class="alert alert-danger" style="font-size:13px;border-radius:8px;">
                <i class="bi bi-exclamation-triangle-fill me-1"></i>@ViewData["Error"]
            </div>
        }

        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>
            <div class="mb-3">
                <label class="form-label">Registration Number</label>
                <div class="input-wrap">
                    <i class="bi bi-person-badge fi"></i>
                    <input asp-for="RegNo" class="form-control" placeholder="e.g. 2024/BIT/001" />
                </div>
                <span asp-validation-for="RegNo" class="text-danger small"></span>
            </div>
            <button type="submit" class="btn-fp">
                <i class="bi bi-envelope-fill me-2"></i>Submit Reset Request
            </button>
        </form>
    }

    <div class="back-link">
        <a href="/Login"><i class="bi bi-arrow-left me-1"></i>Back to Login</a>
    </div>
</div>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
